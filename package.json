{
  "name": "service-crm-admin",
  "version": "1.0.0",
  "description": "Simple Alpine.js CRM with dedicated frontend and API routes, denormalized MongoDB schemas and one-to-many lead distribution.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "check": "node scripts/check.js",
    "test": "node --test",
    "seed": "node scripts/seed.js",
    "migrate:structure": "node scripts/migrate-structure.js",
    "migrate:lead-distribution": "node scripts/migrate-structure.js",
    "migrate:agent-payouts": "node scripts/migrate-agent-payouts.js",
    "migrate:marketplace-location": "node scripts/backfill-marketplace-locations.js",
    "qa:static": "node scripts/qa-static.js",
    "qa:critical": "node --test test/validation-utilities-expanded.test.js test/customer-portal-integration.test.js test/marketplace-publication-static.test.js test/provider-manual-credit-static.test.js test/registration-storage-static.test.js test/otp-proxy-routing.test.js test/production-readiness.test.js test/service-type-subscription-validation.test.js",
    "qa:production": "npm run qa:static && npm run qa:critical",
    "ensure:indexes": "node scripts/ensure-indexes.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1086.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "mongoose": "^8.24.1",
    "morgan": "^1.10.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
