<!DOCTYPE html>
<html lang="en" dir="ltr">
<%- include('../partials/head') %>
<body class="portal-legal-body">
  <header class="portal-legal-header">
    <a href="/login" class="portal-legal-brand" aria-label="Findoly provider login">
      <img src="/images/findoly-logo.png" alt="Findoly">
      <span>Provider portal</span>
    </a>
    <a class="btn btn-light btn-sm" href="/login">Provider login</a>
  </header>

  <main class="portal-legal-shell">
    <article class="card portal-legal-card">
      <div class="card-body">
        <span class="portal-legal-kicker">Findoly Solutions LLP</span>
        <h1>Contact Us</h1>
        <p class="portal-legal-lead">Contact Findoly Solutions LLP for provider portal, account, payment or policy questions.</p>
        <p class="portal-legal-effective">Effective date: 29 July 2026</p>
        <div class="portal-legal-content">

<section>
  <h2>Email support</h2>
  <p><a class="portal-legal-email" href="mailto:<%= supportEmail %>"><%= supportEmail %></a></p>
  <p>Use the email address registered with your provider account where possible. For account or payment questions, include your registered mobile number and any relevant payment or enquiry reference.</p>
</section>
<section>
  <h2>Registered business contact</h2>
  <address>
    <strong>Findoly Solutions LLP</strong><br>
    WeWork Mindspace, 6th Floor,<br>
    Malad West, Mumbai – 400064,<br>
    Maharashtra, India.
  </address>
</section>
<section>
  <h2>Support scope</h2>
  <p>We can assist with provider portal access, account eligibility, payment verification, credit activation, lead access records and questions about these policies.</p>
</section>
        </div>
      </div>
    </article>

    <section class="portal-legal-navigation" aria-label="Policies and support">
      <strong>Policies and support</strong>
      <%- include('../partials/policy-links', { policyLinksClass: 'portal-policy-links' }) %>
    </section>
  </main>

  <footer class="portal-legal-page-footer">
    <span>© <%= new Date().getFullYear() %> <%= legalEntityName %></span>
    <a href="mailto:<%= supportEmail %>"><%= supportEmail %></a>
  </footer>
</body>
</html>
