<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Analytics</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Review CRM activity and operational totals.</p>
              </div>
              
            </div>
          </div>
          <div class="content">
            <div
              x-show="shellError"
              x-cloak
              class="alert alert-danger"
              x-text="shellError"
            ></div>
            <div x-data="reportPage()" x-init="load()">
              <div class="row g-3">
                <template x-for="item in cards" :key="item.label"
                  ><div class="col-md-4">
                    <div class="card">
                      <div class="card-body">
                        <div class="text-muted" x-text="item.label"></div>
                        <div class="crm-stat-value" x-text="item.value"></div>
                      </div>
                    </div></div
                ></template>
              </div>
              <div class="card mt-3">
                <div class="card-header">
                  <h5 class="mb-0">Status summary</h5>
                </div>
                <div class="card-body">
                  <template
                    x-for="(count,status) in data.statusCounts||{}"
                    :key="status"
                    ><div class="d-flex border-bottom py-2">
                      <span x-text="humanize(status)"></span
                      ><strong class="ms-auto" x-text="count"></strong></div
                  ></template>
                </div>
              </div>
            </div>
            <script>
              function reportPage() {
                return {
                  data: {},
                  get cards() {
                    return [
                      {
                        label: "Requirements",
                        value: this.data.totalLeads || 0,
                      },
                      {
                        label: "Provider offers",
                        value: this.data.offered || 0,
                      },
                      {
                        label: "Unlocked leads",
                        value: this.data.unlocked || 0,
                      },
                      { label: "Providers", value: this.data.providers || 0 },
                      {
                        label: "Follow-ups",
                        value: this.data.openFollowUps || 0,
                      },
                      { label: "Invoices", value: this.data.invoices || 0 },
                    ];
                  },
                  async load() {
                    this.data = (await apiFetch("/api/dashboard")).data;
                  },
                };
              }
            </script>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>
    <%- include('../partials/scripts') %>
  </body>
</html>
