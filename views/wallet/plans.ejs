<!DOCTYPE html>
<html lang="en" dir="ltr">
<%- include('../partials/head') %>
<body
  x-data='providerShell({ title: <%- JSON.stringify(title || "") %>, subtitle: <%- JSON.stringify(subtitle || "") %> })'
  x-init="initShell()"
  @wallet-updated.window="refreshProfile()"
  @credits-updated.window="refreshProfile()"
  @portal-notify.window="notify($event.detail)"
>
<%- include('../partials/navbar') %>
<div class="page-content workspace-page-shell">
  <%- include('../partials/sidebar') %>
  <div class="content-wrapper">
    <div class="content-inner">
      <div class="content provider-plans-content" x-data="billingHoldPage()" x-init="load()">
        <div x-show="shellError" x-cloak class="alert alert-danger portal-flash" x-text="shellError"></div>
        <div x-show="error" x-cloak class="alert alert-danger portal-flash" role="alert">
          <span x-text="error"></span>
          <small class="d-block mt-1" x-show="errorRequestId" x-text="`Reference: ${errorRequestId}`"></small>
        </div>

        <section class="provider-plans-intro mb-4" aria-labelledby="billing-hold-title">
          <div>
            <span class="provider-section-kicker">Plan &amp; Billing</span>
            <h1 id="billing-hold-title">Subscription on hold</h1>
            <p>Subscription payments and new Lead Credit purchases are temporarily paused. Your existing plan access continues during this hold.</p>
          </div>
          <a class="btn btn-light" href="/wallet">Lead usage</a>
        </section>

        <div class="alert alert-warning mb-4" role="status">
          <strong>Billing is temporarily on hold.</strong>
          You will continue to receive eligible matching leads/bookings from your existing plan, and any Lead Credits already in your account remain available to use.
        </div>

        <div class="row g-4 align-items-stretch mb-4">
          <div class="col-xl-7">
            <section class="card portal-card h-100" aria-labelledby="current-plan-title">
              <div class="card-header border-bottom d-flex align-items-center gap-3">
                <div>
                  <span class="provider-section-kicker">Current subscription</span>
                  <h5 id="current-plan-title" class="mb-0">Plan status</h5>
                </div>
                <span class="badge bg-warning-subtle text-warning ms-auto">On Hold</span>
              </div>
              <div class="card-body">
                <template x-if="loading">
                  <div class="text-muted">Loading current plan…</div>
                </template>

                <template x-if="!loading && currentSubscription">
                  <div>
                    <h3 class="mb-1" x-text="currentSubscription.planName || currentSubscription.planCode || 'Current plan'"></h3>
                    <p class="text-muted mb-4" x-text="currentSubscription.billingCycle ? humanize(currentSubscription.billingCycle) : 'Existing subscription'"></p>

                    <div class="row g-3">
                      <div class="col-sm-6">
                        <div class="border rounded p-3 h-100">
                          <div class="text-muted fs-sm">Plan started</div>
                          <strong x-text="dateOnly(currentSubscription.startsAt)"></strong>
                        </div>
                      </div>
                      <div class="col-sm-6">
                        <div class="border rounded p-3 h-100">
                          <div class="text-muted fs-sm">Original validity date</div>
                          <strong x-text="dateOnly(currentSubscription.expiresAt)"></strong>
                        </div>
                      </div>
                    </div>

                    <div class="alert alert-info mt-4 mb-0">
                      The original expiry date is retained for history. While billing is on hold, Findoly keeps your existing plan access available so lead/booking delivery is not stopped because of this billing pause.
                    </div>
                  </div>
                </template>

                <template x-if="!loading && !currentSubscription">
                  <div>
                    <h5 class="mb-2">No current subscription record found</h5>
                    <p class="text-muted mb-0">New subscription and Lead Credit purchases are still paused. Your provider account and any existing Lead Credits remain available under the normal eligibility rules.</p>
                  </div>
                </template>
              </div>
            </section>
          </div>

          <div class="col-xl-5">
            <section class="card portal-card portal-credit-balance-card provider-credit-overview h-100" aria-label="Available Lead Credits">
              <div class="card-body">
                <div class="provider-credit-overview-heading">
                  <span class="provider-credit-overview-icon"><svg class="icon"><use href="#i-unlock"></use></svg></span>
                  <div>
                    <span>Available Lead Credits</span>
                    <small>Existing credits remain usable</small>
                  </div>
                </div>
                <strong class="provider-credit-overview-value" x-text="leadCredits(data.provider?.availableCredits ?? data.provider?.walletCredits)">0 Lead Credits</strong>
                <div class="provider-credit-overview-meta">
                  <span>New Lead Credit purchases are temporarily disabled.</span>
                </div>
                <div class="provider-credit-overview-actions">
                  <a class="btn btn-light btn-sm" href="/leads?status=offered">Use Lead Credits</a>
                  <a class="btn btn-outline-light btn-sm" href="/wallet">View activity</a>
                </div>
              </div>
            </section>
          </div>
        </div>

        <section class="card portal-card" aria-labelledby="billing-hold-details">
          <div class="card-body">
            <span class="provider-section-kicker">During this hold</span>
            <h5 id="billing-hold-details" class="mb-3">What continues and what is paused</h5>
            <ul class="lead-pack-features mb-0">
              <li><svg class="icon"><use href="#i-check"></use></svg><span>Your existing provider account, plan access and matching lead/booking delivery continue.</span></li>
              <li><svg class="icon"><use href="#i-check"></use></svg><span>Lead Credits already available in your account can still be used to unlock eligible leads.</span></li>
              <li><svg class="icon"><use href="#i-clock"></use></svg><span>New subscription payments, renewals and Lead Credit purchases are temporarily unavailable.</span></li>
            </ul>
          </div>
        </section>
      </div>

      <%- include('../partials/footer') %>
    </div>
  </div>
</div>
<div class="portal-sidebar-overlay" data-portal-menu-overlay aria-hidden="true"></div>
<%- include('../partials/scripts') %>
<script nonce="<%= cspNonce %>">
  function billingHoldPage() {
    return {
      data: {},
      loading: true,
      error: '',
      errorRequestId: '',

      get currentSubscription() {
        return this.data.currentSubscription || null;
      },

      leadCredits(value) {
        return `${Number(value || 0).toLocaleString('en-IN')} Lead Credits`;
      },

      dateOnly(value) {
        if (!value) return '—';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return '—';
        return new Intl.DateTimeFormat('en-IN', {
          day: '2-digit',
          month: 'short',
          year: 'numeric'
        }).format(date);
      },

      async load() {
        this.loading = true;
        this.error = '';
        this.errorRequestId = '';
        try {
          this.data = (await apiFetch('/api/wallet?limit=1')).data || {};
        } catch (error) {
          this.error = error.message;
          this.errorRequestId = error.requestId || '';
        } finally {
          this.loading = false;
        }
      }
    };
  }
</script>
</body>
</html>