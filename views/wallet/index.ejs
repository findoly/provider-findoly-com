<%- include('../partials/pageStart') %>
<div x-data="walletPage()" x-init="load()">
  <div x-show="error" x-cloak class="alert alert-danger portal-flash" x-text="error"></div>
  <div x-show="success" x-cloak class="alert alert-success portal-flash" x-text="success"></div>

  <div class="row g-4 align-items-start">
    <div class="col-xl-4">
      <div class="card portal-card portal-wallet-card mb-4">
        <div class="card-body">
          <span>Available wallet balance</span>
          <strong x-text="money(data.provider?.walletBalancePaise)">₹0.00</strong>
          <small>₹1 paid gives ₹1 wallet credit</small>
        </div>
      </div>

      <div class="card portal-card">
        <div class="card-header border-bottom">
          <h5 class="mb-1">Add wallet funds</h5>
          <div class="text-muted fs-sm">Use this test top-up while Razorpay is not configured.</div>
        </div>
        <div class="card-body">
          <label class="form-label" for="walletAmount">Amount in rupees</label>
          <div class="input-group mb-3">
            <span class="input-group-text">₹</span>
            <input id="walletAmount" type="number" class="form-control" min="1" step="1" x-model.number="rupees">
          </div>
          <div class="d-flex flex-wrap gap-2 mb-3">
            <button class="btn btn-light btn-sm" type="button" @click="rupees = 500">₹500</button>
            <button class="btn btn-light btn-sm" type="button" @click="rupees = 1000">₹1,000</button>
            <button class="btn btn-light btn-sm" type="button" @click="rupees = 2000">₹2,000</button>
          </div>
          <button class="btn btn-primary w-100" type="button" @click="topup()" :disabled="submitting || Number(rupees) < 1">
            <span x-text="submitting ? 'Adding funds…' : 'Add test wallet funds'"></span>
          </button>
        </div>
      </div>
    </div>

    <div class="col-xl-8">
      <div class="card portal-card">
        <div class="card-header border-bottom d-flex align-items-center">
          <div>
            <h5 class="mb-1">Wallet transactions</h5>
            <div class="text-muted fs-sm">Every credit and lead deduction appears here.</div>
          </div>
          <span class="badge bg-light text-body border ms-auto" x-text="`${pagination.total || 0} records`"></span>
        </div>
        <div class="table-responsive">
          <table class="table portal-table mb-0">
            <thead>
              <tr>
                <th>Transaction</th>
                <th>Description</th>
                <th>Amount</th>
                <th>Balance</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <template x-for="transaction in transactions" :key="transaction.walletTransactionId || transaction.id">
                <tr>
                  <td><span class="badge" :class="transaction.type === 'debit' ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success'" x-text="humanize(transaction.type)"></span></td>
                  <td>
                    <div class="fw-semibold" x-text="transaction.description || humanize(transaction.source)"></div>
                    <div class="text-muted fs-sm portal-id" x-text="transaction.referenceId || transaction.walletTransactionId"></div>
                  </td>
                  <td class="fw-semibold" :class="transaction.type === 'debit' ? 'text-danger' : 'text-success'" x-text="`${transaction.type === 'debit' ? '-' : '+'}${money(transaction.amountPaise)}`"></td>
                  <td x-text="money(transaction.balanceAfterPaise)"></td>
                  <td x-text="formatDate(transaction.createdAt)"></td>
                </tr>
              </template>
              <tr x-show="loading"><td colspan="5" class="text-center text-muted py-5">Loading transactions…</td></tr>
              <tr x-show="!loading && !transactions.length"><td colspan="5" class="text-center text-muted py-5">No wallet transactions yet</td></tr>
            </tbody>
          </table>
        </div>
        <div class="card-footer portal-pagination" x-show="pagination.pages > 1">
          <button class="btn btn-light btn-sm" :disabled="pagination.page <= 1" @click="go(pagination.page - 1)">Previous</button>
          <span class="mx-auto fs-sm" x-text="`${pagination.page} of ${pagination.pages}`"></span>
          <button class="btn btn-light btn-sm" :disabled="pagination.page >= pagination.pages" @click="go(pagination.page + 1)">Next</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function walletPage() {
    return {
      data: {},
      transactions: [],
      pagination: { page: 1, pages: 1, total: 0 },
      rupees: 1000,
      loading: true,
      submitting: false,
      error: '',
      success: '',

      async load(page = this.pagination.page) {
        this.loading = true;
        this.error = '';
        try {
          this.data = (await apiFetch(`/api/wallet?page=${page}&limit=20`)).data;
          this.transactions = this.data.data || [];
          this.pagination = this.data.pagination || { page: 1, pages: 1, total: this.transactions.length };
        } catch (error) {
          this.error = error.message;
        } finally {
          this.loading = false;
        }
      },

      async topup() {
        const amountPaise = Math.round(Number(this.rupees || 0) * 100);
        if (amountPaise < 100) return;
        this.submitting = true;
        this.error = '';
        this.success = '';
        try {
          await apiFetch('/api/wallet/demo-topup', {
            method: 'POST',
            body: JSON.stringify({ amountPaise })
          });
          this.success = `${money(amountPaise)} added to your wallet.`;
          await this.load(1);
          this.$dispatch('wallet-updated');
        } catch (error) {
          this.error = error.message;
        } finally {
          this.submitting = false;
        }
      },

      go(page) {
        this.pagination.page = page;
        this.load(page);
      }
    };
  }
</script>
<%- include('../partials/pageEnd') %>
