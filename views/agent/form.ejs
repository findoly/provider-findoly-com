<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
      <div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Agent account</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0">OTP login uses the mobile number below. Each agent can submit for one assigned category.</p></div><a href="/agents" class="btn btn-light crm-primary-action">Back to agents</a></div></div>
      <div class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-data="agentForm()" x-init="init()"><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div><form class="card" @submit.prevent="save()"><div class="card-body" :class="loading && 'crm-loading'"><div class="row g-3">
        <div class="col-md-3"><label class="form-label">Agent type</label><select class="form-select" x-model="form.agentType"><option value="individual">Individual</option><option value="shop">Shop</option></select></div>
        <div class="col-md-5"><label class="form-label">Agent / contact name</label><input class="form-control" x-model="form.name" maxlength="120" required></div>
        <div class="col-md-4"><label class="form-label">Business or shop name</label><input class="form-control" x-model="form.businessName" maxlength="160" :required="form.agentType==='shop'"></div>
        <div class="col-md-4"><label class="form-label">Mobile for OTP login</label><div class="input-group"><span class="input-group-text">+91</span><input class="form-control" x-model="form.mobile" @input="form.mobile=digits(form.mobile)" inputmode="numeric" pattern="[6-9][0-9]{9}" minlength="10" maxlength="10" required></div></div>
        <div class="col-md-4"><label class="form-label">Email</label><input type="email" class="form-control" x-model="form.email" maxlength="254"></div>
        <div class="col-md-4"><label class="form-label">Assigned category</label><select class="form-select" x-model="form.categorySlug" required><option value="">Select category</option><template x-for="category in categories" :key="category.slug"><option :value="category.slug" x-text="category.name"></option></template></select></div>
        <div class="col-md-6"><label class="form-label">Address</label><input class="form-control" x-model="form.addressLine" maxlength="500"></div>
        <div class="col-md-2"><label class="form-label">City</label><input class="form-control" x-model="form.city" maxlength="100"></div>
        <div class="col-md-2"><label class="form-label">State</label><input class="form-control" x-model="form.state" maxlength="100"></div>
        <div class="col-md-2"><label class="form-label">Pincode</label><input class="form-control" x-model="form.pincode" @input="form.pincode=String(form.pincode||'').replace(/\D/g,'').slice(0,6)" @blur="lookupPincode()" inputmode="numeric" pattern="[1-9][0-9]{5}" maxlength="6"></div>
        <div class="col-md-3"><label class="form-label">Status</label><select class="form-select" x-model="form.status"><option value="active">Active</option><option value="inactive">Inactive</option><option value="pending">Pending</option><option value="blocked">Blocked</option></select></div>
        <div class="col-md-3 d-flex align-items-end"><label class="form-check"><input class="form-check-input" type="checkbox" x-model="form.portalAccessEnabled"><span class="form-check-label">Enable Agent Portal access</span></label></div>
        <div class="col-12"><div class="crm-form-section-title"><span>Partner payout configuration</span></div></div>
        <div class="col-md-3"><label class="form-label">Pay per eligible referral</label><div class="input-group"><span class="input-group-text">₹</span><input type="number" min="50" max="200" step="1" class="form-control" x-model.number="form.payoutPerReferralRupees" required></div><div class="form-text">Allowed range ₹50–₹200.</div></div>
        <div class="col-md-3"><label class="form-label">Payout mode</label><select class="form-select" x-model="form.payoutMode"><option value="IMPS">IMPS</option><option value="NEFT">NEFT</option><option value="RTGS">RTGS</option><option value="UPI">UPI</option></select></div>
        <div class="col-md-3"><label class="form-label">Razorpay contact ID</label><input class="form-control" x-model="form.razorpayContactId" maxlength="80" placeholder="cont_..."></div>
        <div class="col-md-3"><label class="form-label">Razorpay fund account ID</label><input class="form-control" x-model="form.razorpayFundAccountId" maxlength="80" placeholder="fa_..."></div>
        <div class="col-md-8"><label class="form-label">Payout account label</label><input class="form-control" x-model="form.payoutAccountLabel" maxlength="160" placeholder="Bank account ending 1234 or verified UPI ID"></div>
        <div class="col-md-4 d-flex align-items-end"><label class="form-check"><input class="form-check-input" type="checkbox" x-model="form.payoutEnabled"><span class="form-check-label">Enable withdrawal payouts</span></label></div>
        <div class="col-12"><label class="form-label">Internal notes</label><textarea class="form-control" rows="4" x-model="form.notes" maxlength="5000"></textarea></div>
        <template x-if="mode==='edit'"><div class="col-12"><div class="alert alert-light border mb-0"><strong>Immutable identifiers</strong><div class="mt-2"><span class="me-3">Agent ID: <code x-text="form.agentId"></code></span><span>Referral ID: <code x-text="form.referralId"></code></span></div></div></div></template>
      </div></div><div class="card-footer d-flex"><a href="/agents" class="btn btn-light">Cancel</a><button class="btn btn-primary ms-auto" :disabled="saving" x-text="saving ? 'Saving…' : 'Save agent'"></button></div></form></div></div>
      <%- include('../partials/footer') %>
    </div></div></div>
    <script>
      function agentForm(){return{mode:pageMode(),recordId:pageMode()==='edit'?pathRecordId(true):'',categories:[],form:{agentType:'individual',name:'',businessName:'',mobile:'',email:'',addressLine:'',city:'',state:'',pincode:'',categorySlug:'',status:'active',portalAccessEnabled:true,notes:'',payoutPerReferralRupees:50,payoutMode:'IMPS',razorpayContactId:'',razorpayFundAccountId:'',payoutAccountLabel:'',payoutEnabled:false},loading:true,locationLoading:false,lastLookedUpPincode:'',saving:false,error:'',digits(v){return String(v||'').replace(/\D/g,'').slice(-10);},async init(){try{this.categories=(await apiFetch('/api/catalog/categories')).data||[];if(this.mode==='edit'){const existing=(await apiFetch('/api/agent/'+this.recordId)).data;this.form={...this.form,...existing,payoutPerReferralRupees:Number(existing.payoutPerReferralPaise||5000)/100};}}catch(error){this.error=error.message;}finally{this.loading=false;}},async lookupPincode(){const pincode=String(this.form.pincode||'');if(!/^[1-9]\d{5}$/.test(pincode)||this.locationLoading||this.lastLookedUpPincode===pincode)return;this.locationLoading=true;try{const data=(await apiFetch('/api/location/pincode/'+encodeURIComponent(pincode))).data||{};this.form.city=data.city||this.form.city;this.form.state=data.state||this.form.state;this.lastLookedUpPincode=pincode;}catch(error){this.error=error.message+' You may enter city and state manually.';}finally{this.locationLoading=false;}},async save(){if(this.saving)return;this.error='';this.saving=true;try{if(!/^[6-9]\d{9}$/.test(this.form.mobile))throw new Error('Enter a valid 10-digit Indian mobile number');if(this.form.agentType==='shop'&&!this.form.businessName.trim())throw new Error('Business or shop name is required for shop agents');if(this.form.pincode&&!/^[1-9]\d{5}$/.test(this.form.pincode))throw new Error('Pincode must contain exactly 6 digits');if(this.form.pincode&&(!String(this.form.city||'').trim()||!String(this.form.state||'').trim()))throw new Error('City and state are required when pincode is provided');if(this.form.payoutEnabled&&!String(this.form.razorpayFundAccountId||'').trim())throw new Error('Razorpay fund account ID is required when payouts are enabled');if(!Number.isFinite(Number(this.form.payoutPerReferralRupees))||this.form.payoutPerReferralRupees<50||this.form.payoutPerReferralRupees>200)throw new Error('Payout per referral must be between ₹50 and ₹200');const payload={...this.form,payoutPerReferralPaise:Math.round(Number(this.form.payoutPerReferralRupees)*100)};delete payload.payoutPerReferralRupees;const url=this.mode==='edit'?'/api/agent/'+this.recordId:'/api/agent';const body=await apiFetch(url,{method:this.mode==='edit'?'PUT':'POST',body:JSON.stringify(payload)});location.href='/agents/'+body.data.agentId;}catch(error){this.error=error.message;}finally{this.saving=false;}}};}
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
