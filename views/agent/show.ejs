<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner" x-data="agentShow()" x-init="load()">
      <div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Agent profile</div><h1 class="page-title mb-1">Agent details</h1><p class="crm-page-subtitle mb-0">Review account access and requirements submitted from the Agent Portal.</p></div><a :href="'/agents/' + recordId + '/edit'" class="btn btn-primary crm-primary-action">Edit agent</a></div></div>
      <div class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div><div class="row g-3"><div class="col-xl-4"><div class="card"><div class="card-body"><div class="crm-provider-cell mb-3"><span class="crm-provider-avatar" x-text="(agent.businessName||agent.name||'A').charAt(0).toUpperCase()"></span><div><h4 class="mb-1" x-text="agent.businessName||agent.name"></h4><div class="text-muted" x-text="humanize(agent.agentType)+' agent'"></div></div></div><dl class="row mb-0"><dt class="col-5">Agent ID</dt><dd class="col-7 crm-record-id" x-text="agent.agentId"></dd><dt class="col-5">Referral ID</dt><dd class="col-7 fw-semibold" x-text="agent.referralId"></dd><dt class="col-5">Mobile</dt><dd class="col-7" x-text="agent.mobile?'+91 '+agent.mobile:'—'"></dd><dt class="col-5">Category</dt><dd class="col-7" x-text="agent.categoryName||'—'"></dd><dt class="col-5">Status</dt><dd class="col-7"><span class="crm-status" :class="statusClass(agent.status)" x-text="humanize(agent.status)"></span></dd><dt class="col-5">Portal</dt><dd class="col-7" x-text="agent.portalAccessEnabled===false?'Disabled':'Enabled'"></dd><dt class="col-5">Payout rate</dt><dd class="col-7" x-text="money(agent.payoutPerReferralPaise||5000)+' / referral'"></dd><dt class="col-5">Payout account</dt><dd class="col-7" x-text="agent.payoutEnabled?(agent.payoutAccountLabel||'Enabled'):'Disabled'"></dd><dt class="col-5">Last login</dt><dd class="col-7" x-text="formatDate(agent.lastLoginAt)"></dd></dl></div></div></div><div class="col-xl-8"><div class="card"><div class="card-header d-flex align-items-center"><div><h5 class="mb-1">Submitted requirements</h5><p class="text-muted mb-0"><span x-text="requirements.length"></span> rows on this page</p></div></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Requirement</th><th>Customer</th><th>Status</th><th>Referral</th><th>Payout</th><th>OTP</th><th>Date</th></tr></thead><tbody><template x-if="loading"><tr><td colspan="7"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template><template x-for="row in requirements" :key="row.enquiryId"><tr><td><a :href="'/enquiries/'+row.enquiryId" x-text="row.requirementTitle||row.enquiryId"></a><div class="crm-record-id" x-text="row.enquiryId"></div></td><td><div x-text="row.name||'—'"></div><div class="text-muted fs-sm" x-text="row.mobile||'—'"></div></td><td><span class="crm-status" :class="statusClass(row.status)" x-text="humanize(row.status)"></span></td><td><span class="crm-status" :class="statusClass(row.agentReferralValidation||'pending')" x-text="humanize(row.agentReferralValidation||'pending')"></span></td><td><span class="crm-status" :class="statusClass(row.partnerPayoutStatus||'waiting_period')" x-text="humanize(row.partnerPayoutStatus||'waiting_period')"></span></td><td x-text="row.customerMobileVerified?'Verified':'Not verified'"></td><td x-text="formatDate(row.createdAt)"></td></tr></template><tr x-show="!loading&&!requirements.length"><td colspan="7" class="text-center text-muted py-4">No requirements submitted by this agent</td></tr></tbody></table></div><div class="crm-table-footer"><div class="text-muted">Page <strong x-text="pagination.page"></strong></div><div class="crm-pagination"><button :disabled="pagination.page<=1||loading" @click="previous()">Previous</button><span x-text="pagination.page"></span><button :disabled="!pagination.hasNext||loading" @click="next()">Next</button></div></div></div></div></div></div></div></div>
      <%- include('../partials/footer') %>
    </div></div></div>
    <script>
      function agentShow(){return{recordId:pathRecordId(),agent:{},requirements:[],pagination:createCursorPagination(20),loading:true,error:'',async load(){try{this.agent=(await apiFetch('/api/agent/'+this.recordId)).data;await this.loadRequirements();}catch(error){this.error=error.message;}finally{this.loading=false;}},async loadRequirements(){const q=new URLSearchParams({limit:this.pagination.limit,cursor:this.pagination.cursor});if(!this.pagination.cursor)q.delete('cursor');const body=await apiFetch('/api/agent/'+this.recordId+'/requirements?'+q.toString());this.requirements=body.data||[];applyCursorPagination(this.pagination,body.pagination||{});},next(){if(cursorNext(this.pagination))this.loadRequirements();},previous(){if(cursorPrevious(this.pagination))this.loadRequirements();}};}
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
