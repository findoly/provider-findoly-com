<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div><div class="crm-page-eyebrow">Partner network</div><h1 class="page-title mb-1">Agents</h1><p class="crm-page-subtitle mb-0">Create OTP-enabled agent accounts and assign one requirement category.</p></div>
              <a href="/agents/new" class="btn btn-primary crm-primary-action"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New agent</a>
            </div>
          </div>
          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>
            <main x-data="agentList()" x-init="init()">
              <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
              <section class="card crm-filter-card mb-3"><form class="crm-filter-bar" @submit.prevent="search()"><label class="crm-search-control"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" x-model="filters.q" placeholder="Search agent, shop, referral ID or mobile"></label><label class="crm-inline-select"><span>Status</span><select x-model="filters.status"><option value="">All agents</option><option value="active">Active</option><option value="inactive">Inactive</option><option value="pending">Pending</option><option value="blocked">Blocked</option></select></label><label class="crm-inline-select"><span>Type</span><select x-model="filters.agentType"><option value="">All types</option><option value="individual">Individual</option><option value="shop">Shop</option></select></label><label class="crm-inline-select"><span>Date</span><select x-model="filters.dateField"><option value="createdAt">Created</option><option value="updatedAt">Updated</option></select></label><input class="form-control" style="max-width:150px" type="date" x-model="filters.startDate" aria-label="From date"><input class="form-control" style="max-width:150px" type="date" x-model="filters.endDate" aria-label="To date"><label class="crm-inline-select"><span>Sort</span><select x-model="filters.sortOrder"><option value="newest">Newest</option><option value="oldest">Oldest</option></select></label><button class="btn btn-primary" type="submit">Search</button><button class="btn btn-light" type="button" x-show="filters.q || filters.status || filters.agentType || filters.startDate || filters.endDate || filters.sortOrder === 'oldest'" @click="reset()">Clear</button></form></section>
              <section class="card crm-data-card"><div class="card-header crm-card-heading crm-list-heading"><div><h2 class="card-title mb-1">Agent directory</h2><p class="text-muted mb-0"><span x-text="rows.length"></span> records on this page</p></div><span class="crm-list-refresh" x-show="loading"><span></span>Refreshing</span></div><div class="table-responsive"><table class="table crm-table mb-0"><thead><tr><th>Agent</th><th>Identifiers</th><th>Contact</th><th>Assigned category</th><th>Access</th><th></th></tr></thead><tbody><template x-if="loading"><tr><td colspan="6"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template><template x-for="agent in rows" :key="agent.agentId"><tr><td><div class="crm-provider-cell"><span class="crm-provider-avatar" x-text="(agent.businessName || agent.name || 'A').charAt(0).toUpperCase()"></span><div><a class="crm-record-title" :href="'/agents/' + agent.agentId" x-text="agent.businessName || agent.name"></a><div class="text-muted fs-sm" x-text="humanize(agent.agentType) + ' agent'"></div></div></div></td><td><div class="fw-semibold" x-text="agent.referralId"></div><div class="crm-record-id" x-text="agent.agentId"></div></td><td><div class="fw-semibold" x-text="agent.mobile ? '+91 ' + agent.mobile : '—'"></div><div class="text-muted fs-sm" x-text="agent.email || [agent.city,agent.state].filter(Boolean).join(', ') || '—'"></div></td><td><div class="fw-semibold" x-text="agent.categoryName || humanize(agent.categorySlug)"></div><div class="text-muted fs-sm" x-text="agent.categorySlug"></div></td><td><span class="crm-status" :class="statusClass(agent.status)" x-text="humanize(agent.status)"></span><div class="crm-access-line" :class="agent.portalAccessEnabled === false ? 'is-off' : 'is-on'"><span></span><b x-text="agent.portalAccessEnabled === false ? 'Portal disabled' : 'Portal enabled'"></b></div></td><td class="text-end crm-nowrap"><a class="crm-row-action" :href="'/agents/' + agent.agentId">View</a><a class="crm-row-action crm-row-action-muted" :href="'/agents/' + agent.agentId + '/edit'">Edit</a></td></tr></template><tr x-show="!loading && !rows.length"><td colspan="6"><div class="crm-empty-state"><strong>No agents found</strong><span>Create an agent or change the filters.</span><a href="/agents/new" class="btn btn-primary btn-sm">New agent</a></div></td></tr></tbody></table></div><div class="crm-table-footer"><div class="text-muted">Page <strong x-text="pagination.page"></strong></div><div class="crm-pagination"><button :disabled="pagination.page<=1 || loading" @click="previous()">Previous</button><span x-text="pagination.page"></span><button :disabled="!pagination.hasNext || loading" @click="next()">Next</button></div></div></section>
            </main>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>
    <script>
      function agentList(){return{rows:[],filters:{q:'',status:'',agentType:'',dateField:'createdAt',startDate:'',endDate:'',sortOrder:'newest'},pagination:createCursorPagination(20),loading:false,error:'',async init(){await this.load();},query(){const q=new URLSearchParams({...this.filters,limit:this.pagination.limit,cursor:this.pagination.cursor});[...q].forEach(([k,v])=>{if(!v)q.delete(k)});return q.toString();},async load(){this.loading=true;this.error='';try{const body=await apiFetch('/api/agent?'+this.query());this.rows=body.data||[];applyCursorPagination(this.pagination,body.pagination||{});}catch(error){this.error=error.message;}finally{this.loading=false;}},search(){resetCursorPagination(this.pagination);this.load();},reset(){this.filters={q:'',status:'',agentType:'',dateField:'createdAt',startDate:'',endDate:'',sortOrder:'newest'};this.search();},next(){if(cursorNext(this.pagination))this.load();},previous(){if(cursorPrevious(this.pagination))this.load();}};}
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
