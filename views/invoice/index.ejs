<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
      <div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Billing</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0">Manage invoices and payment records.</p></div><a href="/billing/new" class="btn btn-primary crm-primary-action"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New invoice</a></div></div>
      <div class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-data="listPage()" x-init="load()"><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
        <section class="card crm-filter-card mb-3"><form class="crm-filter-bar" @submit.prevent="search()"><label class="crm-search-control"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" x-model="q" placeholder="Search invoices"></label><select class="form-select" style="max-width:180px" x-model="status"><option value="">All statuses</option><option>draft</option><option>sent</option><option>paid</option><option>overdue</option><option>cancelled</option></select><select class="form-select" style="max-width:170px" x-model="dateField"><option value="issueDate">Issue date</option><option value="dueDate">Due date</option><option value="createdAt">Created date</option><option value="updatedAt">Updated date</option></select><input class="form-control" style="max-width:150px" type="date" x-model="startDate" aria-label="From date"><input class="form-control" style="max-width:150px" type="date" x-model="endDate" aria-label="To date"><select class="form-select" style="max-width:150px" x-model="sortOrder"><option value="newest">Newest</option><option value="oldest">Oldest</option></select><button class="btn btn-primary" type="submit">Search</button><button class="btn btn-light" type="button" x-show="q || status || startDate || endDate || sortOrder === 'oldest'" @click="reset()">Clear</button><label class="crm-page-size ms-auto"><span>Rows</span><select x-model.number="pagination.limit" @change="search()"><option :value="10">10</option><option :value="20">20</option><option :value="50">50</option><option :value="100">100</option></select></label></form></section>
        <section class="card crm-data-card"><div class="card-header crm-card-heading"><div><h5 class="mb-1">Invoice list</h5><p class="text-muted mb-0"><span x-text="rows.length"></span> rows on this page</p></div></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Invoice</th><th>Customer</th><th>Status</th><th>Total</th><th>Dates</th><th></th></tr></thead><tbody><template x-if="loading"><tr><td colspan="6"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template><template x-for="r in rows" :key="r.invoiceId"><tr><td><div class="fw-semibold" x-text="r.invoiceNo"></div><div class="text-muted fs-sm" x-text="r.enquiryId"></div></td><td x-text="r.customerName"></td><td x-text="humanize(r.status)"></td><td x-text="new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR'}).format(r.total||0)"></td><td x-text="(r.issueDate||'—')+' → '+(r.dueDate||'—')"></td><td><a class="btn btn-light btn-sm" :href="'/billing/'+r.invoiceId+'/edit'">Edit</a></td></tr></template><tr x-show="!loading && !rows.length"><td colspan="6" class="text-center text-muted py-4">No invoices found</td></tr></tbody></table></div><div class="crm-table-footer"><div class="text-muted">Page <strong x-text="pagination.page"></strong></div><div class="crm-pagination"><button :disabled="pagination.page <= 1 || loading" @click="previous()">Previous</button><span x-text="pagination.page"></span><button :disabled="!pagination.hasNext || loading" @click="next()">Next</button></div></div></section>
      </div><script>
        function listPage() {
          return {
            rows: [], q: '', status: '', dateField: 'issueDate', startDate: '', endDate: '', sortOrder: 'newest', pagination: createCursorPagination(20), loading: false, error: '',
            query() { const q = new URLSearchParams({ q: this.q, status: this.status, dateField: this.dateField, startDate: this.startDate, endDate: this.endDate, sortOrder: this.sortOrder, limit: this.pagination.limit, cursor: this.pagination.cursor }); [...q].forEach(([k,v]) => { if (!v) q.delete(k); }); return q.toString(); },
            async load() { this.loading = true; this.error = ''; try { const b = await apiFetch('/api/invoice?' + this.query()); this.rows = b.data || []; applyCursorPagination(this.pagination, b.pagination || {}); } catch (e) { this.error = e.message; } finally { this.loading = false; } },
            search() { resetCursorPagination(this.pagination); this.load(); }, reset() { this.q = ''; this.status = ''; this.dateField = 'issueDate'; this.startDate = ''; this.endDate = ''; this.sortOrder = 'newest'; this.search(); }, next() { if (cursorNext(this.pagination)) this.load(); }, previous() { if (cursorPrevious(this.pagination)) this.load(); }
          };
        }
      </script></div><%- include('../partials/footer') %>
    </div></div></div>
    <%- include('../partials/scripts') %>
  </body>
</html>
