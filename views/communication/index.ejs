<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper"><div class="content-inner">
        <div class="page-header page-header-light crm-page-header">
          <div class="page-header-content crm-page-heading">
            <div>
              <div class="crm-page-eyebrow">Operations</div>
              <h1 class="page-title mb-1"><%= title %></h1>
              <p class="crm-page-subtitle mb-0">Manage WhatsApp, email, internal Slack notifications, OTP and delivery activity.</p>
            </div>
            <div class="d-flex gap-2">
              <a href="/communications/send" class="btn btn-primary crm-primary-action">Send customer message</a>
              <a href="/communications/templates/new" class="btn btn-light crm-primary-action">Create template</a>
            </div>
          </div>
        </div>
        <div class="content" x-data="communicationDashboard()" x-init="load()">
          <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>
          <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
          <div class="d-flex flex-wrap gap-2 mb-3">
            <a class="btn btn-light btn-sm" href="/communications">Dashboard</a>
            <a class="btn btn-light btn-sm" href="/communications/logs">Message logs</a>
            <a class="btn btn-light btn-sm" href="/communications/templates">Templates</a>
            <a class="btn btn-light btn-sm" href="/communications/rules">Rules</a>
            <a class="btn btn-light btn-sm" href="/communications/otp">OTP activity</a>
            <a class="btn btn-light btn-sm" href="/communications/settings">Settings</a>
          </div>

          <div class="alert alert-info py-2 mb-3">
            Communication and OTP activity logs are automatically deleted by MongoDB after
            <strong x-text="config.retention?.communicationDays || 7">7</strong> days.
          </div>

          <section class="crm-metric-grid mb-4">
            <article class="crm-metric-card crm-metric-blue">
              <div class="crm-metric-top"><div><span class="crm-metric-label">WhatsApp sent</span><strong class="crm-metric-value" x-text="sentTotal('whatsapp')">0</strong></div></div>
              <div class="crm-metric-note"><b x-text="countStatus('whatsapp','read')">0</b> read messages</div>
            </article>
            <article class="crm-metric-card crm-metric-green">
              <div class="crm-metric-top"><div><span class="crm-metric-label">Email sent</span><strong class="crm-metric-value" x-text="sentTotal('email')">0</strong></div></div>
              <div class="crm-metric-note"><b x-text="countStatus('email','delivered')">0</b> delivered emails</div>
            </article>
            <article class="crm-metric-card crm-metric-purple">
              <div class="crm-metric-top"><div><span class="crm-metric-label">Slack pushed</span><strong class="crm-metric-value" x-text="sentTotal('slack')">0</strong></div></div>
              <div class="crm-metric-note">Internal team notifications</div>
            </article>
            <article class="crm-metric-card crm-metric-amber">
              <div class="crm-metric-top"><div><span class="crm-metric-label">OTP verified</span><strong class="crm-metric-value" x-text="otpCount('verified')">0</strong></div></div>
              <div class="crm-metric-note"><b x-text="otpCount('sent')">0</b> active/sent OTP requests</div>
            </article>
            <article class="crm-metric-card">
              <div class="crm-metric-top"><div><span class="crm-metric-label">Delivery failures</span><strong class="crm-metric-value" x-text="failureTotal()">0</strong></div></div>
              <div class="crm-metric-note">All configured channels</div>
            </article>
          </section>

          <section class="row g-3 mb-3">
            <div class="col-lg-5">
              <div class="card h-100">
                <div class="card-header crm-card-heading">
                  <div>
                    <h5 class="mb-1">Push internal Slack notification</h5>
                    <p class="text-muted mb-0">Select any Slack channel available to the bot and push a simple internal message.</p>
                  </div>
                </div>
                <form @submit.prevent="sendSlack()">
                  <div class="card-body">
                    <div x-show="slackSuccess" x-cloak class="alert alert-success" x-text="slackSuccess"></div>
                    <div x-show="slackError" x-cloak class="alert alert-danger" x-text="slackError"></div>
                    <div class="mb-3">
                      <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label mb-0">Slack channel</label>
                        <button type="button" class="btn btn-light btn-sm" @click="loadSlackChannels(true)" :disabled="slackSyncing">
                          <span x-text="slackSyncing ? 'Syncing…' : 'Sync channels'"></span>
                        </button>
                      </div>
                      <select class="form-select" x-model="slackForm.channelId" @change="selectSlackChannel()" required>
                        <option value="">Select Slack channel</option>
                        <template x-for="channel in slackChannels" :key="channel.id">
                          <option :value="channel.id" x-text="'#' + channel.name + (channel.isPrivate ? ' (private)' : '')"></option>
                        </template>
                      </select>
                      <div class="form-text">Private channels appear only after the Slack app is invited to them.</div>
                    </div>
                    <div>
                      <label class="form-label">Message</label>
                      <textarea class="form-control" rows="7" x-model="slackForm.message" maxlength="10000" placeholder="Write the internal team notification" required></textarea>
                    </div>
                  </div>
                  <div class="card-footer d-flex justify-content-between align-items-center">
                    <span class="text-muted fs-sm" x-text="config.slack?.available ? (config.deliveryMode === 'lambda' ? 'Slack delivery available through Lambda' : 'Slack bot configured') : 'Slack delivery is not configured'"></span>
                    <button class="btn btn-primary" :disabled="slackSending || !config.slack?.available || !slackForm.channelId">
                      <span x-text="slackSending ? 'Pushing…' : 'Push to Slack'"></span>
                    </button>
                  </div>
                </form>
              </div>
            </div>
            <div class="col-lg-7">
              <div class="card crm-data-card h-100">
                <div class="card-header crm-card-heading">
                  <div><h5 class="mb-1">Recent Slack notifications</h5><p class="text-muted mb-0">Messages pushed from this CRM during the seven-day retention window.</p></div>
                  <a class="btn btn-light btn-sm" href="/communications/logs?channel=slack">View all logs</a>
                </div>
                <div class="table-responsive">
                  <table class="table mb-0">
                    <thead><tr><th>Channel</th><th>Message</th><th>Status</th><th>Sent by</th><th>Date</th></tr></thead>
                    <tbody>
                      <template x-for="row in recentSlack" :key="row.communicationId">
                        <tr>
                          <td><strong x-text="'#' + (row.metadata?.slackChannelName || row.recipientContact || 'internal-team')"></strong><div class="text-muted fs-sm" x-text="row.metadata?.slackChannelId || ''"></div></td>
                          <td style="max-width:320px"><div class="text-truncate" x-text="row.message || '—'"></div></td>
                          <td><span class="crm-status" :class="statusClass(row.status)" x-text="humanize(row.status)"></span><div class="text-danger fs-sm" x-show="row.failureReason" x-text="row.failureReason"></div></td>
                          <td x-text="row.actor || 'system'"></td>
                          <td x-text="formatDate(row.createdAt)"></td>
                        </tr>
                      </template>
                      <tr x-show="!recentSlack.length"><td colspan="5" class="text-center text-muted py-4">No Slack notifications have been pushed yet</td></tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </section>

          <section class="row g-3 mb-3">
            <div class="col-lg-8">
              <div class="card crm-data-card h-100">
                <div class="card-header crm-card-heading"><div><h5 class="mb-1">Recent activity</h5><p class="text-muted mb-0">Latest outbound and inbound communication.</p></div><a class="btn btn-light btn-sm" href="/communications/logs">View logs</a></div>
                <div class="table-responsive"><table class="table mb-0"><thead><tr><th>Recipient</th><th>Channel</th><th>Purpose</th><th>Status</th><th>Date</th></tr></thead><tbody><template x-for="row in recent" :key="row.communicationId"><tr><td><div class="fw-semibold" x-text="row.recipientName || '—'"></div><div class="text-muted fs-sm" x-text="row.recipientContact || ''"></div></td><td x-text="humanize(row.channel)"></td><td x-text="humanize(row.purpose)"></td><td><span class="crm-status" :class="statusClass(row.status)" x-text="humanize(row.status)"></span></td><td x-text="formatDate(row.createdAt)"></td></tr></template><tr x-show="!recent.length"><td colspan="5" class="text-center text-muted py-4">No communication activity yet</td></tr></tbody></table></div>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="card h-100">
                <div class="card-header crm-card-heading"><div><h5 class="mb-1">Configuration</h5><p class="text-muted mb-0">Environment readiness.</p></div></div>
                <div class="card-body">
                  <div class="d-flex justify-content-between mb-3"><span>Delivery mode</span><strong x-text="humanize(config.deliveryMode)"></strong></div>
                  <div class="d-flex justify-content-between mb-3"><span>Meta WhatsApp</span><span class="crm-status" :class="config.whatsapp?.accessToken && config.whatsapp?.phoneNumberId ? 'status-approved' : 'status-rejected'" x-text="config.whatsapp?.accessToken && config.whatsapp?.phoneNumberId ? 'Configured' : 'Incomplete'"></span></div>
                  <div class="d-flex justify-content-between mb-3"><span>Amazon SES</span><span class="crm-status" :class="config.email?.fromEmail ? 'status-approved' : 'status-rejected'" x-text="config.email?.fromEmail ? 'Configured' : 'Incomplete'"></span></div>
                  <div class="d-flex justify-content-between mb-3"><span>Slack bot</span><span class="crm-status" :class="config.slack?.available ? 'status-approved' : 'status-rejected'" x-text="config.slack?.available ? 'Configured' : 'Missing'"></span></div>
                  <div class="d-flex justify-content-between"><span>OTP secret</span><span class="crm-status" :class="config.otp?.secret ? 'status-approved' : 'status-rejected'" x-text="config.otp?.secret ? 'Configured' : 'Missing'"></span></div>
                  <a class="btn btn-light w-100 mt-4" href="/communications/settings">Open settings checklist</a>
                </div>
              </div>
            </div>
          </section>
        </div>
        <%- include('../partials/footer') %>
      </div></div>
    </div>
    <script>
      function communicationDashboard() {
        return {
          data: {},
          recent: [],
          recentSlack: [],
          config: {},
          error: '',
          slackError: '',
          slackSuccess: '',
          slackSending: false,
          slackSyncing: false,
          slackChannels: [],
          slackForm: { channelId: '', channelName: '', message: '' },
          pagination: createCursorPagination(10),
          async load() {
            try {
              this.data = (await apiFetch('/api/communication/dashboard')).data || {};
              this.recent = this.data.communications?.recent || [];
              this.recentSlack = this.data.communications?.recentSlack || [];
              this.config = this.data.configuration || {};
              await this.loadSlackChannels(false);
            } catch (error) {
              this.error = error.message;
            }
          },
          async loadSlackChannels(refresh) {
            if (!this.config.slack?.botToken || this.config.deliveryMode === 'lambda') return;
            this.slackSyncing = true;
            this.slackError = '';
            try {
              const suffix = refresh ? '?refresh=1' : '';
              this.slackChannels = (await apiFetch('/api/communication/slack/channels' + suffix)).data || [];
              if (!this.slackForm.channelId && this.config.slack?.defaultChannelId) {
                const defaultChannel = this.slackChannels.find((item) => item.id === this.config.slack.defaultChannelId);
                if (defaultChannel) {
                  this.slackForm.channelId = defaultChannel.id;
                  this.slackForm.channelName = defaultChannel.name;
                }
              }
              if (!this.slackForm.channelId && this.slackChannels.length === 1) {
                this.slackForm.channelId = this.slackChannels[0].id;
                this.slackForm.channelName = this.slackChannels[0].name;
              }
            } catch (error) {
              this.slackError = error.message;
            } finally {
              this.slackSyncing = false;
            }
          },
          selectSlackChannel() {
            const selected = this.slackChannels.find((item) => item.id === this.slackForm.channelId);
            this.slackForm.channelName = selected?.name || '';
          },
          async sendSlack() {
            if (this.slackSending) return;
            this.slackSending = true;
            this.slackError = '';
            this.slackSuccess = '';
            try {
              const body = await apiFetch('/api/communication/slack/send', {
                method: 'POST',
                body: JSON.stringify(this.slackForm),
              });
              this.slackSuccess = 'Slack message pushed successfully. Communication ID: ' + body.data.communicationId;
              this.slackForm.message = '';
              await this.load();
            } catch (error) {
              this.slackError = error.message;
            } finally {
              this.slackSending = false;
            }
          },
          countStatus(channel, status) {
            return (this.data.communications?.statuses || []).find((row) => row._id?.channel === channel && row._id?.status === status)?.count || 0;
          },
          sentTotal(channel) {
            return this.countStatus(channel, 'accepted') + this.countStatus(channel, 'sent') + this.countStatus(channel, 'delivered') + this.countStatus(channel, 'read');
          },
          otpCount(status) {
            return (this.data.otp || []).find((row) => row._id === status)?.count || 0;
          },
          next() { return cursorNext(this.pagination); },
          previous() { return cursorPrevious(this.pagination); },
          failureTotal() {
            return ['failed','bounced','complained','rejected'].reduce((total, status) => total + (this.data.communications?.statuses || []).filter((row) => row._id?.status === status).reduce((sum,row) => sum + row.count, 0), 0);
          }
        };
      }
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
