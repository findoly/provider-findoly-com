<%
  const canAccess = typeof can === 'function' ? can : () => true;
%>
<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper"><div class="content-inner">
        <div class="page-header page-header-light crm-page-header">
          <div class="page-header-content crm-page-heading">
            <div><div class="crm-page-eyebrow">Administration</div><h1 class="page-title mb-1">Employees</h1><p class="crm-page-subtitle mb-0">Create employee profiles and control OTP access through assigned roles.</p></div>
            <% if (canAccess('employees.create')) { %><a href="/employees/new" class="btn btn-primary crm-primary-action">New employee</a><% } %>
          </div>
        </div>
        <main class="content" x-data="employeeList()" x-init="init()">
          <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>
          <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
          <section class="card mb-3"><div class="card-body crm-filter-toolbar"><div class="row g-2">
            <div class="col-lg-5"><input class="form-control" placeholder="Search name, mobile, code or department" x-model="filters.q" @keydown.enter.prevent="search()"></div>
            <div class="col-lg-2"><select class="form-select" x-model="filters.status" @change="search()"><option value="">All statuses</option><option value="active">Active</option><option value="inactive">Inactive</option><option value="suspended">Suspended</option></select></div>
            <div class="col-lg-3"><select class="form-select" x-model="filters.roleId" @change="search()"><option value="">All roles</option><template x-for="role in roles" :key="role.roleId"><option :value="role.roleId" x-text="role.name"></option></template></select></div>
            <div class="col-lg-2 d-flex gap-2"><button class="btn btn-primary flex-fill" @click="search()">Search</button><button class="btn btn-light" @click="reset()">Reset</button></div>
          </div><div class="row g-2 mt-1"><div class="col-lg-2"><select class="form-select" x-model="filters.dateField"><option value="createdAt">Created date</option><option value="updatedAt">Updated date</option><option value="lastLoginAt">Last login</option></select></div><div class="col-lg-2"><input class="form-control" type="date" x-model="filters.startDate" aria-label="From date"></div><div class="col-lg-2"><input class="form-control" type="date" x-model="filters.endDate" aria-label="To date"></div><div class="col-lg-2"><select class="form-select" x-model="filters.sortOrder"><option value="newest">Newest first</option><option value="oldest">Oldest first</option></select></div></div></div></section>
          <section class="card" :class="loading && 'crm-loading'">
            <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Employee</th><th>Contact</th><th>Role</th><th>Team</th><th>Status</th><th>Last login</th><th class="text-end">Action</th></tr></thead><tbody>
              <template x-for="employee in rows" :key="employee.employeeId"><tr>
                <td><strong x-text="employee.name"></strong><div class="text-muted fs-sm" x-text="employee.employeeCode || employee.employeeId"></div></td>
                <td><div x-text="'+91 ' + employee.mobile"></div><small class="text-muted" x-text="employee.email || 'No email'"></small></td>
                <td><strong x-text="employee.roleName"></strong></td>
                <td><div x-text="employee.designation || '—'"></div><small class="text-muted" x-text="employee.department || 'No department'"></small></td>
                <td><span class="crm-status" :class="statusClass(employee.status)" x-text="humanize(employee.status)"></span></td>
                <td x-text="formatDate(employee.lastLoginAt)"></td>
                <td class="text-end"><% if (canAccess('employees.edit')) { %><a class="crm-row-action" :href="'/employees/' + employee.employeeId + '/edit'">Edit</a><% } else { %><span class="text-muted">—</span><% } %></td>
              </tr></template>
              <tr x-show="!loading && !rows.length"><td colspan="7"><div class="crm-empty-state"><strong>No employees found</strong><span>Create an employee or change the filters.</span><% if (canAccess('employees.create')) { %><a href="/employees/new" class="btn btn-primary btn-sm">New employee</a><% } %></div></td></tr>
            </tbody></table></div>
            <div class="crm-table-footer"><div class="text-muted">Page <strong x-text="pagination.page"></strong></div><div class="crm-pagination"><button :disabled="pagination.page<=1 || loading" @click="previous()">Previous</button><span x-text="pagination.page"></span><button :disabled="!pagination.hasNext || loading" @click="next()">Next</button></div></div>
          </section>
        </main>
        <%- include('../partials/footer') %>
      </div></div>
    </div>
    <script>
      function employeeList(){return{rows:[],roles:[],filters:{q:'',status:'',roleId:'',dateField:'createdAt',startDate:'',endDate:'',sortOrder:'newest'},pagination:createCursorPagination(20),loading:false,error:'',async init(){try{this.roles=(await apiFetch('/api/employees/metadata')).data.roles||[];await this.load();}catch(error){this.error=error.message;}},query(){const q=new URLSearchParams({...this.filters,limit:this.pagination.limit,cursor:this.pagination.cursor});[...q].forEach(([k,v])=>{if(!v)q.delete(k)});return q.toString();},async load(){this.loading=true;this.error='';try{const body=await apiFetch('/api/employees?'+this.query());this.rows=body.data||[];applyCursorPagination(this.pagination,body.pagination||{});}catch(error){this.error=error.message;}finally{this.loading=false;}},search(){resetCursorPagination(this.pagination);this.load();},reset(){this.filters={q:'',status:'',roleId:'',dateField:'createdAt',startDate:'',endDate:'',sortOrder:'newest'};this.search();},next(){if(cursorNext(this.pagination))this.load();},previous(){if(cursorPrevious(this.pagination))this.load();}};}
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
