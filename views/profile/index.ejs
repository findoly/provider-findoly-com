<!DOCTYPE html>
<html lang="en" dir="ltr">
<%- include('../partials/head') %>
<body
  x-data='providerShell({ title: <%- JSON.stringify(title || "") %>, subtitle: <%- JSON.stringify(subtitle || "") %> })'
  x-init="initShell()"
  @wallet-updated.window="refreshProfile()"
  @profile-updated.window="refreshProfile()"
  @portal-page.window="setPage($event.detail)"
  @portal-notify.window="notify($event.detail)"
>
<%- include('../partials/navbar') %>
<div class="page-content">
  <%- include('../partials/sidebar') %>
  <div class="content-wrapper">
    <div class="content-inner">
      <div class="page-header portal-page-header border-bottom">
        <div class="page-header-content d-flex align-items-center">
          <div class="flex-grow-1 min-w-0">
            <h1 class="page-title mb-0 text-truncate" x-text="page.title"><%= title %></h1>
            <div class="page-subtitle mt-1" x-show="page.subtitle" x-text="page.subtitle"><%= subtitle || '' %></div>
          </div>
        </div>
      </div>
      <div class="content">
        <div x-show="shellError" x-cloak class="alert alert-danger portal-flash" x-text="shellError"></div>

<div x-data="profilePage()" x-init="load()" :class="loading ? 'portal-loading' : ''">
  <div x-show="error" x-cloak class="alert alert-danger portal-flash" x-text="error"></div>

  <div class="row g-4 align-items-start">
    <div class="col-xl-8">
      <div class="card portal-card mb-4">
        <div class="card-body portal-profile-hero">
          <div class="portal-profile-avatar" x-text="initials(profile.name || profile.businessName)">P</div>
          <div class="min-w-0 flex-grow-1">
            <div class="d-flex flex-wrap align-items-start gap-3">
              <div class="min-w-0">
                <h3 class="mb-1" x-text="profile.businessName || profile.name || 'Provider'"></h3>
                <div class="text-muted" x-text="profile.name || ''"></div>
              </div>
              <div class="d-flex flex-wrap gap-2 ms-xl-auto">
                <span class="badge bg-success-subtle text-success" x-text="humanize(profile.status)"></span>
                <span class="badge" :class="profile.locationReady ? 'bg-primary-subtle text-primary' : 'bg-warning-subtle text-warning'" x-text="profile.locationReady ? 'Location verified' : 'Location required'"></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="card portal-card portal-location-card mb-4">
        <div class="card-header border-bottom d-flex align-items-start gap-3">
          <div>
            <div class="portal-step-label">Marketplace location</div>
            <h5 class="mb-1">Your primary service PIN code</h5>
            <div class="text-muted fs-sm">Findoly uses this one location to show nearby category-matched leads first. Your full address is optional and is never shown before a lead is unlocked.</div>
          </div>
          <span class="badge ms-auto" :class="profile.locationReady ? 'bg-success text-white' : 'bg-warning text-dark'" x-text="profile.locationReady ? 'Verified' : 'Required'"></span>
        </div>
        <form class="card-body" @submit.prevent="saveLocation()">
          <div class="row g-3 align-items-end">
            <div class="col-md-4">
              <label class="form-label" for="servicePincode">PIN code <span class="text-danger">*</span></label>
              <input id="servicePincode" class="form-control form-control-lg" x-model="locationForm.servicePincode" @input="locationForm.servicePincode = String(locationForm.servicePincode || '').replace(/\D/g, '').slice(0, 6)" inputmode="numeric" pattern="[1-9][0-9]{5}" maxlength="6" placeholder="400001" required>
            </div>
            <div class="col-md-8">
              <label class="form-label" for="serviceAddress">Full address <span class="text-muted">(optional)</span></label>
              <input id="serviceAddress" class="form-control form-control-lg" x-model="locationForm.serviceAddress" maxlength="500" placeholder="Business or service address">
            </div>
            <div class="col-12">
              <button class="btn btn-primary" type="submit" :disabled="savingLocation">
                <span x-text="savingLocation ? 'Verifying location…' : 'Save service location'"></span>
              </button>
              <span class="text-muted fs-sm ms-2" x-show="profile.locationReady" x-text="detectedLocation"></span>
            </div>
          </div>
        </form>
      </div>

      <div class="card portal-card mb-4">
        <div class="card-header border-bottom"><h5 class="mb-0">Contact and service information</h5></div>
        <div class="table-responsive">
          <table class="table portal-detail-table mb-0">
            <tbody>
              <tr><th>Provider ID</th><td class="portal-id" x-text="profile.providerId || '—'"></td></tr>
              <tr><th>Mobile</th><td x-text="profile.mobile || '—'"></td></tr>
              <tr><th>Email</th><td x-text="profile.email || '—'"></td></tr>
              <tr><th>Verified area</th><td x-text="detectedLocation || 'Add your PIN code above'"></td></tr>
              <tr><th>Availability</th><td x-text="humanize(profile.availability)"></td></tr>
              <tr><th>Rating</th><td x-text="profile.rating ? `${profile.rating} / 5` : '—'"></td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card portal-card">
        <div class="card-header border-bottom"><h5 class="mb-0">Matched categories</h5></div>
        <div class="card-body">
          <div class="d-flex flex-wrap gap-2">
            <template x-for="category in profile.categorySlugs || []" :key="category">
              <span class="badge bg-primary-subtle text-primary" x-text="humanize(category)"></span>
            </template>
            <span class="text-muted" x-show="!(profile.categorySlugs || []).length">No categories assigned</span>
          </div>
          <p class="text-muted fs-sm mt-3 mb-0">Categories and account permissions are managed by the Findoly CRM team.</p>
        </div>
      </div>
    </div>

    <div class="col-xl-4">
      <div class="card portal-card portal-sticky-card">
        <div class="card-header border-bottom"><h5 class="mb-0">Account status</h5></div>
        <div class="card-body portal-profile-status">
          <div><span>CRM status</span><strong x-text="humanize(profile.status)"></strong></div>
          <div><span>Portal access</span><strong x-text="profile.portalAccessEnabled === false ? 'Disabled' : 'Enabled'"></strong></div>
          <div><span>Onboarding</span><strong x-text="humanize(profile.onboardingStage)"></strong></div>
          <div><span>Documents</span><strong x-text="profile.documentsVerified ? 'Verified' : 'Pending'"></strong></div>
          <div><span>Marketplace location</span><strong x-text="profile.locationReady ? profile.servicePincode : 'Required'"></strong></div>
          <div><span>Credits</span><strong x-text="credits(profile.availableCredits ?? profile.walletCredits)"></strong></div>
          <div><span>CRM last updated</span><strong x-text="formatDate(profile.updatedAt)"></strong></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  function profilePage() {
    return {
      profile: {},
      locationForm: { servicePincode: '', serviceAddress: '' },
      loading: true,
      savingLocation: false,
      error: '',
      get detectedLocation() {
        return [
          this.profile.serviceLocality || this.profile.city,
          this.profile.serviceDistrict,
          this.profile.serviceState || this.profile.state,
          this.profile.servicePincode
        ].filter(Boolean).filter((value, index, values) => values.indexOf(value) === index).join(', ');
      },
      syncForm() {
        this.locationForm = {
          servicePincode: this.profile.servicePincode || '',
          serviceAddress: this.profile.serviceAddress || ''
        };
      },
      async load() {
        try {
          this.profile = (await apiFetch('/api/profile')).data;
          this.syncForm();
        } catch (error) {
          this.error = error.message;
        } finally {
          this.loading = false;
        }
      },
      async saveLocation() {
        this.error = '';
        if (!/^[1-9]\d{5}$/.test(String(this.locationForm.servicePincode || ''))) {
          this.error = 'Enter a valid 6-digit Indian PIN code';
          return;
        }
        this.savingLocation = true;
        try {
          this.profile = (await apiFetch('/api/profile/location', {
            method: 'PATCH',
            body: JSON.stringify(this.locationForm)
          })).data;
          this.syncForm();
          this.$dispatch('profile-updated');
          this.$dispatch('portal-notify', { type: 'success', message: `Service location verified for PIN ${this.profile.servicePincode}. Nearby leads will now appear based on distance.` });
        } catch (error) {
          this.error = error.message;
        } finally {
          this.savingLocation = false;
        }
      }
    };
  }
</script>

      </div>
      <%- include('../partials/footer') %>
    </div>
  </div>
</div>
<div class="portal-sidebar-overlay" @click="closeSidebar()"></div>
<%- include('../partials/scripts') %>
</body>
</html>
