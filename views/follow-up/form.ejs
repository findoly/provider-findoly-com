<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Operations</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Create or update a follow-up record.</p>
              </div>
              <a href="/follow-ups" class="btn btn-light crm-primary-action"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back to follow-ups</a>
            </div>
          </div>
          <div class="content">
            <div
              x-show="shellError"
              x-cloak
              class="alert alert-danger"
              x-text="shellError"
            ></div>
            <div x-data="formPage()" x-init="init()">
              <div
                x-show="error"
                class="alert alert-danger"
                x-text="error"
              ></div>
              <form class="card" @submit.prevent="save">
                <div class="card-body">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="form-label">Title</label
                      ><input
                        class="form-control"
                        x-model="form.title"
                        maxlength="200"
                        required
                      />
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Requirement ID</label
                      ><input class="form-control" x-model="form.enquiryId" maxlength="128" pattern="[A-Za-z0-9][A-Za-z0-9_:-]*" />
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Customer</label
                      ><input
                        class="form-control"
                        x-model="form.customerName"
                        maxlength="120"
                      />
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Due</label
                      ><input
                        type="datetime-local"
                        class="form-control"
                        x-model="form.dueAt"
                      />
                    </div>
                    <div class="col-md-2">
                      <label class="form-label">Channel</label
                      ><select class="form-select" x-model="form.channel">
                        <option>call</option>
                        <option>whatsapp</option>
                        <option>email</option>
                        <option>visit</option>
                      </select>
                    </div>
                    <div class="col-md-2">
                      <label class="form-label">Status</label
                      ><select class="form-select" x-model="form.status">
                        <option>open</option>
                        <option>pending</option>
                        <option>completed</option>
                        <option>cancelled</option>
                      </select>
                    </div>
                    <div class="col-12">
                      <label class="form-label">Notes</label
                      ><textarea
                        class="form-control"
                        x-model="form.notes"
                        maxlength="5000"
                      ></textarea>
                    </div>
                  </div>
                </div>
                <div class="card-footer">
                  <button class="btn btn-primary" :disabled="saving" x-text="saving ? 'Saving…' : 'Save'"></button>
                </div>
              </form>
            </div>
            <script>
              function formPage() {
                return {
                  mode: pageMode(),
                  recordId: pageMode() === "edit" ? pathRecordId(true) : "",
                  form: {
                    enquiryId: queryValue("enquiryId"),
                    customerName: "",
                    title: "",
                    dueAt: "",
                    channel: "call",
                    status: "open",
                    notes: "",
                  },
                  error: "",
                  saving: false,
                  async init() {
                    if (this.mode === "edit") {
                      const record = (await apiFetch("/api/follow-up/" + this.recordId)).data;
                      this.form = {
                        ...this.form,
                        ...record,
                        dueAt: formatDateTimeLocal(record.dueAt),
                      };
                    }
                  },
                  async save() {
                    if (this.saving) return;
                    this.error = "";
                    this.saving = true;
                    try {
                      await apiFetch(
                        this.mode === "edit"
                          ? "/api/follow-up/" + this.recordId
                          : "/api/follow-up",
                        {
                          method: this.mode === "edit" ? "PUT" : "POST",
                          body: JSON.stringify(this.form),
                        },
                      );
                      location.href = "/follow-ups";
                    } catch (e) {
                      this.error = e.message;
                    } finally {
                      this.saving = false;
                    }
                  },
                };
              }
            </script>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>
    <%- include('../partials/scripts') %>
  </body>
</html>
