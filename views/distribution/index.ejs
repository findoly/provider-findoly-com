<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
      <div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Lead distribution</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0">Inspect provider-specific lead offers and unlocks.</p></div></div></div>
      <div class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-data="distPage()" x-init="load()"><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
        <section class="card crm-filter-card mb-3"><form class="crm-filter-bar" @submit.prevent="search()"><input class="form-control" style="max-width:260px" x-model="filters.enquiryId" placeholder="Enquiry ID"><input class="form-control" style="max-width:260px" x-model="filters.providerId" placeholder="Provider ID"><select class="form-select" style="max-width:180px" x-model="filters.status"><option value="">All statuses</option><option>offered</option><option>unlocked</option><option>withdrawn</option><option>expired</option></select><select class="form-select" style="max-width:180px" x-model="filters.dateField"><option value="distributedAt">Distributed</option><option value="unlockedAt">Unlocked</option><option value="updatedAt">Updated</option></select><input class="form-control" style="max-width:150px" type="date" x-model="filters.startDate" aria-label="From date"><input class="form-control" style="max-width:150px" type="date" x-model="filters.endDate" aria-label="To date"><select class="form-select" style="max-width:150px" x-model="filters.sortOrder"><option value="newest">Newest</option><option value="oldest">Oldest</option></select><button class="btn btn-primary" type="submit">Apply</button><button class="btn btn-light" type="button" @click="reset()">Clear</button><label class="crm-page-size ms-auto"><span>Rows</span><select x-model.number="pagination.limit" @change="search()"><option :value="10">10</option><option :value="20">20</option><option :value="50">50</option><option :value="100">100</option></select></label></form></section>
        <section class="card crm-data-card"><div class="card-header crm-card-heading"><div><h5 class="mb-1">Distribution records</h5><p class="text-muted mb-0"><span x-text="rows.length"></span> rows on this page</p></div></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Lead</th><th>Provider</th><th>Category</th><th>Status</th><th>Provider status</th><th>Price</th><th>Date</th></tr></thead><tbody><template x-if="loading"><tr><td colspan="7"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template><template x-for="d in rows" :key="d.leadDistributionId"><tr><td><a :href="'/enquiries/'+d.enquiryId" x-text="d.leadTitle||d.enquiryId"></a></td><td><a :href="'/providers/'+d.providerId" x-text="d.providerName||d.providerId"></a></td><td x-text="d.categorySlug"></td><td x-text="humanize(d.status)"></td><td x-text="d.providerLeadStatus ? humanize(d.providerLeadStatus) : 'Not updated'"></td><td x-text="money(d.leadPricePaise)"></td><td x-text="formatDate(d.distributedAt)"></td></tr></template><tr x-show="!loading && !rows.length"><td colspan="7" class="text-center text-muted py-4">No distribution records found</td></tr></tbody></table></div><div class="crm-table-footer"><div class="text-muted">Page <strong x-text="pagination.page"></strong></div><div class="crm-pagination"><button :disabled="pagination.page <= 1 || loading" @click="previous()">Previous</button><span x-text="pagination.page"></span><button :disabled="!pagination.hasNext || loading" @click="next()">Next</button></div></div></section>
      </div><script>
        function distPage() {
          return {
            rows: [], filters: { enquiryId: '', providerId: '', status: '', dateField: 'distributedAt', startDate: '', endDate: '', sortOrder: 'newest' }, pagination: createCursorPagination(20), loading: false, error: '',
            query() { const q = new URLSearchParams({ ...this.filters, limit: this.pagination.limit, cursor: this.pagination.cursor }); [...q].forEach(([k,v]) => { if (!v) q.delete(k); }); return q.toString(); },
            async load() { this.loading = true; this.error = ''; try { const b = await apiFetch('/api/distribution?' + this.query()); this.rows = b.data || []; applyCursorPagination(this.pagination, b.pagination || {}); } catch (e) { this.error = e.message; } finally { this.loading = false; } },
            search() { resetCursorPagination(this.pagination); this.load(); }, reset() { this.filters = { enquiryId: '', providerId: '', status: '', dateField: 'distributedAt', startDate: '', endDate: '', sortOrder: 'newest' }; this.search(); }, next() { if (cursorNext(this.pagination)) this.load(); }, previous() { if (cursorPrevious(this.pagination)) this.load(); }
          };
        }
      </script></div><%- include('../partials/footer') %>
    </div></div></div>
    <%- include('../partials/scripts') %>
  </body>
</html>
