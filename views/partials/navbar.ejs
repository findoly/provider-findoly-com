</svg>

<header class="portal-navbar portal-navbar-minimal workspace-topbar" role="banner">
  <div class="portal-navbar-inner workspace-topbar-inner">
    <button id="portalMobileMenuButton" type="button" class="portal-mobile-menu d-lg-none" aria-label="Open navigation" aria-controls="providerSidebar" aria-expanded="false" data-portal-menu-toggle>
      <svg class="icon"><use href="#i-menu"></use></svg>
    </button>

    <a href="/dashboard" class="portal-brand workspace-brand" aria-label="Findoly provider workspace">
      <img src="/images/findoly-logo.png" alt="Findoly" class="portal-brand-logo">
      <span class="portal-brand-product">Business</span>
    </a>

    <div class="portal-header-context workspace-page-context d-none d-md-grid">
      <strong x-text="page.title || 'Business workspace'">Business workspace</strong>
      <span x-text="page.subtitle || 'Leads, customers and Lead Credits in one place'">Leads, customers and Lead Credits in one place</span>
    </div>

    <div class="portal-navbar-actions workspace-topbar-actions ms-auto">
      <a class="workspace-marketplace-shortcut d-none d-xl-inline-flex" href="/leads?status=offered">
        <svg class="icon"><use href="#i-search"></use></svg><span>Find leads</span>
      </a>
      <a class="portal-header-action workspace-icon-button d-none d-sm-inline-flex" href="/leads?status=unlocked&amp;outcome=pending" aria-label="Pending outcomes" title="Pending outcomes">
        <svg class="icon"><use href="#i-bell"></use></svg>
      </a>
      <a class="portal-header-credit workspace-credit-chip" href="/wallet" aria-label="Open Lead Credit activity">
        <svg class="icon"><use href="#i-credit"></use></svg>
        <span class="d-none d-sm-inline">Lead Credits</span>
        <strong x-text="credits(provider.availableCredits ?? provider.walletCredits)">0 Credits</strong>
      </a>

      <div class="dropdown portal-profile-dropdown">
        <button class="portal-user-button workspace-user-button" data-bs-toggle="dropdown" data-bs-display="static" data-bs-auto-close="outside" type="button" aria-expanded="false" aria-label="Open account menu">
          <span x-text="initials(provider.name || provider.businessName || 'Provider')">P</span>
          <span class="workspace-user-copy d-none d-lg-grid"><strong x-text="provider.businessName || provider.name || 'Provider'">Provider</strong><small>Account</small></span>
          <svg class="portal-user-caret" viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg>
        </button>
        <div class="dropdown-menu dropdown-menu-end portal-profile-menu workspace-profile-menu">
          <div class="portal-profile-menu-header">
            <span class="portal-profile-menu-avatar" x-text="initials(provider.name || provider.businessName || 'Provider')">P</span>
            <div class="min-w-0">
              <strong class="text-truncate" x-text="provider.businessName || provider.name || 'Provider'">Provider</strong>
              <small class="text-truncate" x-text="provider.city || provider.serviceLocality || 'Findoly provider'">Findoly provider</small>
            </div>
          </div>
          <div class="portal-profile-menu-links">
            <a class="dropdown-item" href="/profile"><svg class="icon"><use href="#i-user"></use></svg><span>Business profile</span></a>
            <a class="dropdown-item" href="/plans"><svg class="icon"><use href="#i-credit"></use></svg><span>Get Lead Credits</span></a>
          </div>
          <div class="dropdown-divider"></div>
          <button class="dropdown-item text-danger" type="button" @click="logout()"><svg class="icon"><use href="#i-logout"></use></svg><span>Sign out</span></button>
        </div>
      </div>
    </div>
  </div>
</header>

<nav class="portal-mobile-nav d-lg-none workspace-mobile-nav" aria-label="Mobile navigation">
  <a href="/dashboard" :class="{ active: pathIs('/dashboard') }"><svg class="icon"><use href="#i-home"></use></svg><span>Home</span></a>
  <a href="/leads?status=offered" :class="{ active: pathIs('/leads') && queryStatus !== 'unlocked' }"><svg class="icon"><use href="#i-search"></use></svg><span>Find</span></a>
  <a href="/leads?status=unlocked" :class="{ active: pathIs('/leads') && queryStatus === 'unlocked' }"><svg class="icon"><use href="#i-briefcase"></use></svg><span>My leads</span></a>
  <a href="/plans" :class="{ active: pathIs('/plans') || pathIs('/wallet') }"><svg class="icon"><use href="#i-credit"></use></svg><span>Credits</span></a>
  <a href="/profile" :class="{ active: pathIs('/profile') }"><svg class="icon"><use href="#i-user"></use></svg><span>Profile</span></a>
</nav>

<div class="portal-toast" x-cloak x-show="notice.show" x-transition :class="'portal-toast-' + notice.type" role="status" aria-live="polite">
  <span class="portal-toast-dot"></span>
  <span x-text="notice.message"></span>
  <button type="button" aria-label="Dismiss" @click="notice.show = false">×</button>
</div>