<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta id="portal-theme-color" name="theme-color" content="#ffffff">
  <meta name="robots" content="noindex,nofollow">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="icon" type="image/png" href="/images/findoly-logo.png">
  <title><%= title ? title + ' · ' : '' %><%= appName %></title>
  <script nonce="<%= cspNonce %>">
    (() => {
      document.documentElement.dataset.portalTheme = 'professional-blue';
      try { localStorage.removeItem('providerPortalTheme'); } catch (_) {}
      const meta = document.getElementById('portal-theme-color');
      if (meta) meta.setAttribute('content', '#ffffff');
    })();
  </script>
  <link href="/css/inter.css?v=provider-blue-locked-20260719-1" rel="stylesheet" type="text/css">
  <link href="/css/styles.min.css" rel="stylesheet" type="text/css">
  <link href="/css/app.css?v=provider-grid-row-neutral-findoly-logo-provider-join-20260801-1" rel="stylesheet" type="text/css">
  <link href="/css/lead-plans.css" rel="stylesheet" type="text/css">
  <script nonce="<%= cspNonce %>" defer src="/js/alpine.min.js"></script>
  <script nonce="<%= cspNonce %>" src="/js/bootstrap.bundle.min.js" defer></script>
</head>
