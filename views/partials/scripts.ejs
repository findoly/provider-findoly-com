<script nonce="<%= cspNonce %>">
  function pathParts() {
    return location.pathname.split('/').filter(Boolean);
  }

  function pathRecordId(editPage = false) {
    const parts = pathParts();
    return editPage ? (parts[parts.length - 2] || '') : (parts[parts.length - 1] || '');
  }

  function queryValue(name, fallback = '') {
    return new URLSearchParams(location.search).get(name) || fallback;
  }

  function cookieValue(name) {
    const prefix = encodeURIComponent(name) + '=';
    const item = document.cookie.split('; ').find((value) => value.startsWith(prefix));
    return item ? decodeURIComponent(item.slice(prefix.length)) : '';
  }

  function safeReturnTo(value, fallback = '/dashboard') {
    const target = String(value || '');
    if (!target.startsWith('/') || target.startsWith('//')) return fallback;
    if (target.startsWith('/api') || target.startsWith('/login')) return fallback;
    return target;
  }

  async function apiFetch(url, options = {}) {
    const method = String(options.method || 'GET').toUpperCase();
    const headers = {
      Accept: 'application/json',
      ...(options.headers || {})
    };

    if (options.body !== undefined && !headers['Content-Type']) {
      headers['Content-Type'] = 'application/json';
    }

    if (!['GET', 'HEAD', 'OPTIONS'].includes(method)) {
      headers['X-CSRF-Token'] = cookieValue(<%- JSON.stringify(csrfCookieName || 'provider_csrf') %>);
    }

    const response = await fetch(url, {
      credentials: 'same-origin',
      cache: 'no-store',
      ...options,
      method,
      headers
    });

    const body = await response.json().catch(() => ({
      success: false,
      message: 'The server returned an invalid response'
    }));

    const authCodes = [
      'AUTHENTICATION_REQUIRED',
      'SESSION_INVALID',
      'PROVIDER_NOT_FOUND',
      'PROVIDER_INACTIVE',
      'PORTAL_ACCESS_DISABLED',
      'PROVIDER_ID_MISSING'
    ];

    if ((response.status === 401 || response.status === 403) && authCodes.includes(body.code)) {
      const returnTo = safeReturnTo(location.pathname + location.search);
      location.href = '/login?returnTo=' + encodeURIComponent(returnTo) + '&reason=' + encodeURIComponent(body.code || 'SESSION_INVALID');
      throw Object.assign(new Error(body.message || 'Authentication required'), { code: body.code, status: response.status });
    }

    if (!response.ok || body.success === false) {
      throw Object.assign(new Error(body.message || 'Request failed'), {
        code: body.code || 'REQUEST_FAILED',
        status: response.status,
        requestId: body.requestId || response.headers.get('x-request-id') || ''
      });
    }

    return body;
  }

  function money(paise) {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    }).format(Number(paise || 0) / 100);
  }

  function credits(value) {
    const amount = Number(value || 0);
    const formatted = new Intl.NumberFormat('en-IN', {
      minimumFractionDigits: Number.isInteger(amount) ? 0 : 2,
      maximumFractionDigits: 2
    }).format(amount);
    return `${formatted} ${amount === 1 ? 'Credit' : 'Credits'}`;
  }

  function formatDate(value) {
    if (!value) return '—';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value);
    return new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium', timeStyle: 'short' }).format(date);
  }

  function formatDateOnly(value) {
    if (!value) return 'Flexible';
    const date = new Date(String(value).length === 10 ? `${value}T00:00:00` : value);
    if (Number.isNaN(date.getTime())) return String(value);
    return new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium' }).format(date);
  }

  const PROVIDER_TEXT_EMOJI_PATTERN = /[\p{Extended_Pictographic}\u{1F1E6}-\u{1F1FF}\uFE0F\u20E3]/u;
  const PROVIDER_TEXT_HTML_PATTERN = /<\/?[A-Za-z][^>]*>|&(?:#\d+|#x[0-9A-Fa-f]+|[A-Za-z][A-Za-z0-9]+);/u;

  function assertProviderPlainText(value, label = 'Text') {
    const text = String(value || '');
    if (PROVIDER_TEXT_EMOJI_PATTERN.test(text)) throw new Error(label + ' must not contain emoji');
    if (PROVIDER_TEXT_HTML_PATTERN.test(text)) throw new Error(label + ' must not contain HTML tags or encoded HTML');
    return text;
  }

  function humanize(value) {
    return String(value || '—')
      .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
      .replace(/[_-]/g, ' ')
      .replace(/\b\w/g, (character) => character.toUpperCase());
  }

  function initials(value) {
    const parts = String(value || 'Provider').trim().split(/\s+/).filter(Boolean);
    return parts.slice(0, 2).map((part) => part[0]).join('').toUpperCase() || 'P';
  }

  function displayTitleCase(value, fallback = '—') {
    const text = String(value || '').replace(/\s+/g, ' ').trim();
    if (!text) return fallback;
    return text.split(' ').map((word) => {
      if (/^[A-Z0-9&.+-]{2,6}$/.test(word)) return word;
      if (/^\d+$/.test(word)) return word;
      return word.charAt(0).toUpperCase() + word.slice(1).toLocaleLowerCase('en-IN');
    }).join(' ');
  }

  function displaySentenceCase(value, fallback = '—') {
    const text = String(value || '').replace(/\s+/g, ' ').trim();
    if (!text) return fallback;
    const firstLetterIndex = text.search(/[A-Za-z]/);
    if (firstLetterIndex < 0) return text;
    return text.slice(0, firstLetterIndex)
      + text.charAt(firstLetterIndex).toLocaleUpperCase('en-IN')
      + text.slice(firstLetterIndex + 1);
  }

  function displayLocation(...parts) {
    const values = parts.flat().filter((value) => String(value || '').trim());
    if (!values.length) return '—';
    return values.map((value) => {
      const text = String(value).trim();
      return /^\d{5,6}$/.test(text) ? text : displayTitleCase(text, text);
    }).join(', ');
  }

  const providerDrawerState = {
    open: false,
    lastFocused: null,
    scrollY: 0
  };

  function providerDrawerElements() {
    return {
      button: document.querySelector('[data-portal-menu-toggle]'),
      sidebar: document.getElementById('providerSidebar'),
      overlay: document.querySelector('[data-portal-menu-overlay]'),
      closeButton: document.querySelector('[data-portal-menu-close]')
    };
  }

  function setProviderSidebarOpen(open, { restoreFocus = true } = {}) {
    const mobile = window.matchMedia('(max-width: 991.98px)').matches;
    const shouldOpen = Boolean(open) && mobile;
    const wasOpen = providerDrawerState.open;
    const { button, sidebar, overlay } = providerDrawerElements();

    if (shouldOpen && !wasOpen) {
      providerDrawerState.lastFocused = document.activeElement instanceof HTMLElement
        ? document.activeElement
        : button;
      providerDrawerState.scrollY = window.scrollY || window.pageYOffset || 0;
    }

    providerDrawerState.open = shouldOpen;
    document.body.classList.toggle('portal-sidebar-open', shouldOpen);
    document.documentElement.classList.toggle('portal-sidebar-open', shouldOpen);

    document.body.style.overflow = shouldOpen ? 'hidden' : '';
    document.documentElement.style.overflow = shouldOpen ? 'hidden' : '';
    if (!shouldOpen && wasOpen) providerDrawerState.scrollY = 0;

    if (button) {
      button.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
      button.setAttribute('aria-label', shouldOpen ? 'Close navigation' : 'Open navigation');
    }
    if (sidebar) {
      sidebar.setAttribute('aria-hidden', shouldOpen ? 'false' : (mobile ? 'true' : 'false'));
      sidebar.toggleAttribute('data-drawer-open', shouldOpen);
    }
    if (overlay) {
      overlay.setAttribute('aria-hidden', shouldOpen ? 'false' : 'true');
      overlay.toggleAttribute('data-overlay-open', shouldOpen);
    }

    if (shouldOpen) {
      window.requestAnimationFrame(() => {
        const firstTarget = sidebar?.querySelector('[data-portal-menu-close], [data-portal-menu-link]');
        firstTarget?.focus({ preventScroll: true });
      });
    } else if (restoreFocus && providerDrawerState.lastFocused instanceof HTMLElement) {
      providerDrawerState.lastFocused.focus({ preventScroll: true });
      providerDrawerState.lastFocused = null;
    }
  }

  let providerNavigationInitialized = false;

  function initializeProviderNavigation() {
    if (providerNavigationInitialized) return;
    providerNavigationInitialized = true;

    const { button, closeButton, overlay, sidebar } = providerDrawerElements();
    const closeNavigation = (restoreFocus = true) => setProviderSidebarOpen(false, { restoreFocus });

    if (button) {
      button.onclick = (event) => {
        event.preventDefault();
        event.stopPropagation();
        setProviderSidebarOpen(!providerDrawerState.open);
      };
    }

    if (closeButton) {
      closeButton.onclick = (event) => {
        event.preventDefault();
        event.stopPropagation();
        closeNavigation();
      };
    }

    if (overlay) {
      overlay.onclick = (event) => {
        event.preventDefault();
        closeNavigation();
      };
    }

    if (sidebar) {
      sidebar.querySelectorAll('a[data-portal-menu-link]').forEach((link) => {
        link.addEventListener('click', (event) => {
          if (!window.matchMedia('(max-width: 991.98px)').matches) return;
          const href = link.getAttribute('href');
          if (!href) return;
          event.preventDefault();
          event.stopPropagation();
          closeNavigation(false);
          window.setTimeout(() => window.location.assign(href), 0);
        }, true);
      });
    }

    document.querySelectorAll('.portal-mobile-nav a').forEach((link) => {
      link.addEventListener('click', () => closeNavigation(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && providerDrawerState.open) closeNavigation();
      if (event.key !== 'Tab' || !providerDrawerState.open || !sidebar) return;

      const focusable = Array.from(sidebar.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )).filter((element) => element.offsetParent !== null);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 992) closeNavigation(false);
    }, { passive: true });
    window.addEventListener('pageshow', () => closeNavigation(false), { passive: true });

    closeNavigation(false);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeProviderNavigation, { once: true });
  } else {
    initializeProviderNavigation();
  }

  document.addEventListener('submit', (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || form.dataset.allowRichText === 'true') return;
    const fields = form.querySelectorAll('input[type="text"], input[type="search"], textarea');
    for (const field of fields) {
      if (field.disabled || field.dataset.allowRichText === 'true') continue;
      try {
        assertProviderPlainText(field.value, field.labels?.[0]?.textContent?.trim() || field.placeholder || 'Text');
      } catch (error) {
        event.preventDefault();
        event.stopImmediatePropagation();
        field.focus();
        field.setCustomValidity(error.message);
        field.reportValidity();
        window.setTimeout(() => field.setCustomValidity(''), 0);
        return;
      }
    }
  }, true);

  function providerShell(config = {}) {
    return {
      provider: {},
      shellError: '',
      shellSearch: new URLSearchParams(location.search).get('q') || '',
      page: { title: config.title || '', subtitle: config.subtitle || '' },
      queryStatus: new URLSearchParams(location.search).get('status') || '',
      notice: { show: false, type: 'success', message: '' },
      noticeTimer: null,

      async initShell() {
        await this.refreshProfile();
      },

      async refreshProfile() {
        try {
          this.provider = (await apiFetch('/api/profile')).data;
          this.shellError = '';
        } catch (error) {
          this.shellError = error.message;
        }
      },

      pathIs(path) {
        return location.pathname === path || location.pathname.startsWith(path + '/');
      },

      setPage(detail = {}) {
        if (detail.title) this.page.title = detail.title;
        this.page.subtitle = detail.subtitle || '';
        if (detail.documentTitle) document.title = detail.documentTitle;
      },

      notify(detail = {}) {
        clearTimeout(this.noticeTimer);
        this.notice = {
          show: true,
          type: detail.type || 'success',
          message: detail.message || ''
        };
        this.noticeTimer = setTimeout(() => { this.notice.show = false; }, 4500);
      },

      runSearch() {
        const query = String(this.shellSearch || '').trim();
        location.href = query ? `/leads?q=${encodeURIComponent(query)}` : '/leads';
      },

      toggleSidebar() {
        setProviderSidebarOpen(!document.body.classList.contains('portal-sidebar-open'));
      },

      closeSidebar() {
        setProviderSidebarOpen(false);
      },

      async logout() {
        try {
          await apiFetch('/api/auth/logout', { method: 'POST', body: '{}' });
        } finally {
          location.href = '/login';
        }
      }
    };
  }
</script>
