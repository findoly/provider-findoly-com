<aside id="providerSidebar" class="sidebar sidebar-main sidebar-expand-lg portal-sidebar portal-sidebar-minimal workspace-sidebar" aria-label="Provider workspace" aria-hidden="false">
  <div class="sidebar-content workspace-sidebar-content">
    <div class="workspace-sidebar-mobile-head d-lg-none">
      <a href="/dashboard" class="workspace-sidebar-drawer-brand" data-portal-menu-link aria-label="Findoly provider home">
        <img src="/images/findoly-logo.png" alt="Findoly">
      </a>
      <button type="button" class="portal-sidebar-close" aria-label="Close navigation" data-portal-menu-close>×</button>
    </div>

    <nav class="portal-sidebar-nav workspace-sidebar-nav" aria-label="Workspace navigation">
      <span class="workspace-nav-label">Workspace</span>
      <a data-portal-menu-link href="/dashboard" :class="{ active: pathIs('/dashboard') }"><svg class="icon"><use href="#i-home"></use></svg><span>Overview</span></a>
      <a data-portal-menu-link href="/leads?status=unlocked" :class="{ active: pathIs('/leads') && queryValue('outcome') !== 'pending' && queryValue('activityStatus') !== 'follow_up' }"><svg class="icon"><use href="#i-briefcase"></use></svg><span>Assigned requirements</span></a>
      <a data-portal-menu-link href="/leads?status=unlocked&amp;outcome=pending" :class="{ active: pathIs('/leads') && queryValue('outcome') === 'pending' }"><svg class="icon"><use href="#i-clock"></use></svg><span>Pending outcomes</span></a>
      <a data-portal-menu-link href="/leads?status=unlocked&amp;activityStatus=follow_up" :class="{ active: pathIs('/leads') && queryValue('activityStatus') === 'follow_up' }"><svg class="icon"><use href="#i-trend"></use></svg><span>Follow-ups</span></a>

      <span class="workspace-nav-label workspace-nav-label-account">Business</span>
      <a data-portal-menu-link href="/plans" :class="{ active: pathIs('/plans') }"><svg class="icon"><use href="#i-unlock"></use></svg><span>Account credits</span></a>
      <a data-portal-menu-link href="/wallet" :class="{ active: pathIs('/wallet') }"><svg class="icon"><use href="#i-trend"></use></svg><span>Credit activity</span></a>
      <a data-portal-menu-link href="/profile" :class="{ active: pathIs('/profile') }"><svg class="icon"><use href="#i-user"></use></svg><span>Business profile</span></a>
    </nav>

    <div class="portal-sidebar-footer workspace-sidebar-footer">
      <a data-portal-menu-link href="/help-support" class="workspace-support-link"><svg class="icon"><use href="#i-support"></use></svg><span>Help &amp; account support</span></a>
      <button type="button" @click="logout()"><svg class="icon"><use href="#i-logout"></use></svg><span>Sign out</span></button>
    </div>
  </div>
</aside>