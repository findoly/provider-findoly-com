<aside class="sidebar sidebar-main sidebar-expand-lg portal-sidebar portal-sidebar-minimal" aria-label="Provider workspace">
  <div class="sidebar-content">
    <div class="portal-sidebar-account">
      <button type="button" class="portal-sidebar-close d-lg-none" aria-label="Close navigation" @click="closeSidebar()">×</button>
      <span class="portal-sidebar-avatar" x-text="initials(provider.name || provider.businessName || 'Provider')">P</span>
      <div class="min-w-0">
        <strong class="text-truncate" x-text="provider.businessName || provider.name || 'Provider'">Provider</strong>
        <small class="text-truncate" x-text="provider.locationReady ? ([provider.serviceLocality || provider.city, provider.serviceState || provider.state].filter(Boolean).join(', ') || provider.servicePincode) : 'Location pending'">Provider account</small>
      </div>
    </div>

    <nav class="portal-sidebar-nav" aria-label="Workspace navigation">
      <a href="/dashboard" :class="{ active: pathIs('/dashboard') }"><svg class="icon"><use href="#i-home"></use></svg><span>Dashboard</span></a>
      <a href="/leads?status=offered" :class="{ active: pathIs('/leads') && queryStatus !== 'unlocked' }"><svg class="icon"><use href="#i-lead"></use></svg><span>Lead marketplace</span></a>
      <a href="/leads?status=unlocked" :class="{ active: pathIs('/leads') && queryStatus === 'unlocked' && queryValue('outcome') !== 'pending' }"><svg class="icon"><use href="#i-unlock"></use></svg><span>Unlocked leads</span></a>
      <a href="/leads?status=unlocked&amp;outcome=pending" :class="{ active: pathIs('/leads') && queryStatus === 'unlocked' && queryValue('outcome') === 'pending' }"><svg class="icon"><use href="#i-clock"></use></svg><span>Pending outcomes</span></a>
      <span class="portal-sidebar-divider" aria-hidden="true"></span>
      <a href="/plans" :class="{ active: pathIs('/plans') || pathIs('/wallet') }"><svg class="icon"><use href="#i-plan"></use></svg><span>Plans &amp; credits</span></a>
      <a href="/profile" :class="{ active: pathIs('/profile') }"><svg class="icon"><use href="#i-user"></use></svg><span>My profile</span></a>
    </nav>

    <div class="portal-sidebar-footer">
      <button type="button" @click="logout()"><svg class="icon"><use href="#i-logout"></use></svg><span>Sign out</span></button>
    </div>
  </div>
</aside>
