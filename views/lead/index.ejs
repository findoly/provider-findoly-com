<!DOCTYPE html>
<html lang="en" dir="ltr">
<%- include('../partials/head') %>
<body
  x-data='providerShell({ title: <%- JSON.stringify(title || "") %>, subtitle: <%- JSON.stringify(subtitle || "") %> })'
  x-init="initShell()"
  @wallet-updated.window="refreshProfile()"
  @profile-updated.window="refreshProfile()"
  @portal-page.window="setPage($event.detail)"
  @portal-notify.window="notify($event.detail)"
>
<%- include('../partials/navbar') %>
<div class="page-content workspace-page-shell">
  <%- include('../partials/sidebar') %>
  <div class="content-wrapper">
    <div class="content-inner">
      <div class="page-header portal-page-header workspace-page-header border-bottom">
        <div class="page-header-content d-flex align-items-center">
          <div class="flex-grow-1 min-w-0">
            <h1 class="page-title mb-0 text-truncate" x-text="page.title"><%= title %></h1>
            <div class="page-subtitle mt-1" x-show="page.subtitle" x-text="page.subtitle"><%= subtitle || '' %></div>
          </div>
        </div>
      </div>
      <div class="content workspace-content">
        <div x-show="shellError" x-cloak class="alert alert-danger portal-flash" x-text="shellError"></div>

<div class="provider-lead-page provider-minimal-page workspace-leads-page" x-data="leadList()" x-init="init()">
  <div x-show="error" x-cloak class="alert alert-danger portal-flash" x-text="error"></div>

  <div class="portal-location-required workspace-alert-card" x-show="!loading && !locationReady && filters.status !== 'unlocked'" x-cloak>
    <span class="workspace-alert-icon"><svg class="icon"><use href="#i-location"></use></svg></span>
    <div class="min-w-0"><strong>Your service location is pending in CRM</strong><span>Contact Findoly support before nearby leads can appear.</span></div>
    <a href="/profile#marketplace-location" class="btn btn-light btn-sm">View profile</a>
  </div>

  <section class="provider-conversion-hero" aria-label="Lead workspace summary" x-show="!loading" x-cloak>
    <div class="provider-conversion-hero-copy">
      <span class="provider-eyebrow" x-text="filters.status === 'unlocked' ? 'MY LEADS' : 'LEAD MARKETPLACE'">LEAD MARKETPLACE</span>
      <h1 x-text="filters.status === 'unlocked' ? 'Turn customer leads into business' : 'Find leads worth unlocking'">Find leads worth unlocking</h1>
      <p x-text="filters.status === 'unlocked' ? 'Contact customers, follow up and keep every outcome up to date.' : 'Compare intent, distance, timing and provider activity before spending credits.'"></p>
      <div class="provider-conversion-hero-points" x-show="filters.status !== 'unlocked'">
        <span><svg class="icon"><use href="#i-location"></use></svg>Matched to your service area</span>
        <span><svg class="icon"><use href="#i-lock"></use></svg>Contact details after unlock</span>
      </div>
    </div>
    <div class="provider-conversion-stats">
      <div class="provider-conversion-stat">
        <span>RESULTS</span>
        <strong x-text="pagination.total || 0">0</strong>
        <small x-text="filters.status === 'unlocked' ? 'customer leads' : 'matching opportunities'"></small>
      </div>
      <a class="provider-conversion-stat provider-conversion-credit" href="/plans">
        <span>AVAILABLE CREDITS</span>
        <strong x-text="credits(provider.availableCredits ?? provider.walletCredits)">0 Credits</strong>
        <small>Manage credits</small>
      </a>
      <div class="provider-conversion-stat">
        <span>ACTIVE FILTERS</span>
        <strong x-text="activeFilterCount() || 0">0</strong>
        <small x-text="activeFilterCount() ? 'refining results' : 'showing all matches'"></small>
      </div>
    </div>
  </section>

  <section class="workspace-lead-command">
    <nav class="provider-lead-tabs provider-minimal-tabs workspace-lead-tabs" aria-label="Lead sections">
      <a href="/leads?status=offered" :class="filters.status !== 'unlocked' ? 'active' : ''">
        <span class="provider-tab-icon"><svg class="icon"><use href="#i-search"></use></svg></span>
        <span class="provider-tab-copy"><strong>Marketplace</strong><small>Discover matching opportunities</small></span>
        <span class="provider-tab-count" x-show="filters.status !== 'unlocked' && !loading" x-text="pagination.total || 0"></span>
      </a>
      <a href="/leads?status=unlocked" :class="filters.status === 'unlocked' ? 'active' : ''">
        <span class="provider-tab-icon"><svg class="icon"><use href="#i-briefcase"></use></svg></span>
        <span class="provider-tab-copy"><strong>My leads</strong><small>Customer contacts and outcomes</small></span>
        <span class="provider-tab-count" x-show="filters.status === 'unlocked' && !loading" x-text="pagination.total || 0"></span>
      </a>
    </nav>

    <div class="provider-quick-filters" aria-label="Quick lead filters">
      <template x-if="filters.status !== 'unlocked'">
        <div class="provider-quick-filter-track">
          <button type="button" :class="{ active: quickFilterActive('all') }" @click="applyQuickFilter('all')">All opportunities</button>
          <button type="button" :class="{ active: quickFilterActive('high_intent') }" @click="applyQuickFilter('high_intent')">High intent</button>
          <button type="button" :class="{ active: quickFilterActive('fresh') }" @click="applyQuickFilter('fresh')">Fresh today</button>
          <button type="button" :class="{ active: quickFilterActive('no_unlocks') }" @click="applyQuickFilter('no_unlocks')">No unlocks yet</button>
          <button type="button" :class="{ active: quickFilterActive('open_result') }" @click="applyQuickFilter('open_result')">Not confirmed yet</button>
        </div>
      </template>
      <template x-if="filters.status === 'unlocked'">
        <div class="provider-quick-filter-track">
          <button type="button" :class="{ active: quickFilterActive('all') }" @click="applyQuickFilter('all')">All my leads</button>
          <button type="button" :class="{ active: quickFilterActive('action_required') }" @click="applyQuickFilter('action_required')">Action required</button>
          <button type="button" :class="{ active: quickFilterActive('follow_up') }" @click="applyQuickFilter('follow_up')">Follow up</button>
          <button type="button" :class="{ active: quickFilterActive('confirmed') }" @click="applyQuickFilter('confirmed')">Confirmed</button>
          <button type="button" :class="{ active: quickFilterActive('not_confirmed') }" @click="applyQuickFilter('not_confirmed')">Not confirmed</button>
        </div>
      </template>
    </div>

    <section class="card portal-card provider-minimal-filter workspace-filter-card" aria-label="Lead filters">
      <div class="provider-filter-toolbar workspace-filter-toolbar">
        <label class="provider-filter-search workspace-search-field">
          <svg class="icon"><use href="#i-search"></use></svg>
          <input class="form-control" type="search" x-model="filters.q" @keydown.enter.prevent="apply()" placeholder="Search by requirement, city or lead ID" aria-label="Search leads">
        </label>
        <button class="btn btn-light provider-advanced-toggle workspace-filter-toggle" type="button" @click="filtersOpen = !filtersOpen" :aria-expanded="filtersOpen.toString()">
          <svg class="icon"><use href="#i-filter"></use></svg><span>Filters</span>
          <span class="provider-filter-active-count" x-show="activeFilterCount()" x-cloak x-text="activeFilterCount()"></span>
        </button>
        <button class="btn btn-primary provider-filter-apply" type="button" @click="apply()">Search</button>
      </div>

      <div class="provider-advanced-panel workspace-filter-panel" x-show="filtersOpen" x-cloak>
        <div class="workspace-filter-heading"><div><strong>Advanced filters</strong><span>Refine opportunities by location, intent, activity and price.</span></div><button type="button" @click="filtersOpen = false" aria-label="Close filters">×</button></div>
        <div class="provider-advanced-grid workspace-filter-grid">
          <label class="provider-filter-control"><span>Category</span><select class="form-select" x-model="filters.categorySlug"><option value="">All categories</option><template x-for="category in categories" :key="category"><option :value="category" x-text="humanize(category)"></option></template></select></label>
          <label class="provider-filter-control"><span>City</span><input class="form-control" type="text" x-model="filters.city" placeholder="Any city"></label>
          <label class="provider-filter-control"><span>PIN code</span><input class="form-control" type="text" inputmode="numeric" maxlength="6" x-model="filters.pincode" placeholder="Any PIN code"></label>
          <label class="provider-filter-control"><span>Lead intent</span><select class="form-select" x-model="filters.leadIntent"><option value="">Any intent</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option><option value="not_assessed">Not assessed</option></select></label>

          <template x-if="filters.status !== 'unlocked'"><div class="provider-advanced-subgrid workspace-filter-subgrid">
            <label class="provider-filter-control"><span>Provider confirmation</span><select class="form-select" x-model="filters.confirmation"><option value="">Any confirmation</option><option value="confirmed">Currently confirmed</option><option value="not_confirmed">Not confirmed</option></select></label>
            <label class="provider-filter-control"><span>Providers unlocked</span><select class="form-select" x-model="filters.unlockCount"><option value="">Any number</option><option value="none">None</option><option value="one_two">1–2 providers</option><option value="three_plus">3+ providers</option></select></label>
            <label class="provider-filter-control"><span>Lead age</span><select class="form-select" x-model="filters.age"><option value="">Any age</option><option value="today">Last 24 hours</option><option value="3d">Last 3 days</option><option value="7d">Last 7 days</option><option value="30d">Last 30 days</option></select></label>
          </div></template>

          <template x-if="filters.status === 'unlocked'"><div class="provider-advanced-subgrid workspace-filter-subgrid">
            <label class="provider-filter-control"><span>Sale outcome</span><select class="form-select" x-model="filters.outcome"><option value="">Any outcome</option><option value="pending">Pending</option><option value="confirmed">Confirmed</option><option value="not_confirmed">Not confirmed</option></select></label>
            <label class="provider-filter-control"><span>Activity status</span><select class="form-select" x-model="filters.activityStatus"><option value="">Any activity</option><option value="contacted">Contacted</option><option value="valid">Valid</option><option value="follow_up">Follow up</option><option value="on_hold">On hold</option><option value="rejected">Rejected</option><option value="invalid">Invalid</option><option value="not_interested">Not interested</option><option value="other">Other</option></select></label>
            <label class="provider-filter-control provider-check-control"><span>Pending follow-up</span><span class="provider-checkbox-row"><input type="checkbox" x-model="filters.overdue"> Overdue 7+ days</span></label>
          </div></template>

          <label class="provider-filter-control"><span x-text="filters.status === 'unlocked' ? 'Unlocked from' : 'Published from'"></span><input class="form-control" type="date" x-model="filters.startDate"></label>
          <label class="provider-filter-control"><span x-text="filters.status === 'unlocked' ? 'Unlocked to' : 'Published to'"></span><input class="form-control" type="date" x-model="filters.endDate"></label>
          <label class="provider-filter-control"><span>Minimum credits</span><input class="form-control" type="number" min="0" step="1" x-model="filters.minCredits" placeholder="No minimum"></label>
          <label class="provider-filter-control"><span>Maximum credits</span><input class="form-control" type="number" min="0" step="1" x-model="filters.maxCredits" placeholder="No maximum"></label>
          <label class="provider-filter-control"><span>Sort by</span><select class="form-select" x-model="filters.sort"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="nearest">Nearest first</option><option value="cost_low">Lowest credits</option><option value="cost_high">Highest credits</option></select></label>
        </div>
        <div class="provider-filter-actions workspace-filter-actions"><button class="btn btn-light" type="button" @click="clear()" :disabled="!hasActiveFilters()">Clear all</button><button class="btn btn-primary" type="button" @click="apply(); filtersOpen = false">Show results</button></div>
      </div>
    </section>
  </section>

  <div class="provider-active-filters workspace-active-filters" x-show="activeChips().length" x-cloak><template x-for="chip in activeChips()" :key="chip.key"><button type="button" @click="removeFilter(chip.key)"><span x-text="chip.label"></span><b aria-hidden="true">×</b></button></template><button class="is-clear" type="button" @click="clear()">Clear all</button></div>

  <div class="provider-minimal-results workspace-results-bar" x-show="!loading" x-cloak><div><strong><span x-text="pagination.total || 0"></span> <span x-text="filters.status === 'unlocked' ? (Number(pagination.total || 0) === 1 ? 'lead' : 'leads') : (Number(pagination.total || 0) === 1 ? 'opportunity' : 'opportunities')"></span></strong><span x-text="filters.status === 'unlocked' ? 'Your unlocked customer leads' : 'Matched to your category and service location'"></span></div><span class="workspace-results-sort" x-text="humanize(filters.sort)"></span></div>

  <main class="provider-minimal-list workspace-lead-grid" :class="loading ? 'portal-loading' : ''" aria-live="polite">
    <template x-for="lead in rows" :key="lead.leadDistributionId">
      <article class="provider-minimal-card provider-opportunity-card workspace-lead-card provider-conversion-card" :class="[lead.contactUnlocked ? 'is-unlocked' : 'is-marketplace', lead.leadIntent === 'high' ? 'is-high-intent' : '', (!lead.contactUnlocked && Number(lead.unlockedCount || 0) <= 1 && lead.leadIntent === 'high') ? 'is-recommended' : '']">
        <div class="provider-conversion-card-main">
          <div class="provider-conversion-card-top">
            <div class="provider-conversion-card-labels">
              <span class="provider-minimal-category" x-text="lead.category || humanize(lead.categorySlug) || 'Service category'"></span>
              <span class="provider-recommended-badge" x-show="!lead.contactUnlocked && Number(lead.unlockedCount || 0) <= 1 && lead.leadIntent === 'high'" x-cloak>Recommended</span>
            </div>
            <span class="provider-intent-badge" :class="'is-' + lead.leadIntent" x-text="intentLabel(lead.leadIntent)"></span>
          </div>

          <h2 class="provider-conversion-title"><a :href="'/leads/' + lead.leadDistributionId" x-text="lead.leadTitle || lead.serviceType || 'Service requirement'"></a></h2>
          <p class="provider-card-summary provider-conversion-summary" x-show="leadSummary(lead)" x-text="leadSummary(lead)"></p>

          <div class="provider-conversion-location">
            <svg class="icon"><use href="#i-location"></use></svg>
            <span x-text="locationLabel(lead)"></span>
            <b x-show="!lead.contactUnlocked" x-text="distanceLabel(lead)"></b>
          </div>

          <div class="provider-conversion-highlights">
            <div>
              <span>WHEN</span>
              <strong x-text="preferredLabel(lead)"></strong>
            </div>
            <div x-show="!lead.contactUnlocked">
              <span>POSTED</span>
              <strong x-text="relativeAge(lead.marketplacePublishedAt || lead.distributedAt || lead.createdAt)"></strong>
            </div>
            <div x-show="lead.contactUnlocked">
              <span>CUSTOMER</span>
              <strong x-text="lead.customerName || 'Contact available'"></strong>
            </div>
          </div>

          <div class="provider-conversion-market-signals" x-show="!lead.contactUnlocked">
            <div>
              <svg class="icon"><use href="#i-unlock"></use></svg>
              <span><b x-text="lead.unlockedCount || 0"></b> <span x-text="Number(lead.unlockedCount || 0) === 1 ? 'provider has unlocked' : 'providers have unlocked'"></span></span>
            </div>
            <div :class="lead.currentlyConfirmed ? 'is-confirmed' : ''">
              <svg class="icon"><use href="#i-check"></use></svg>
              <span x-text="lead.currentlyConfirmed ? `${lead.providerConfirmedCount || 1} provider confirmed` : 'No provider confirmed yet'"></span>
            </div>
          </div>

          <div class="provider-unlock-preview" x-show="!lead.contactUnlocked">
            <span class="provider-unlock-preview-icon"><svg class="icon"><use href="#i-lock"></use></svg></span>
            <div><strong>Unlock customer contact</strong><small>Get the phone number and full lead details instantly.</small></div>
          </div>

          <div class="provider-unlocked-status" x-show="lead.contactUnlocked">
            <span class="provider-outcome-chip" :class="statusClass(lead)" x-text="outcomeLabel(lead)"></span>
            <span x-show="lead.providerLeadStatus"><svg class="icon"><use href="#i-trend"></use></svg><span x-text="humanize(lead.providerLeadStatus)"></span></span>
            <span x-show="isOverdue(lead)" class="is-overdue"><svg class="icon"><use href="#i-clock"></use></svg>Outcome overdue</span>
          </div>
        </div>

        <div class="provider-conversion-card-footer">
          <template x-if="!lead.contactUnlocked">
            <div class="provider-conversion-unlock-row">
              <div class="provider-conversion-price">
                <span>UNLOCK COST</span>
                <strong x-text="credits(lead.leadCostCredits)"></strong>
              </div>
              <a class="btn btn-primary provider-unlock-cta" :href="'/leads/' + lead.leadDistributionId">
                <span><b>View &amp; unlock lead</b><small>Customer contact inside</small></span>
                <svg class="icon"><use href="#i-arrow"></use></svg>
              </a>
            </div>
          </template>
          <template x-if="lead.contactUnlocked">
            <div class="provider-conversion-unlocked-row">
              <div class="provider-conversion-price"><span>UNLOCKED ON</span><strong x-text="formatDateOnly(lead.unlockedAt)"></strong></div>
              <div class="provider-card-actions provider-conversion-actions">
                <a x-show="lead.customerMobile" class="btn btn-light" :href="phoneHref(lead.customerMobile)"><svg class="icon"><use href="#i-phone"></use></svg><span>Call</span></a>
                <a x-show="lead.customerMobile" class="btn btn-light provider-card-whatsapp" :href="whatsappHref(lead.customerMobile)" target="_blank" rel="noopener"><span aria-hidden="true">↗</span><span>WhatsApp</span></a>
                <a class="btn btn-primary" :href="'/leads/' + lead.leadDistributionId"><span x-text="lead.providerSaleOutcome ? 'Open lead' : 'Update outcome'"></span><svg class="icon"><use href="#i-arrow"></use></svg></a>
              </div>
            </div>
          </template>
        </div>
      </article>
    </template>

    <section class="card portal-card provider-minimal-empty workspace-empty-state" x-show="loading || (!loading && !rows.length)"><div class="card-body text-center"><div x-show="loading" class="text-muted">Loading leads…</div><div x-show="!loading && !rows.length"><div class="portal-empty-icon"><svg class="icon"><use href="#i-lead"></use></svg></div><strong x-text="filters.status === 'unlocked' ? 'No unlocked leads found' : (!locationReady ? 'Service location required' : 'No leads match your filters')"></strong><span x-text="hasActiveFilters() ? 'Clear or change your filters to see more leads.' : (filters.status === 'unlocked' ? 'Successfully unlocked leads will appear here.' : 'New matching leads will appear here automatically.')"></span><button x-show="hasActiveFilters()" type="button" class="btn btn-light btn-sm" @click="clear()">Clear filters</button></div></div></section>
  </main>

  <div class="portal-card portal-pagination provider-minimal-pagination workspace-pagination" x-show="pagination.pages > 1" x-cloak><span><span x-text="pagination.page"></span> of <span x-text="pagination.pages"></span></span><div><button class="btn btn-light btn-sm" :disabled="pagination.page <= 1 || loading" @click="go(pagination.page - 1)">Previous</button><button class="btn btn-light btn-sm" :disabled="pagination.page >= pagination.pages || loading" @click="go(pagination.page + 1)">Next</button></div></div>
</div>

<script nonce="<%= cspNonce %>">
  function leadList() {
    const query = new URLSearchParams(location.search);
    const initialStatus = query.get('status') === 'unlocked' ? 'unlocked' : 'offered';
    const queryValue = (key, fallback = '') => query.get(key) ?? fallback;
    return {
      rows: [], categories: [], locationReady: true, loading: true, error: '', filtersOpen: false,
      pagination: { page: Number(queryValue('page', 1)), pages: 1, total: 0 },
      filters: {
        q: queryValue('q'), status: initialStatus, categorySlug: queryValue('categorySlug'), city: queryValue('city'),
        pincode: queryValue('pincode'), leadIntent: queryValue('leadIntent'), confirmation: queryValue('confirmation'),
        unlockCount: queryValue('unlockCount'), age: queryValue('age'), outcome: queryValue('outcome'),
        activityStatus: queryValue('activityStatus'), overdue: queryValue('overdue') === 'true', startDate: queryValue('startDate'),
        endDate: queryValue('endDate'), minCredits: queryValue('minCredits'), maxCredits: queryValue('maxCredits'),
        sort: queryValue('sort', 'newest'), limit: Number(queryValue('limit', 20))
      },
      init() { this.updatePageTitle(); this.load(); },
      updatePageTitle() {
        const unlocked = this.filters.status === 'unlocked';
        this.$dispatch('portal-page', { title: unlocked ? 'Unlocked leads' : 'Lead marketplace', subtitle: unlocked ? 'Customer contacts and outcome updates' : 'Nearby category-matched opportunities' });
      },
      params() {
        const params = new URLSearchParams();
        Object.entries(this.filters).forEach(([key, value]) => {
          if (value !== '' && value !== null && value !== undefined && value !== false) params.set(key, value === true ? 'true' : value);
        });
        params.set('page', this.pagination.page);
        return params;
      },
      filterKeys() {
        const common = ['q','categorySlug','city','pincode','leadIntent','startDate','endDate','minCredits','maxCredits'];
        return this.filters.status === 'unlocked' ? [...common,'outcome','activityStatus','overdue'] : [...common,'confirmation','unlockCount','age'];
      },
      hasActiveFilters() { return this.filterKeys().some((key) => Boolean(this.filters[key])); },
      activeFilterCount() { return this.filterKeys().filter((key) => Boolean(this.filters[key])).length; },
      chipText(key, value) {
        const labels = { q: `Search: ${value}`, categorySlug: humanize(value), city: value, pincode: `PIN ${value}`, leadIntent: `${humanize(value)} intent`, confirmation: value === 'confirmed' ? 'Currently confirmed' : 'Not confirmed', unlockCount: { none: 'No unlocks', one_two: '1–2 unlocks', three_plus: '3+ unlocks' }[value], age: { today: 'Last 24 hours', '3d': 'Last 3 days', '7d': 'Last 7 days', '30d': 'Last 30 days' }[value], outcome: `Outcome: ${humanize(value)}`, activityStatus: `Activity: ${humanize(value)}`, overdue: 'Overdue 7+ days', startDate: `From ${value}`, endDate: `To ${value}`, minCredits: `Min ${value} credits`, maxCredits: `Max ${value} credits` };
        return labels[key] || humanize(value);
      },
      activeChips() { return this.filterKeys().filter((key) => Boolean(this.filters[key])).map((key) => ({ key, label: this.chipText(key, this.filters[key]) })); },
      removeFilter(key) { this.filters[key] = key === 'overdue' ? false : ''; this.apply(); },
      intentLabel(value) { return value === 'not_assessed' ? 'Not assessed' : `${humanize(value)} intent`; },
      locationLabel(lead) {
        return [lead.city, lead.state, lead.pincode].filter(Boolean).join(', ') || 'Location available in lead details';
      },
      distanceLabel(lead) {
        const value = Number(lead.providerDistanceKm);
        if (!Number.isFinite(value)) return 'Nearby matched area';
        return value < 1 ? `${Math.max(1, Math.round(value * 1000))} m away` : `${value.toFixed(value < 10 ? 1 : 0)} km away`;
      },
      preferredLabel(lead) {
        const date = lead.preferredDate ? formatDateOnly(lead.preferredDate) : '';
        const slot = lead.preferredSlot ? humanize(lead.preferredSlot) : '';
        return [date, slot].filter(Boolean).join(' · ') || 'Flexible timing';
      },
      relativeAge(value) {
        const time = new Date(value || '').getTime();
        if (!Number.isFinite(time)) return 'Recently added';
        const minutes = Math.max(0, Math.floor((Date.now() - time) / 60000));
        if (minutes < 2) return 'Just now';
        if (minutes < 60) return `${minutes} minutes ago`;
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return `${hours} hour${hours === 1 ? '' : 's'} ago`;
        const days = Math.floor(hours / 24);
        return `${days} day${days === 1 ? '' : 's'} ago`;
      },
      leadSummary(lead) {
        const details = lead.additionalDetails || {};
        const keys = ['requirement', 'description', 'summary', 'details', 'serviceRequirement', 'message', 'notes', 'note'];
        let value = '';
        for (const key of keys) {
          if (typeof details[key] === 'string' && details[key].trim()) { value = details[key].trim(); break; }
        }
        if (!value && typeof lead.serviceType === 'string' && lead.serviceType.trim() && lead.serviceType !== lead.leadTitle) {
          value = lead.serviceType.trim();
        }
        value = String(value || '').replace(/\s+/g, ' ').trim();
        return value.length > 180 ? `${value.slice(0, 177)}…` : value;
      },
      quickFilterActive(name) {
        if (name === 'all') return !['leadIntent','age','unlockCount','confirmation','outcome','activityStatus','overdue'].some((key) => Boolean(this.filters[key]));
        if (name === 'high_intent') return this.filters.leadIntent === 'high' && !this.filters.age && !this.filters.unlockCount && !this.filters.confirmation;
        if (name === 'fresh') return this.filters.age === 'today' && !this.filters.leadIntent && !this.filters.unlockCount && !this.filters.confirmation;
        if (name === 'no_unlocks') return this.filters.unlockCount === 'none';
        if (name === 'open_result') return this.filters.confirmation === 'not_confirmed';
        if (name === 'action_required') return this.filters.outcome === 'pending' && !this.filters.activityStatus;
        if (name === 'follow_up') return this.filters.activityStatus === 'follow_up' && !this.filters.outcome;
        if (name === 'confirmed') return this.filters.outcome === 'confirmed';
        if (name === 'not_confirmed') return this.filters.outcome === 'not_confirmed';
        return false;
      },
      applyQuickFilter(name) {
        ['leadIntent','age','unlockCount','confirmation','outcome','activityStatus'].forEach((key) => { this.filters[key] = ''; });
        this.filters.overdue = false;
        if (name === 'high_intent') this.filters.leadIntent = 'high';
        if (name === 'fresh') this.filters.age = 'today';
        if (name === 'no_unlocks') this.filters.unlockCount = 'none';
        if (name === 'open_result') this.filters.confirmation = 'not_confirmed';
        if (name === 'action_required') this.filters.outcome = 'pending';
        if (name === 'follow_up') this.filters.activityStatus = 'follow_up';
        if (name === 'confirmed') this.filters.outcome = 'confirmed';
        if (name === 'not_confirmed') this.filters.outcome = 'not_confirmed';
        this.apply();
      },
      phoneHref(value) { return `tel:${String(value || '').replace(/[^+\d]/g, '')}`; },
      whatsappHref(value) { return `https://wa.me/91${String(value || '').replace(/\D/g, '').slice(-10)}`; },
      statusClass(lead) {
        if (lead.providerSaleOutcome === 'confirmed') return 'is-success';
        if (lead.providerSaleOutcome === 'not_confirmed') return 'is-neutral';
        if (['rejected','invalid'].includes(lead.providerLeadStatus)) return 'is-danger';
        if (lead.providerLeadStatus === 'on_hold') return 'is-warning';
        return 'is-pending';
      },
      outcomeLabel(lead) { return lead.providerSaleOutcome ? humanize(lead.providerSaleOutcome) : 'Outcome pending'; },
      isOverdue(lead) { return !lead.providerSaleOutcome && lead.unlockedAt && (Date.now() - new Date(lead.unlockedAt).getTime()) >= 7 * 86400000; },
      async load() {
        this.loading = true; this.error = '';
        try {
          const body = await apiFetch('/api/lead?' + this.params().toString());
          this.rows = body.data || []; this.categories = body.filters?.categories || []; this.locationReady = body.filters?.locationReady !== false;
          this.pagination = body.pagination || { page: 1, pages: 1, total: this.rows.length };
        } catch (error) { this.error = error.message; } finally { this.loading = false; }
      },
      apply() { this.pagination.page = 1; history.replaceState({}, '', '/leads?' + this.params().toString()); this.load(); },
      clear() {
        ['q','categorySlug','city','pincode','leadIntent','confirmation','unlockCount','age','outcome','activityStatus','startDate','endDate','minCredits','maxCredits'].forEach((key) => { this.filters[key] = ''; });
        this.filters.overdue = false; this.filters.sort = 'newest'; this.pagination.page = 1; this.filtersOpen = false;
        history.replaceState({}, '', '/leads?' + this.params().toString()); this.load();
      },
      go(page) { this.pagination.page = page; history.replaceState({}, '', '/leads?' + this.params().toString()); this.load(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
    };
  }
</script>
      </div>
      <%- include('../partials/footer') %>
    </div>
  </div>
</div>
<div class="portal-sidebar-overlay" data-portal-menu-overlay aria-hidden="true"></div>
<%- include('../partials/scripts') %>
</body>
</html>
