<!DOCTYPE html>
<html lang="en" dir="ltr">
<%- include('../partials/head') %>
<body
  x-data='providerShell({ title: <%- JSON.stringify(title || "") %>, subtitle: <%- JSON.stringify(subtitle || "") %> })'
  x-init="initShell()"
  @wallet-updated.window="refreshProfile()"
  @profile-updated.window="refreshProfile()"
  @portal-page.window="setPage($event.detail)"
  @portal-notify.window="notify($event.detail)"
>
<%- include('../partials/navbar') %>
<div class="page-content">
  <%- include('../partials/sidebar') %>
  <div class="content-wrapper">
    <div class="content-inner">
      <div class="page-header portal-page-header border-bottom">
        <div class="page-header-content d-flex align-items-center">
          <div class="flex-grow-1 min-w-0">
            <h1 class="page-title mb-0 text-truncate" x-text="page.title"><%= title %></h1>
            <div class="page-subtitle mt-1" x-show="page.subtitle" x-text="page.subtitle"><%= subtitle || '' %></div>
          </div>
        </div>
      </div>
      <div class="content">
        <div x-show="shellError" x-cloak class="alert alert-danger portal-flash" x-text="shellError"></div>

<div class="provider-lead-page" x-data="leadList()" x-init="init()">
  <div x-show="error" x-cloak class="alert alert-danger portal-flash" x-text="error"></div>

  <div class="portal-location-required provider-location-alert mb-3" x-show="!loading && !locationReady && filters.status !== 'unlocked'" x-cloak>
    <div class="min-w-0">
      <strong>Add your service PIN code to view nearby leads</strong>
      <span>Findoly releases category-matched leads to the closest eligible providers first.</span>
    </div>
    <a href="/profile#marketplace-location" class="btn btn-primary btn-sm">Add PIN code</a>
  </div>

  <nav class="provider-lead-tabs" aria-label="Lead sections">
    <a href="/leads?status=offered" :class="filters.status !== 'unlocked' ? 'active' : ''">
      <span class="provider-tab-icon"><svg class="icon"><use href="#i-lead"></use></svg></span>
      <span class="provider-tab-copy">
        <strong>Lead marketplace</strong>
        <small>Nearby opportunities</small>
      </span>
      <span class="provider-tab-count" x-show="filters.status !== 'unlocked' && !loading" x-text="pagination.total || 0"></span>
    </a>
    <a href="/leads?status=unlocked" :class="filters.status === 'unlocked' ? 'active' : ''">
      <span class="provider-tab-icon"><svg class="icon"><use href="#i-unlock"></use></svg></span>
      <span class="provider-tab-copy">
        <strong>Unlocked leads</strong>
        <small>Your customer contacts</small>
      </span>
      <span class="provider-tab-count" x-show="filters.status === 'unlocked' && !loading" x-text="pagination.total || 0"></span>
    </a>
  </nav>

  <section class="card portal-card provider-filter-card" aria-label="Lead filters">
    <div class="provider-filter-grid">
      <div class="provider-filter-search">
        <svg class="icon"><use href="#i-search"></use></svg>
        <input
          class="form-control"
          type="search"
          x-model="filters.q"
          @keydown.enter.prevent="apply()"
          placeholder="Search requirement, category, city or lead ID"
          aria-label="Search leads"
        >
      </div>
      <div class="provider-filter-field">
        <label class="visually-hidden" for="provider-lead-category">Category</label>
        <select id="provider-lead-category" class="form-select" x-model="filters.categorySlug">
          <option value="">All categories</option>
          <template x-for="category in categories" :key="category">
            <option :value="category" x-text="humanize(category)"></option>
          </template>
        </select>
      </div>
      <div class="provider-filter-field">
        <label class="visually-hidden" for="provider-lead-city">City</label>
        <input id="provider-lead-city" class="form-control" type="text" x-model="filters.city" @keydown.enter.prevent="apply()" placeholder="Any city">
      </div>
      <button class="btn btn-primary provider-filter-apply" type="button" @click="apply()">Apply</button>
      <button class="btn btn-light provider-filter-clear" type="button" x-show="hasActiveFilters()" x-cloak @click="clear()">Clear</button>
    </div>
  </section>

  <div class="provider-feed-layout">
    <main class="provider-lead-feed" :class="loading ? 'portal-loading' : ''" aria-live="polite">
      <template x-for="lead in rows" :key="lead.leadDistributionId">
        <article class="provider-feed-card" :class="lead.contactUnlocked ? 'is-unlocked' : 'is-marketplace'">
          <header class="provider-feed-header">
            <span class="provider-feed-avatar" aria-hidden="true">
              <svg class="icon"><use :href="lead.contactUnlocked ? '#i-unlock' : '#i-lead'"></use></svg>
            </span>
            <div class="provider-feed-identity min-w-0">
              <div class="provider-feed-category" x-text="lead.category || humanize(lead.categorySlug) || 'Service category'"></div>
              <h2><a :href="'/leads/' + lead.leadDistributionId" x-text="lead.leadTitle || lead.serviceType || 'Service requirement'"></a></h2>
              <div class="provider-feed-context">
                <span x-text="[lead.city, lead.state].filter(Boolean).join(', ') || 'Location available in lead details'"></span>
                <span aria-hidden="true">•</span>
                <span x-text="relativeAge(lead.distributedAt || lead.createdAt)"></span>
                <template x-if="lead.providerDistanceKm !== null && lead.providerDistanceKm !== undefined">
                  <span class="provider-feed-distance"><span aria-hidden="true">•</span> <span x-text="distanceLabel(lead.providerDistanceKm) + ' away'"></span></span>
                </template>
              </div>
            </div>
            <span class="provider-intent-badge" :class="'is-' + lead.leadIntent" x-text="intentLabel(lead.leadIntent)"></span>
          </header>

          <div class="provider-feed-body">
            <p class="provider-feed-summary" x-text="leadSummary(lead)"></p>

            <div class="provider-transparency-row">
              <div class="provider-transparency-item">
                <span class="provider-transparency-icon"><svg class="icon"><use href="#i-unlock"></use></svg></span>
                <div>
                  <strong x-text="`${lead.unlockedCount || 0} provider${Number(lead.unlockedCount || 0) === 1 ? '' : 's'} unlocked`"></strong>
                  <small>Current provider interest</small>
                </div>
              </div>
              <div class="provider-transparency-item" :class="lead.currentlyConfirmed ? 'is-confirmed' : ''">
                <span class="provider-transparency-icon"><svg class="icon"><use href="#i-check"></use></svg></span>
                <div>
                  <strong x-text="lead.currentlyConfirmed ? `Confirmed by ${lead.providerConfirmedCount || 1} provider${Number(lead.providerConfirmedCount || 1) === 1 ? '' : 's'}` : 'Not confirmed yet'"></strong>
                  <small>Current outcome signal</small>
                </div>
              </div>
            </div>

            <div class="provider-feed-facts">
              <div>
                <span>Preferred timing</span>
                <strong x-text="preferredLabel(lead)"></strong>
              </div>
              <div>
                <span x-text="lead.contactUnlocked ? 'Unlocked on' : 'Unlock cost'"></span>
                <strong x-text="lead.contactUnlocked ? formatDate(lead.unlockedAt) : credits(lead.leadCostCredits)"></strong>
              </div>
            </div>
          </div>

          <footer class="provider-feed-footer">
            <div class="provider-feed-reference min-w-0">
              <span class="portal-id" x-text="lead.enquiryId || lead.leadDistributionId"></span>
              <span class="badge provider-feed-status" :class="statusClass(lead)" x-text="lead.providerSaleOutcome ? humanize(lead.providerSaleOutcome) : (lead.contactUnlocked ? 'Outcome pending' : 'Available')"></span>
            </div>
            <a class="btn btn-primary" :href="'/leads/' + lead.leadDistributionId" x-text="lead.contactUnlocked ? 'Open unlocked lead' : 'View opportunity'"></a>
          </footer>
        </article>
      </template>

      <section class="card portal-card provider-feed-empty" x-show="loading || (!loading && !rows.length)">
        <div class="card-body text-center">
          <div x-show="loading" class="text-muted">Loading leads…</div>
          <div x-show="!loading && !rows.length">
            <div class="portal-empty-icon"><svg class="icon"><use href="#i-lead"></use></svg></div>
            <h3 x-text="filters.status === 'unlocked' ? 'No unlocked leads yet' : (!locationReady ? 'Service PIN code required' : 'No nearby leads right now')"></h3>
            <p x-text="filters.status === 'unlocked' ? 'Leads appear here immediately after a successful unlock.' : (!locationReady ? 'Add your primary PIN code in My Profile to start receiving nearby opportunities.' : 'New category-matched opportunities will appear as the marketplace expands.')"></p>
          </div>
        </div>
      </section>

      <div class="portal-card portal-pagination provider-feed-pagination" x-show="pagination.pages > 1">
        <div class="text-muted fs-sm" x-text="`${pagination.total || 0} leads`"></div>
        <div class="d-flex align-items-center gap-2 ms-auto">
          <button class="btn btn-light btn-sm" :disabled="pagination.page <= 1 || loading" @click="go(pagination.page - 1)">Previous</button>
          <span class="fs-sm" x-text="`${pagination.page} of ${pagination.pages}`"></span>
          <button class="btn btn-light btn-sm" :disabled="pagination.page >= pagination.pages || loading" @click="go(pagination.page + 1)">Next</button>
        </div>
      </div>
    </main>

    <aside class="provider-feed-aside" aria-label="Marketplace information">
      <section class="card portal-card provider-aside-card">
        <div class="provider-aside-heading">
          <span class="provider-aside-icon"><svg class="icon"><use href="#i-check"></use></svg></span>
          <div>
            <h3 x-text="filters.status === 'unlocked' ? 'Keep outcomes current' : 'Understand each lead'"></h3>
            <p x-text="filters.status === 'unlocked' ? 'Accurate outcomes keep CRM conversion and customer follow-up in sync.' : 'Use these signals before deciding whether to unlock.'"></p>
          </div>
        </div>
        <ul class="provider-aside-list" x-show="filters.status !== 'unlocked'">
          <li><strong>Lead Intent</strong><span>Assessed by the Findoly CRM team.</span></li>
          <li><strong>Providers unlocked</strong><span>Shows current interest without exposing provider identities.</span></li>
          <li><strong>Confirmed signal</strong><span>Shows whether any provider currently reports a confirmed sale.</span></li>
        </ul>
        <ul class="provider-aside-list" x-show="filters.status === 'unlocked'">
          <li><strong>Confirmed / Not Confirmed</strong><span>Required for each unlocked lead.</span></li>
          <li><strong>Activity status</strong><span>Optional and useful for follow-up history.</span></li>
          <li><strong>Seven-day reminder</strong><span>Appears until an overdue outcome is updated.</span></li>
        </ul>
      </section>

      <section class="card portal-card provider-aside-card provider-aside-location" x-show="filters.status !== 'unlocked'">
        <div class="provider-aside-heading">
          <span class="provider-aside-icon"><svg class="icon"><use href="#i-location"></use></svg></span>
          <div>
            <h3>Nearby lead matching</h3>
            <p>Lead visibility expands by distance over time while category matching remains active.</p>
          </div>
        </div>
        <a href="/profile#marketplace-location" class="provider-aside-link">Review service PIN code</a>
      </section>
    </aside>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  function leadList() {
    const query = new URLSearchParams(location.search);
    const initialStatus = query.get('status') === 'unlocked' ? 'unlocked' : 'offered';
    return {
      rows: [],
      categories: [],
      locationReady: true,
      loading: true,
      error: '',
      pagination: { page: Number(query.get('page') || 1), pages: 1, total: 0 },
      filters: {
        q: query.get('q') || '',
        status: initialStatus,
        categorySlug: query.get('categorySlug') || '',
        city: query.get('city') || '',
        limit: Number(query.get('limit') || 20)
      },
      init() {
        this.updatePageTitle();
        this.load();
      },
      updatePageTitle() {
        const unlocked = this.filters.status === 'unlocked';
        this.$dispatch('portal-page', {
          title: unlocked ? 'Unlocked leads' : 'Lead marketplace',
          subtitle: unlocked ? 'Customer contacts you have purchased' : 'Nearby category-matched opportunities from Findoly CRM'
        });
      },
      params() {
        const params = new URLSearchParams();
        Object.entries(this.filters).forEach(([key, value]) => {
          if (value !== '' && value !== null && value !== undefined) params.set(key, value);
        });
        params.set('page', this.pagination.page);
        return params;
      },
      hasActiveFilters() {
        return Boolean(String(this.filters.q || '').trim() || this.filters.categorySlug || String(this.filters.city || '').trim());
      },
      statusClass(lead) {
        if (lead.providerSaleOutcome === 'confirmed') return 'bg-success text-white';
        if (lead.providerSaleOutcome === 'not_confirmed') return 'bg-secondary text-white';
        if (['rejected', 'invalid'].includes(lead.providerLeadStatus)) return 'bg-danger text-white';
        if (lead.providerLeadStatus === 'on_hold') return 'bg-warning text-dark';
        return lead.contactUnlocked ? 'bg-primary-subtle text-primary' : 'bg-light text-body border';
      },
      intentLabel(value) {
        if (value === 'not_assessed') return 'Intent not assessed';
        return `${humanize(value)} intent`;
      },
      relativeAge(value) {
        const time = new Date(value).getTime();
        if (!Number.isFinite(time)) return 'Recently added';
        const minutes = Math.max(0, Math.floor((Date.now() - time) / 60000));
        if (minutes < 1) return 'Just now';
        if (minutes < 60) return `${minutes} min ago`;
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return `${hours} hr${hours === 1 ? '' : 's'} ago`;
        const days = Math.floor(hours / 24);
        return `${days} day${days === 1 ? '' : 's'} ago`;
      },
      distanceLabel(value) {
        const distance = Number(value);
        if (!Number.isFinite(distance)) return 'Distance pending';
        return distance < 1 ? `${Math.max(1, Math.round(distance * 1000))} m` : `${distance.toFixed(distance < 10 ? 1 : 0)} km`;
      },
      preferredLabel(lead) {
        const date = lead.preferredDate ? formatDateOnly(lead.preferredDate) : 'Flexible date';
        return lead.preferredSlot ? `${date} · ${lead.preferredSlot}` : date;
      },
      leadSummary(lead) {
        const details = lead.additionalDetails || {};
        const parts = Object.entries(details)
          .filter(([, value]) => value !== '' && value !== null && value !== undefined && ['string', 'number', 'boolean'].includes(typeof value))
          .slice(0, 3)
          .map(([key, value]) => `${humanize(key)}: ${typeof value === 'boolean' ? (value ? 'Yes' : 'No') : value}`);
        return parts.length ? parts.join(' · ') : 'Review the requirement, location and preferred timing before taking action.';
      },
      async load() {
        this.loading = true;
        this.error = '';
        try {
          const body = await apiFetch('/api/lead?' + this.params().toString());
          this.rows = body.data || [];
          this.categories = body.filters?.categories || [];
          this.locationReady = body.filters?.locationReady !== false;
          this.pagination = body.pagination || { page: 1, pages: 1, total: this.rows.length };
        } catch (error) {
          this.error = error.message;
        } finally {
          this.loading = false;
        }
      },
      apply() {
        this.pagination.page = 1;
        history.replaceState({}, '', '/leads?' + this.params().toString());
        this.load();
      },
      clear() {
        this.filters.q = '';
        this.filters.categorySlug = '';
        this.filters.city = '';
        this.pagination.page = 1;
        history.replaceState({}, '', '/leads?' + this.params().toString());
        this.load();
      },
      go(page) {
        this.pagination.page = page;
        history.replaceState({}, '', '/leads?' + this.params().toString());
        this.load();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    };
  }
</script>

      </div>
      <%- include('../partials/footer') %>
    </div>
  </div>
</div>
<div class="portal-sidebar-overlay" @click="closeSidebar()"></div>
<%- include('../partials/scripts') %>
</body>
</html>
