<!DOCTYPE html>
<html lang="en" dir="ltr">
<%- include('../partials/head') %>
<body
  x-data='providerShell({ title: <%- JSON.stringify(title || "") %>, subtitle: <%- JSON.stringify(subtitle || "") %> })'
  x-init="initShell()"
  @wallet-updated.window="refreshProfile()"
  @profile-updated.window="refreshProfile()"
  @portal-page.window="setPage($event.detail)"
  @portal-notify.window="notify($event.detail)"
>
<%- include('../partials/navbar') %>
<div class="page-content">
  <%- include('../partials/sidebar') %>
  <div class="content-wrapper">
    <div class="content-inner">
      <div class="page-header portal-page-header border-bottom">
        <div class="page-header-content d-flex align-items-center">
          <div class="flex-grow-1 min-w-0">
            <h1 class="page-title mb-0 text-truncate" x-text="page.title"><%= title %></h1>
            <div class="page-subtitle mt-1" x-show="page.subtitle" x-text="page.subtitle"><%= subtitle || '' %></div>
          </div>
        </div>
      </div>
      <div class="content">
        <div x-show="shellError" x-cloak class="alert alert-danger portal-flash" x-text="shellError"></div>

<div x-data="leadList()" x-init="init()">
  <div x-show="error" x-cloak class="alert alert-danger portal-flash" x-text="error"></div>

  <div class="portal-location-required mb-4" x-show="!loading && !locationReady && filters.status !== 'unlocked'" x-cloak>
    <div>
      <strong>Add your service PIN code to view nearby leads</strong>
      <span>Findoly releases category-matched leads by distance, starting with the closest providers.</span>
    </div>
    <a href="/profile" class="btn btn-primary btn-sm">Add PIN code</a>
  </div>

  <div class="portal-lead-tabs mb-4">
    <a href="/leads?status=offered" :class="filters.status !== 'unlocked' ? 'active' : ''">
      <svg class="icon"><use href="#i-lead"></use></svg>
      <span><strong>Marketplace</strong><small>Nearby opportunities</small></span>
    </a>
    <a href="/leads?status=unlocked" :class="filters.status === 'unlocked' ? 'active' : ''">
      <svg class="icon"><use href="#i-unlock"></use></svg>
      <span><strong>Unlocked leads</strong><small>Your purchased contacts</small></span>
    </a>
  </div>

  <div class="card portal-card portal-filter-card mb-4">
    <div class="card-body portal-lead-filter-bar">
      <div class="portal-filter-search">
        <svg class="icon"><use href="#i-search"></use></svg>
        <input class="form-control" type="search" x-model="filters.q" @keydown.enter.prevent="apply()" placeholder="Search requirement, category, city or lead ID">
      </div>
      <select class="form-select" x-model="filters.categorySlug">
        <option value="">All categories</option>
        <template x-for="category in categories" :key="category">
          <option :value="category" x-text="humanize(category)"></option>
        </template>
      </select>
      <input class="form-control" type="text" x-model="filters.city" @keydown.enter.prevent="apply()" placeholder="City">
      <button class="btn btn-primary" type="button" @click="apply()">Apply</button>
      <button class="btn btn-light" type="button" x-show="hasActiveFilters()" x-cloak @click="clear()">Clear</button>
    </div>
  </div>

  <div class="portal-lead-grid" :class="loading ? 'portal-loading' : ''">
    <template x-for="lead in rows" :key="lead.leadDistributionId">
      <article class="portal-opportunity-card" :class="lead.contactUnlocked ? 'is-unlocked' : ''">
        <div class="portal-opportunity-topline">
          <span class="portal-intent-pill" :class="'is-' + lead.leadIntent" x-text="lead.leadIntent === 'not_assessed' ? 'Intent not assessed' : humanize(lead.leadIntent) + ' intent'"></span>
          <span class="portal-age" x-text="relativeAge(lead.distributedAt || lead.createdAt)"></span>
        </div>

        <div class="portal-opportunity-heading">
          <div class="portal-category-icon"><svg class="icon"><use href="#i-lead"></use></svg></div>
          <div class="min-w-0">
            <div class="portal-opportunity-category" x-text="lead.category || humanize(lead.categorySlug)"></div>
            <h3 x-text="lead.leadTitle || lead.serviceType || 'Service requirement'"></h3>
          </div>
        </div>

        <div class="portal-opportunity-location">
          <div>
            <span>Location</span>
            <strong x-text="[lead.city, lead.state].filter(Boolean).join(', ') || 'Location available after review'"></strong>
          </div>
          <div x-show="lead.providerDistanceKm !== null && lead.providerDistanceKm !== undefined">
            <span>Approx. distance</span>
            <strong x-text="distanceLabel(lead.providerDistanceKm)"></strong>
          </div>
        </div>

        <div class="portal-provider-signal">
          <div>
            <span class="portal-signal-icon"><svg class="icon"><use href="#i-unlock"></use></svg></span>
            <p><strong x-text="`${lead.unlockedCount || 0} provider${Number(lead.unlockedCount || 0) === 1 ? '' : 's'} unlocked`"></strong><small>Current provider interest</small></p>
          </div>
          <div :class="lead.currentlyConfirmed ? 'is-confirmed' : ''">
            <span class="portal-signal-icon"><svg class="icon"><use href="#i-check"></use></svg></span>
            <p><strong x-text="lead.currentlyConfirmed ? `${lead.providerConfirmedCount} confirmed` : 'Not confirmed yet'"></strong><small>Current outcome signal</small></p>
          </div>
        </div>

        <div class="portal-opportunity-meta">
          <div><span>Preferred</span><strong x-text="preferredLabel(lead)"></strong></div>
          <div><span x-text="lead.contactUnlocked ? 'Unlocked at' : 'Unlock cost'"></span><strong x-text="lead.contactUnlocked ? formatDate(lead.unlockedAt) : credits(lead.leadCostCredits)"></strong></div>
        </div>

        <div class="portal-opportunity-footer">
          <div>
            <span class="portal-id" x-text="lead.enquiryId || lead.leadDistributionId"></span>
            <span class="badge" :class="statusClass(lead)" x-text="lead.providerSaleOutcome ? humanize(lead.providerSaleOutcome) : (lead.contactUnlocked ? 'Outcome pending' : 'Available')"></span>
          </div>
          <a class="btn btn-primary" :href="'/leads/' + lead.leadDistributionId" x-text="lead.contactUnlocked ? 'Open unlocked lead' : 'View opportunity'"></a>
        </div>
      </article>
    </template>
  </div>

  <div class="card portal-card" x-show="loading || (!loading && !rows.length)">
    <div class="card-body text-center py-5">
      <div x-show="loading" class="text-muted">Loading leads…</div>
      <div x-show="!loading && !rows.length">
        <div class="portal-empty-icon"><svg class="icon"><use href="#i-lead"></use></svg></div>
        <div class="fw-semibold mt-3" x-text="filters.status === 'unlocked' ? 'No unlocked leads yet' : (!locationReady ? 'Service PIN code required' : 'No nearby leads right now')"></div>
        <div class="text-muted fs-sm mt-1" x-text="filters.status === 'unlocked' ? 'Leads will appear here immediately after a successful unlock.' : (!locationReady ? 'Add your primary PIN code in My Profile to start receiving local opportunities.' : 'The marketplace expands automatically as new matching leads become available.')"></div>
      </div>
    </div>
  </div>

  <div class="portal-card portal-pagination mt-4 px-3" x-show="pagination.pages > 1">
    <div class="text-muted fs-sm" x-text="`${pagination.total || 0} leads`"></div>
    <div class="d-flex align-items-center gap-2 ms-auto">
      <button class="btn btn-light btn-sm" :disabled="pagination.page <= 1 || loading" @click="go(pagination.page - 1)">Previous</button>
      <span class="fs-sm" x-text="`${pagination.page} of ${pagination.pages}`"></span>
      <button class="btn btn-light btn-sm" :disabled="pagination.page >= pagination.pages || loading" @click="go(pagination.page + 1)">Next</button>
    </div>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  function leadList() {
    const query = new URLSearchParams(location.search);
    const initialStatus = query.get('status') === 'unlocked' ? 'unlocked' : 'offered';
    return {
      rows: [],
      categories: [],
      locationReady: true,
      loading: true,
      error: '',
      pagination: { page: Number(query.get('page') || 1), pages: 1, total: 0 },
      filters: {
        q: query.get('q') || '',
        status: initialStatus,
        categorySlug: query.get('categorySlug') || '',
        city: query.get('city') || '',
        limit: Number(query.get('limit') || 20)
      },
      init() {
        this.updatePageTitle();
        this.load();
      },
      updatePageTitle() {
        const unlocked = this.filters.status === 'unlocked';
        this.$dispatch('portal-page', {
          title: unlocked ? 'Unlocked leads' : 'Lead marketplace',
          subtitle: unlocked ? 'Customer contacts you have purchased' : 'Nearby category-matched opportunities from Findoly CRM'
        });
      },
      params() {
        const params = new URLSearchParams();
        Object.entries(this.filters).forEach(([key, value]) => {
          if (value !== '' && value !== null && value !== undefined) params.set(key, value);
        });
        params.set('page', this.pagination.page);
        return params;
      },
      hasActiveFilters() {
        return Boolean(String(this.filters.q || '').trim() || this.filters.categorySlug || String(this.filters.city || '').trim());
      },
      statusClass(lead) {
        if (lead.providerSaleOutcome === 'confirmed') return 'bg-success text-white';
        if (lead.providerSaleOutcome === 'not_confirmed') return 'bg-secondary text-white';
        if (['rejected', 'invalid'].includes(lead.providerLeadStatus)) return 'bg-danger text-white';
        if (lead.providerLeadStatus === 'on_hold') return 'bg-warning text-dark';
        return lead.contactUnlocked ? 'bg-primary-subtle text-primary' : 'bg-light text-body border';
      },
      relativeAge(value) {
        const time = new Date(value).getTime();
        if (!Number.isFinite(time)) return 'Recently added';
        const minutes = Math.max(0, Math.floor((Date.now() - time) / 60000));
        if (minutes < 1) return 'Just now';
        if (minutes < 60) return `${minutes} min ago`;
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return `${hours} hr${hours === 1 ? '' : 's'} ago`;
        const days = Math.floor(hours / 24);
        return `${days} day${days === 1 ? '' : 's'} ago`;
      },
      distanceLabel(value) {
        const distance = Number(value);
        if (!Number.isFinite(distance)) return '—';
        return distance < 1 ? `${Math.max(1, Math.round(distance * 1000))} m` : `${distance.toFixed(distance < 10 ? 1 : 0)} km`;
      },
      preferredLabel(lead) {
        const date = lead.preferredDate ? formatDateOnly(lead.preferredDate) : 'Flexible date';
        return lead.preferredSlot ? `${date} · ${lead.preferredSlot}` : date;
      },
      async load() {
        this.loading = true;
        this.error = '';
        try {
          const body = await apiFetch('/api/lead?' + this.params().toString());
          this.rows = body.data || [];
          this.categories = body.filters?.categories || [];
          this.locationReady = body.filters?.locationReady !== false;
          this.pagination = body.pagination || { page: 1, pages: 1, total: this.rows.length };
        } catch (error) {
          this.error = error.message;
        } finally {
          this.loading = false;
        }
      },
      apply() {
        this.pagination.page = 1;
        history.replaceState({}, '', '/leads?' + this.params().toString());
        this.load();
      },
      clear() {
        this.filters.q = '';
        this.filters.categorySlug = '';
        this.filters.city = '';
        this.pagination.page = 1;
        history.replaceState({}, '', '/leads?' + this.params().toString());
        this.load();
      },
      go(page) {
        this.pagination.page = page;
        history.replaceState({}, '', '/leads?' + this.params().toString());
        this.load();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    };
  }
</script>

      </div>
      <%- include('../partials/footer') %>
    </div>
  </div>
</div>
<div class="portal-sidebar-overlay" @click="closeSidebar()"></div>
<%- include('../partials/scripts') %>
</body>
</html>
