<%- include('../partials/pageStart') %>
<div x-data='leadShow(<%- JSON.stringify(recordId) %>)' x-init="load()">
  <div x-show="error" x-cloak class="alert alert-danger portal-flash" x-text="error"></div>

  <div class="row g-4 align-items-start" :class="loading ? 'portal-loading' : ''">
    <div class="col-xl-8">
      <div class="card portal-card mb-4">
        <div class="card-header border-bottom portal-lead-header">
          <div class="flex-grow-1 min-w-0">
            <div class="d-flex flex-wrap align-items-center gap-2">
              <h3 class="mb-0" x-text="lead.leadTitle || lead.serviceType || 'Service requirement'">Service requirement</h3>
              <span class="badge" :class="statusClass" x-text="isUnlocked ? 'Unlocked' : humanize(lead.status)"></span>
            </div>
            <div class="text-muted mt-2">
              <span x-text="lead.category || humanize(lead.categorySlug)"></span>
              <span> · offered </span>
              <span x-text="formatDate(lead.distributedAt || lead.createdAt)"></span>
            </div>
          </div>
          <div class="portal-price-box">
            <span>Unlock price</span>
            <strong x-text="money(lead.leadPricePaise)">₹0.00</strong>
          </div>
        </div>

        <div class="card-body">
          <div class="row g-0 portal-facts">
            <div class="col-sm-6 col-lg-3">
              <span>City</span>
              <strong x-text="lead.city || '—'"></strong>
            </div>
            <div class="col-sm-6 col-lg-3">
              <span>State</span>
              <strong x-text="lead.state || '—'"></strong>
            </div>
            <div class="col-sm-6 col-lg-3">
              <span>Preferred date</span>
              <strong x-text="formatDateOnly(lead.preferredDate)"></strong>
            </div>
            <div class="col-sm-6 col-lg-3">
              <span>Preferred slot</span>
              <strong x-text="lead.preferredSlot || 'Flexible'"></strong>
            </div>
          </div>
        </div>
      </div>

      <div class="card portal-card mb-4">
        <div class="card-header border-bottom"><h5 class="mb-0">Requirement details</h5></div>
        <div class="table-responsive">
          <table class="table portal-detail-table mb-0">
            <tbody>
              <template x-for="entry in detailEntries" :key="entry[0]">
                <tr>
                  <th x-text="humanize(entry[0])"></th>
                  <td x-text="displayValue(entry[1])"></td>
                </tr>
              </template>
              <tr x-show="!detailEntries.length">
                <td class="text-center text-muted py-4">No additional requirement details were supplied.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card portal-card" x-show="isUnlocked" x-cloak>
        <div class="card-header border-bottom d-flex align-items-center">
          <div>
            <h5 class="mb-1">Customer contact</h5>
            <div class="text-muted fs-sm">Unlocked only for your provider account.</div>
          </div>
          <span class="badge bg-success text-white ms-auto">Unlocked</span>
        </div>
        <div class="card-body">
          <div class="portal-contact-grid">
            <div><span>Customer</span><strong x-text="contact.name || '—'"></strong></div>
            <div><span>Mobile</span><a class="fw-semibold" :href="contact.mobile ? 'tel:' + contact.mobile : '#'"><span x-text="contact.mobile || '—'"></span></a></div>
            <div><span>Email</span><a :href="contact.email ? 'mailto:' + contact.email : '#'"><span x-text="contact.email || '—'"></span></a></div>
            <div><span>Address</span><strong x-text="contact.address || '—'"></strong></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-4">
      <div class="card portal-card portal-sticky-card">
        <div class="card-header border-bottom">
          <h5 class="mb-0" x-text="isUnlocked ? 'Lead unlocked' : 'Unlock this lead'"></h5>
        </div>
        <div class="card-body">
          <div class="portal-wallet-summary mb-3">
            <span>Wallet balance</span>
            <strong x-text="money(provider.walletBalancePaise)">₹0.00</strong>
          </div>

          <template x-if="!isUnlocked">
            <div>
              <div class="d-flex align-items-center mb-3">
                <span class="text-muted">Lead price</span>
                <strong class="ms-auto" x-text="money(lead.leadPricePaise)"></strong>
              </div>
              <div class="alert alert-warning py-2" x-show="!hasEnoughBalance" x-cloak>
                Add <strong x-text="money(Math.max(0, Number(lead.leadPricePaise || 0) - Number(provider.walletBalancePaise || 0)))"></strong> to unlock this lead.
              </div>
              <button class="btn btn-primary w-100" type="button" @click="unlock()" :disabled="unlocking || !hasEnoughBalance || loading">
                <span x-text="unlocking ? 'Unlocking…' : 'Unlock customer contact'"></span>
              </button>
              <a href="/wallet" class="btn btn-light w-100 mt-2">Add wallet funds</a>
              <p class="text-muted fs-sm mt-3 mb-0">This charge applies only to your account. Other matching providers unlock independently.</p>
            </div>
          </template>

          <template x-if="isUnlocked">
            <div>
              <a class="btn btn-light w-100" :class="contact.mobile ? '' : 'disabled'" :href="contact.mobile ? 'tel:' + contact.mobile : '#'"><svg class="icon me-2"><use href="#i-phone"></use></svg>Call customer</a>
              <a class="btn btn-outline-primary w-100 mt-2" href="/leads?status=unlocked">All unlocked leads</a>
              <p class="text-muted fs-sm mt-3 mb-0">Wallet deductions are recorded in your immutable transaction history.</p>
            </div>
          </template>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function leadShow(recordId) {
    return {
      recordId,
      lead: {},
      loading: true,
      unlocking: false,
      error: '',

      get isUnlocked() {
        return this.lead.contactUnlocked === true || this.lead.status === 'unlocked';
      },

      get hasEnoughBalance() {
        return Number(this.provider?.walletBalancePaise || 0) >= Number(this.lead.leadPricePaise || 0);
      },

      get statusClass() {
        if (this.isUnlocked) return 'bg-success text-white';
        if (this.lead.status === 'withdrawn') return 'bg-light text-muted border';
        return 'bg-primary text-white';
      },

      get detailEntries() {
        const details = this.lead.additionalDetails || this.lead.leadPreview?.additionalDetails || {};
        return Object.entries(details).filter(([, value]) => value !== '' && value !== null && value !== undefined);
      },

      get contact() {
        const snapshot = this.lead.contactSnapshot || {};
        return {
          name: this.lead.customerName || snapshot.name || snapshot.customerName || '',
          mobile: this.lead.customerMobile || snapshot.mobile || snapshot.customerMobile || '',
          email: this.lead.customerEmail || snapshot.email || snapshot.customerEmail || '',
          address: this.lead.customerAddress || snapshot.address || snapshot.customerAddress || ''
        };
      },

      displayValue(value) {
        if (Array.isArray(value)) return value.join(', ') || '—';
        if (value && typeof value === 'object') {
          return Object.entries(value).map(([key, item]) => `${humanize(key)}: ${item}`).join(' · ');
        }
        if (typeof value === 'boolean') return value ? 'Yes' : 'No';
        return String(value || '—');
      },

      async load() {
        this.loading = true;
        this.error = '';
        try {
          this.lead = (await apiFetch('/api/lead/' + encodeURIComponent(this.recordId))).data;
          const requirementId = this.lead.requirementId || this.recordId;
          this.$dispatch('portal-page', {
            title: `Lead ${requirementId}`,
            subtitle: requirementId,
            documentTitle: `Lead ${requirementId} · Provider Lead Portal`
          });
        } catch (error) {
          this.error = error.message;
        } finally {
          this.loading = false;
        }
      },

      async unlock() {
        if (!this.hasEnoughBalance || this.unlocking) return;
        if (!confirm(`Deduct ${money(this.lead.leadPricePaise)} from your wallet and reveal the customer contact?`)) return;

        this.unlocking = true;
        this.error = '';
        try {
          this.lead = (await apiFetch('/api/lead/' + encodeURIComponent(this.recordId) + '/unlock', {
            method: 'POST',
            body: '{}'
          })).data;
          this.$dispatch('wallet-updated');
        } catch (error) {
          this.error = error.message;
        } finally {
          this.unlocking = false;
        }
      }
    };
  }
</script>
<%- include('../partials/pageEnd') %>
