<!DOCTYPE html>
<html lang="en" dir="ltr">
<%- include('../partials/head') %>
<body
  x-data='providerShell({ title: <%- JSON.stringify(title || "") %>, subtitle: <%- JSON.stringify(subtitle || "") %> })'
  x-init="initShell()"
  @wallet-updated.window="refreshProfile()"
  @profile-updated.window="refreshProfile()"
  @portal-page.window="setPage($event.detail)"
  @portal-notify.window="notify($event.detail)"
>
<%- include('../partials/navbar') %>
<div class="page-content workspace-page-shell">
  <%- include('../partials/sidebar') %>
  <div class="content-wrapper">
    <div class="content-inner">
      <div class="page-header portal-page-header workspace-page-header border-bottom">
        <div class="page-header-content d-flex align-items-center">
          <div class="flex-grow-1 min-w-0">
            <h1 class="page-title mb-0 text-truncate" x-text="page.title"><%= title %></h1>
            <div class="page-subtitle mt-1" x-show="page.subtitle" x-text="page.subtitle"><%= subtitle || '' %></div>
          </div>
        </div>
      </div>
      <div class="content workspace-content">
        <div x-show="shellError" x-cloak class="alert alert-danger portal-flash" x-text="shellError"></div>

<div class="workspace-lead-detail-page" x-data="leadShow()" x-init="load()">
  <div x-show="error" x-cloak class="alert alert-danger portal-flash" x-text="error"></div>

  <nav class="provider-detail-breadcrumb" aria-label="Lead navigation">
    <a :href="isUnlocked ? '/leads?status=unlocked' : '/leads?status=offered'"><span aria-hidden="true">←</span><span x-text="isUnlocked ? 'Back to my leads' : 'Back to marketplace'"></span></a>
    <span class="provider-detail-breadcrumb-id" x-text="lead.leadDistributionId || ''"></span>
  </nav>

  <div class="row g-4 align-items-start workspace-lead-detail-grid" :class="loading ? 'portal-loading' : ''">
    <div class="col-xl-8">
      <div class="card portal-card mb-4 workspace-detail-hero">
        <div class="card-header border-bottom portal-lead-header">
          <div class="flex-grow-1 min-w-0">
            <div class="d-flex flex-wrap align-items-center gap-2">
              <h3 class="mb-0" x-text="displaySentenceCase(lead.leadTitle || lead.serviceType, 'Service requirement')">Service requirement</h3>
              <span class="badge" :class="statusClass" x-text="displayStatus"></span>
            </div>
            <div class="text-muted mt-2">
              <span x-text="lead.category || humanize(lead.categorySlug)"></span>
              <span> · offered </span>
              <span x-text="formatDate(lead.distributedAt || lead.createdAt)"></span>
            </div>
          </div>
          <div class="portal-price-box">
            <span x-text="isUnlocked ? 'Access' : 'Unlock cost'"></span>
            <div class="portal-price-values">
              <strong x-text="isUnlocked ? 'Unlocked' : credits(lead.leadCostCredits)">0 Credits</strong>
            </div>
            <small x-text="isUnlocked ? 'Customer contact available to your account' : 'CRM configured price'"></small>
          </div>
        </div>

        <div class="card-body">
          <div class="row g-0 portal-facts">
            <div class="col-sm-6 col-lg-3">
              <span>City</span>
              <strong x-text="displayTitleCase(lead.city, '—')"></strong>
            </div>
            <div class="col-sm-6 col-lg-3">
              <span>State</span>
              <strong x-text="displayTitleCase(lead.state, '—')"></strong>
            </div>
            <div class="col-sm-6 col-lg-3">
              <span>Preferred date</span>
              <strong x-text="formatDateOnly(lead.preferredDate)"></strong>
            </div>
            <div class="col-sm-6 col-lg-3">
              <span>Preferred slot</span>
              <strong x-text="lead.preferredSlot || 'Flexible'"></strong>
            </div>
          </div>
        </div>
      </div>

      <div class="provider-detail-quick-actions" x-show="isUnlocked" x-cloak>
        <div class="provider-detail-quick-copy">
          <span class="workspace-eyebrow">Customer access</span>
          <strong x-text="displayTitleCase(contact.name, 'Customer contact unlocked')"></strong>
          <small x-text="lead.providerSaleOutcome ? 'Current outcome: ' + humanize(lead.providerSaleOutcome) : 'Outcome update required'"></small>
        </div>
        <div class="provider-detail-quick-buttons">
          <a class="btn btn-light provider-action-button provider-action-call" :class="contact.mobile ? '' : 'disabled'" :href="contact.mobile ? 'tel:' + contact.mobile : '#'"><svg class="icon"><use href="#i-phone"></use></svg>Call</a>
          <a class="btn btn-light provider-action-button provider-action-whatsapp" :class="contact.mobile ? '' : 'disabled'" :href="contact.mobile ? 'https://wa.me/91' + String(contact.mobile).replace(/\D/g, '').slice(-10) : '#'" target="_blank" rel="noopener">WhatsApp</a>
          <button class="btn btn-primary provider-action-button provider-action-primary" type="button" @click="document.getElementById('provider-outcome')?.scrollIntoView({ behavior: 'smooth', block: 'start' })"><svg class="icon"><use href="#i-trend"></use></svg><span x-text="lead.providerSaleOutcome ? 'Edit outcome' : 'Update outcome'"></span></button>
        </div>
      </div>

      <div class="portal-marketplace-trust workspace-signal-strip mb-4">
        <div><span>Lead intent</span><strong :class="'is-' + lead.leadIntent" x-text="lead.leadIntent === 'not_assessed' ? 'Not assessed' : humanize(lead.leadIntent) + ' intent'"></strong></div>
        <div><span>Approx. distance</span><strong x-text="distanceLabel(lead.providerDistanceKm)"></strong></div>
        <div><span>Provider interest</span><strong><span x-text="lead.unlockedCount || 0"></span> unlocked</strong></div>
        <div><span>Current result</span><strong :class="lead.currentlyConfirmed ? 'is-confirmed' : ''" x-text="lead.currentlyConfirmed ? 'Confirmed by ' + lead.providerConfirmedCount : 'Not confirmed yet'"></strong></div>
      </div>

      <section class="provider-detail-unlock-banner mb-4" x-show="!isUnlocked" x-cloak>
        <div class="provider-detail-unlock-banner-copy">
          <span class="provider-eyebrow">CUSTOMER CONTACT</span>
          <strong>Ready to discuss this requirement?</strong>
          <small>Unlock the customer phone number and complete lead details for your provider account.</small>
        </div>
        <div class="provider-detail-unlock-banner-action">
          <span><small>UNLOCK COST</small><strong x-text="credits(lead.leadCostCredits)"></strong></span>
          <button class="btn btn-primary provider-action-button provider-action-primary" type="button" @click="hasEnoughBalance ? unlock() : document.getElementById('lead-access-panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' })" :disabled="unlocking || payingDirect || loading">
            <span x-text="unlocking ? 'Unlocking…' : (hasEnoughBalance ? 'Unlock lead now' : 'View unlock options')"></span>
            <svg class="icon"><use href="#i-arrow"></use></svg>
          </button>
        </div>
      </section>

      <div id="provider-outcome" class="card portal-card portal-outcome-card workspace-outcome-panel mb-4" x-show="isUnlocked" x-cloak>
        <div class="card-header border-bottom d-flex align-items-center gap-3">
          <div>
            <div class="portal-step-label">Required update</div>
            <h5 class="mb-1">Sale outcome</h5>
            <div class="text-muted fs-sm">Mark whether this lead resulted in a confirmed sale. You can correct it later if the customer decision changes.</div>
          </div>
          <span class="badge ms-auto" :class="outcomeClass" x-text="lead.providerSaleOutcome ? humanize(lead.providerSaleOutcome) : 'Pending'"></span>
        </div>
        <div class="card-body">
          <div class="portal-outcome-radio-grid" role="radiogroup" aria-label="Sale outcome">
            <label :class="{ selected: feedbackForm.outcome === 'confirmed' }">
              <input type="radio" name="providerSaleOutcome" value="confirmed" x-model="feedbackForm.outcome">
              <span><strong>Confirmed</strong><small>The customer booked or purchased the service.</small></span>
            </label>
            <label :class="{ selected: feedbackForm.outcome === 'not_confirmed' }">
              <input type="radio" name="providerSaleOutcome" value="not_confirmed" x-model="feedbackForm.outcome">
              <span><strong>Not Confirmed</strong><small>No completed sale at this time.</small></span>
            </label>
          </div>

          <div class="portal-policy-warning mt-3">
            Submit accurate information only. Findoly may verify this outcome with the customer and provider. Incorrect or misleading updates can result in a warning, temporary suspension, or permanent platform restriction after team review.
          </div>

          <div class="row g-3 mt-1">
            <div class="col-12">
              <label class="form-label" for="providerOutcomeNote">Outcome note <span class="text-muted">(optional)</span></label>
              <input id="providerOutcomeNote" class="form-control" maxlength="1000" x-model="feedbackForm.outcomeNote" placeholder="Booking reference, expected service date, or a short update">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="providerLeadStatus">Activity status <span class="text-muted">(optional)</span></label>
              <select id="providerLeadStatus" class="form-select" x-model="feedbackForm.status" @change="feedbackForm.reason = ''; feedbackForm.note = ''">
                <option value="">No additional activity status</option>
                <template x-for="option in leadStatusOptions" :key="option.value">
                  <option :value="option.value" x-text="option.label"></option>
                </template>
              </select>
            </div>
            <div class="col-md-6" x-show="requiresReason" x-cloak>
              <label class="form-label" for="providerLeadReason">Reason</label>
              <select id="providerLeadReason" class="form-select" x-model="feedbackForm.reason">
                <option value="">Select reason</option>
                <template x-for="reason in currentReasonOptions" :key="reason.value">
                  <option :value="reason.value" x-text="reason.label"></option>
                </template>
              </select>
            </div>
            <div class="col-12" x-show="feedbackForm.status" x-cloak>
              <label class="form-label" for="providerLeadNote">Activity note <span class="text-muted" x-show="!requiresReason">(optional)</span></label>
              <textarea id="providerLeadNote" class="form-control" rows="2" maxlength="1000" x-model="feedbackForm.note" :placeholder="feedbackForm.reason === 'other' || feedbackForm.status === 'other' ? 'Explain this activity status' : 'Add a short follow-up note, if needed'"></textarea>
            </div>
          </div>

          <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
            <button class="btn btn-primary" type="button" @click="saveStatus()" :disabled="savingStatus || !canSaveStatus">
              <span x-text="savingStatus ? 'Saving…' : 'Save outcome'"></span>
            </button>
            <div class="text-muted fs-sm" x-show="lead.providerSaleOutcomeUpdatedAt" x-text="`Outcome updated ${formatDate(lead.providerSaleOutcomeUpdatedAt)}`"></div>
            <div class="text-warning fs-sm" x-show="lead.crmSyncStatus === 'failed'">Saved locally; CRM notification is pending.</div>
          </div>
        </div>
      </div>

      <div class="card portal-card mb-4 workspace-detail-section">
        <div class="card-header border-bottom"><div><span class="workspace-eyebrow">Lead information</span><h5 class="mb-0">Requirement details</h5></div></div>
        <div class="table-responsive">
          <table class="table portal-detail-table mb-0">
            <tbody>
              <template x-for="entry in detailEntries" :key="entry[0]">
                <tr>
                  <th x-text="humanize(entry[0])"></th>
                  <td x-text="displayValue(entry[1])"></td>
                </tr>
              </template>
              <tr x-show="!detailEntries.length">
                <td class="text-center text-muted py-4">No additional requirement details were supplied.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card portal-card mb-4 workspace-contact-panel" x-show="isUnlocked" x-cloak>
        <div class="card-header border-bottom d-flex align-items-center">
          <div>
            <h5 class="mb-1">Customer contact</h5>
            <div class="text-muted fs-sm">Unlocked only for your provider account.</div>
          </div>
          <span class="badge bg-success text-white ms-auto">Unlocked</span>
        </div>
        <div class="card-body">
          <div class="portal-contact-grid">
            <div><span>Customer</span><strong x-text="contact.name || '—'"></strong></div>
            <div><span>Mobile</span><a class="fw-semibold" :href="contact.mobile ? 'tel:' + contact.mobile : '#'"><span x-text="contact.mobile || '—'"></span></a></div>
            <div><span>Email</span><a :href="contact.email ? 'mailto:' + contact.email : '#'"><span x-text="contact.email || '—'"></span></a></div>
            <div><span>Address</span><strong x-text="contact.address || '—'"></strong></div>
          </div>
        </div>
      </div>

    </div>

    <div class="col-xl-4">
      <div id="lead-access-panel" class="card portal-card portal-sticky-card workspace-access-panel">
        <div class="card-header border-bottom">
          <h5 class="mb-0" x-text="isUnlocked ? 'Lead unlocked' : 'Unlock this lead'"></h5>
        </div>
        <div class="card-body">
          <div class="portal-wallet-summary mb-3">
            <span>Available credits</span>
            <strong x-text="credits(provider.availableCredits ?? provider.walletCredits)">0 Credits</strong>
          </div>

          <template x-if="!isUnlocked">
            <div>
              <div class="portal-unlock-price mb-3">
                <div><span>Lead access</span><strong>Customer contact</strong></div>
                <div class="is-total"><span>Unlock cost</span><strong x-text="credits(lead.leadCostCredits)"></strong></div>
              </div>

              <template x-if="hasEnoughBalance">
                <div>
                  <button class="btn btn-primary w-100" type="button" @click="unlock()" :disabled="unlocking || payingDirect || loading">
                    <span x-text="unlocking ? 'Unlocking…' : 'Unlock with credits'"></span>
                  </button>
                  <a href="/plans" class="btn btn-light w-100 mt-2">View plans &amp; credits</a>
                  <p class="text-muted fs-sm mt-3 mb-0">The exact credit cost is deducted only after the unlock completes.</p>
                </div>
              </template>

              <template x-if="!hasEnoughBalance">
                <div>
                  <div class="alert alert-warning py-2 mb-3">
                    You need <strong x-text="credits(creditShortfall)"></strong> more to unlock with credits.
                  </div>

                  <div class="portal-direct-payment-breakdown mb-3">
                    <div><span>Lead price</span><strong x-text="money(directBasePaise)"></strong></div>
                    <div><span>GST (18%)</span><strong x-text="money(directGstPaise)"></strong></div>
                    <div class="is-total"><span>Pay now</span><strong x-text="money(directTotalPaise)"></strong></div>
                  </div>

                  <button class="btn btn-primary w-100" type="button" @click="payAndUnlock()" :disabled="payingDirect || unlocking || loading">
                    <span class="spinner-border spinner-border-sm me-2" x-show="payingDirect" x-cloak></span>
                    <span x-text="payingDirect ? 'Opening secure checkout…' : `Pay ${money(directTotalPaise)} & unlock`"></span>
                  </button>
                  <a href="/plans" class="btn btn-light w-100 mt-2">Choose a credit plan</a>
                  <p class="text-muted fs-sm mt-3 mb-0">Direct payment unlocks only this lead. It does not add credits to your account.</p>
                </div>
              </template>
            </div>
          </template>

          <template x-if="isUnlocked">
            <div>
              <a class="btn btn-light w-100 provider-action-button provider-action-call" :class="contact.mobile ? '' : 'disabled'" :href="contact.mobile ? 'tel:' + contact.mobile : '#'"><svg class="icon me-2"><use href="#i-phone"></use></svg>Call customer</a>
              <a class="btn btn-light w-100 mt-2 provider-action-button provider-action-whatsapp" :class="contact.mobile ? '' : 'disabled'" :href="contact.mobile ? 'https://wa.me/91' + String(contact.mobile).replace(/\D/g, '').slice(-10) : '#'" target="_blank" rel="noopener">WhatsApp customer</a>
              <a class="btn btn-outline-primary w-100 mt-2" href="/leads?status=unlocked">All unlocked leads</a>
              <p class="text-muted fs-sm mt-3 mb-0" x-text="lead.unlockMethod === 'direct_payment' ? 'Unlocked with a verified direct payment.' : 'The credit deduction is recorded in your transaction history.'"></p>
            </div>
          </template>
        </div>
      </div>
    </div>
  </div>

  <div class="portal-mobile-lead-action d-xl-none" x-cloak x-show="!loading">
    <template x-if="!isUnlocked">
      <button type="button" class="btn btn-primary provider-action-button provider-action-primary" @click="document.getElementById('lead-access-panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' })">
        <span>Unlock options</span><strong x-text="credits(lead.leadCostCredits)"></strong>
      </button>
    </template>
    <template x-if="isUnlocked && !lead.providerSaleOutcome">
      <button type="button" class="btn btn-primary provider-action-button provider-action-primary" @click="document.getElementById('provider-outcome')?.scrollIntoView({ behavior: 'smooth', block: 'start' })">Update required outcome</button>
    </template>
    <template x-if="isUnlocked && lead.providerSaleOutcome">
      <a class="btn btn-light provider-action-button provider-action-call" :class="contact.mobile ? '' : 'disabled'" :href="contact.mobile ? 'tel:' + contact.mobile : '#'">Call customer</a>
    </template>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  function leadShow() {
    return {
      recordId: pathRecordId(),
      lead: {},
      loading: true,
      unlocking: false,
      payingDirect: false,
      savingStatus: false,
      error: '',
      feedbackForm: { outcome: '', outcomeNote: '', status: '', reason: '', note: '' },
      leadStatusOptions: [
        { value: 'contacted', label: 'Contacted', reasons: [] },
        { value: 'valid', label: 'Valid lead', reasons: [] },
        { value: 'follow_up', label: 'Follow up', reasons: [] },
        { value: 'on_hold', label: 'On hold', reasons: [] },
        { value: 'rejected', label: 'Rejected', reasons: [
          { value: 'outside_service_area', label: 'Outside service area' },
          { value: 'provider_unavailable', label: 'Provider unavailable' },
          { value: 'price_not_suitable', label: 'Price not suitable' },
          { value: 'duplicate_lead', label: 'Duplicate lead' },
          { value: 'other', label: 'Other' }
        ] },
        { value: 'invalid', label: 'Invalid', reasons: [
          { value: 'invalid_contact', label: 'Invalid contact' },
          { value: 'wrong_requirement', label: 'Wrong requirement' },
          { value: 'fake_or_spam', label: 'Fake or spam' },
          { value: 'duplicate_lead', label: 'Duplicate lead' },
          { value: 'other', label: 'Other' }
        ] },
        { value: 'not_interested', label: 'Not interested', reasons: [
          { value: 'customer_not_interested', label: 'Customer not interested' },
          { value: 'already_hired_another_provider', label: 'Already hired another provider' },
          { value: 'budget_issue', label: 'Budget issue' },
          { value: 'no_response', label: 'No response' },
          { value: 'other', label: 'Other' }
        ] },
        { value: 'other', label: 'Other', reasons: [{ value: 'other', label: 'Other' }] }
      ],

      get isUnlocked() {
        return this.lead.contactUnlocked === true || this.lead.status === 'unlocked';
      },

      get hasEnoughBalance() {
        return Number(this.provider?.availableCredits ?? this.provider?.walletCredits ?? 0) >= Number(this.lead.leadCostCredits || 0);
      },

      get creditShortfall() {
        return Math.max(0, Number(this.lead.leadCostCredits || 0) - Number(this.provider?.availableCredits ?? this.provider?.walletCredits ?? 0));
      },

      get directBasePaise() {
        return Math.round(Number(this.lead.leadCostCredits || 0) * 100);
      },

      get directGstPaise() {
        return Math.round(this.directBasePaise * 0.18);
      },

      get directTotalPaise() {
        return this.directBasePaise + this.directGstPaise;
      },

      get displayStatus() {
        if (this.lead.providerSaleOutcome) return humanize(this.lead.providerSaleOutcome);
        return this.isUnlocked ? 'Outcome pending' : humanize(this.lead.status);
      },

      get currentReasonOptions() {
        return this.leadStatusOptions.find((option) => option.value === this.feedbackForm.status)?.reasons || [];
      },

      get requiresReason() {
        return ['rejected', 'invalid', 'not_interested', 'other'].includes(this.feedbackForm.status);
      },

      get canSaveStatus() {
        if (!['confirmed', 'not_confirmed'].includes(this.feedbackForm.outcome)) return false;
        if (!this.feedbackForm.status) return true;
        if (!this.requiresReason) return true;
        if (!this.feedbackForm.reason) return false;
        return this.feedbackForm.reason !== 'other' || Boolean(String(this.feedbackForm.note || '').trim());
      },

      get outcomeClass() {
        if (this.lead.providerSaleOutcome === 'confirmed') return 'bg-success text-white';
        if (this.lead.providerSaleOutcome === 'not_confirmed') return 'bg-secondary text-white';
        return 'bg-warning text-dark';
      },

      get statusClass() {
        if (this.lead.providerSaleOutcome === 'confirmed') return 'bg-success text-white';
        if (['rejected', 'invalid'].includes(this.lead.providerLeadStatus)) return 'bg-danger text-white';
        if (this.lead.providerLeadStatus === 'on_hold') return 'bg-warning text-dark';
        if (this.lead.providerLeadStatus === 'not_interested') return 'bg-secondary text-white';
        if (this.isUnlocked) return 'bg-success text-white';
        if (this.lead.status === 'withdrawn') return 'bg-light text-muted border';
        return 'bg-primary text-white';
      },

      get detailEntries() {
        const details = this.lead.additionalDetails || {};
        return Object.entries(details).filter(([, value]) => value !== '' && value !== null && value !== undefined);
      },

      get contact() {
        return {
          name: this.lead.customerName || '',
          mobile: this.lead.customerMobile || '',
          email: this.lead.customerEmail || '',
          address: this.lead.customerAddress || ''
        };
      },

      distanceLabel(value) {
        const distance = Number(value);
        if (!Number.isFinite(distance)) return 'Location is being verified';
        return distance < 1 ? `${Math.max(1, Math.round(distance * 1000))} m away` : `${distance.toFixed(distance < 10 ? 1 : 0)} km away`;
      },

      displayValue(value) {
        if (Array.isArray(value)) return value.join(', ') || '—';
        if (value && typeof value === 'object') {
          return Object.entries(value).map(([key, item]) => `${humanize(key)}: ${item}`).join(' · ');
        }
        if (typeof value === 'boolean') return value ? 'Yes' : 'No';
        return String(value || '—');
      },

      syncStatusForm() {
        this.feedbackForm = {
          outcome: this.lead.providerSaleOutcome || '',
          outcomeNote: this.lead.providerSaleOutcomeNote || '',
          status: this.lead.providerLeadStatus || '',
          reason: this.lead.providerLeadReason || '',
          note: this.lead.providerLeadNote || ''
        };
      },

      async load() {
        this.loading = true;
        this.error = '';
        try {
          this.lead = (await apiFetch('/api/lead/' + encodeURIComponent(this.recordId))).data;
          this.syncStatusForm();
          const enquiryId = this.lead.enquiryId || this.recordId;
          this.$dispatch('portal-page', {
            title: `Lead ${enquiryId}`,
            subtitle: enquiryId,
            documentTitle: `Lead ${enquiryId} · Provider Lead Portal`
          });
        } catch (error) {
          this.error = error.message;
        } finally {
          this.loading = false;
        }
      },

      async unlock() {
        if (!this.hasEnoughBalance || this.unlocking) return;
        if (!confirm(`Deduct ${credits(this.lead.leadCostCredits)} and reveal the customer contact?`)) return;

        this.unlocking = true;
        this.error = '';
        try {
          this.lead = (await apiFetch('/api/lead/' + encodeURIComponent(this.recordId) + '/unlock', {
            method: 'POST',
            body: '{}'
          })).data;
          this.syncStatusForm();
          this.$dispatch('wallet-updated');
          this.$dispatch('portal-notify', { type: 'success', message: 'Customer contact unlocked successfully.' });
        } catch (error) {
          this.error = error.message;
        } finally {
          this.unlocking = false;
        }
      },

      async payAndUnlock() {
        if (this.hasEnoughBalance || this.payingDirect || this.isUnlocked) return;
        this.payingDirect = true;
        this.error = '';

        try {
          if (typeof Razorpay !== 'function') throw new Error('Razorpay Checkout could not be loaded. Check your connection and try again.');
          const order = (await apiFetch('/api/lead/' + encodeURIComponent(this.recordId) + '/direct-order', {
            method: 'POST',
            body: '{}'
          })).data;

          const cancelPendingOrder = async () => {
            await apiFetch('/api/lead/' + encodeURIComponent(this.recordId) + '/direct-cancel', {
              method: 'POST',
              body: JSON.stringify({ paymentOrderId: order.paymentOrderId })
            }).catch(() => {});
          };

          const checkout = new Razorpay({
            key: order.keyId,
            amount: order.amountPaise,
            currency: order.currency,
            name: 'LeadPortal',
            description: `Direct unlock · ${order.lead?.title || 'Lead'}`,
            order_id: order.razorpayOrderId,
            retry: { enabled: true },
            remember_customer: false,
            prefill: {
              name: order.provider?.name || '',
              email: order.provider?.email || '',
              contact: order.provider?.mobile || ''
            },
            notes: {
              paymentOrderId: order.paymentOrderId,
              purpose: 'lead_unlock',
              leadDistributionId: this.recordId
            },
            theme: { color: '#2563eb' },
            handler: async (payment) => {
              try {
                const verification = (await apiFetch('/api/lead/' + encodeURIComponent(this.recordId) + '/direct-verify', {
                  method: 'POST',
                  body: JSON.stringify(payment)
                })).data;

                if (verification.status === 'pending') {
                  this.$dispatch('portal-notify', { type: 'warning', message: verification.message || 'Payment is authorised and the lead will unlock after capture.' });
                } else if (verification.lead) {
                  this.lead = verification.lead;
                  this.syncStatusForm();
                  this.$dispatch('portal-notify', { type: 'success', message: 'Payment verified and customer contact unlocked.' });
                }
              } catch (error) {
                this.error = error.message;
              } finally {
                this.payingDirect = false;
              }
            },
            modal: {
              confirm_close: true,
              ondismiss: async () => {
                await cancelPendingOrder();
                this.payingDirect = false;
              }
            }
          });

          checkout.on('payment.failed', async (response) => {
            this.error = response.error?.description || 'Razorpay payment failed';
            await cancelPendingOrder();
            this.payingDirect = false;
          });
          checkout.open();
        } catch (error) {
          this.error = error.message;
          this.payingDirect = false;
        }
      },

      async saveStatus() {
        if (!this.isUnlocked || !this.canSaveStatus || this.savingStatus) return;
        this.savingStatus = true;
        this.error = '';
        try {
          this.lead = (await apiFetch('/api/lead/' + encodeURIComponent(this.recordId) + '/status', {
            method: 'PATCH',
            body: JSON.stringify(this.feedbackForm)
          })).data;
          this.syncStatusForm();
          this.$dispatch('portal-notify', { type: 'success', message: this.lead.syncWarning || 'Lead outcome updated successfully.' });
        } catch (error) {
          this.error = error.message;
        } finally {
          this.savingStatus = false;
        }
      }
    };
  }
</script>

      </div>
      <%- include('../partials/footer') %>
    </div>
  </div>
</div>
<div class="portal-sidebar-overlay" data-portal-menu-overlay aria-hidden="true"></div>
<script nonce="<%= cspNonce %>" src="https://checkout.razorpay.com/v1/checkout.js"></script>
<%- include('../partials/scripts') %>
</body>
</html>

