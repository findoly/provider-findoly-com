<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner" x-data="withdrawalShow()" x-init="load()">
      <div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Partner payout review</div><h1 class="page-title mb-1" x-text="row.withdrawalNumber||'Withdrawal request'"></h1><p class="crm-page-subtitle mb-0">Verify the referral block before authorising payment.</p></div><a href="/partner-withdrawals" class="btn btn-light">Back to withdrawals</a></div></div>
      <div class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div><div x-show="success" x-cloak class="alert alert-success" x-text="success"></div>
        <div class="row g-3">
          <div class="col-xl-8"><div class="card mb-3"><div class="card-header"><h5 class="mb-0">Payout calculation</h5></div><div class="card-body"><div class="crm-payout-summary"><article><small>Valid matured</small><strong x-text="row.validReferralCount||0"></strong></article><article><small>Converted sales</small><strong x-text="row.convertedSaleCount||0"></strong></article><article><small>Payable referrals</small><strong x-text="row.payableReferralCount||0"></strong></article><article><small>Rate</small><strong x-text="money(row.payoutPerReferralPaise)"></strong></article><article><small>Net payout</small><strong x-text="money(row.netAmountPaise)"></strong></article></div></div></div>
            <div class="card"><div class="card-header"><h5 class="mb-0">Included referrals</h5></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Requirement</th><th>Customer</th><th>Submitted</th><th>Conversion</th></tr></thead><tbody><template x-for="item in row.requirementSnapshots||[]" :key="item.enquiryId"><tr><td><a :href="'/enquiries/'+item.enquiryId" x-text="item.requirementTitle||item.enquiryId"></a><div class="crm-record-id" x-text="item.enquiryId"></div></td><td x-text="item.customerName||'—'"></td><td x-text="formatDate(item.submittedAt)"></td><td><span class="crm-status" :class="item.converted?'status-confirmed':'status-pending'" x-text="item.converted?'Converted':'Valid'"></span></td></tr></template></tbody></table></div></div>
          </div>
          <div class="col-xl-4"><div class="card mb-3"><div class="card-header"><h5 class="mb-0">Partner and payout</h5></div><div class="card-body"><dl class="row mb-0"><dt class="col-5">Partner</dt><dd class="col-7" x-text="row.agentBusinessName||row.agentName"></dd><dt class="col-5">Referral ID</dt><dd class="col-7" x-text="row.referralId"></dd><dt class="col-5">Status</dt><dd class="col-7"><span class="crm-status" :class="statusClass(row.status)" x-text="humanize(row.status)"></span></dd><dt class="col-5">Mode</dt><dd class="col-7" x-text="row.payoutMode||'—'"></dd><dt class="col-5">Account</dt><dd class="col-7" x-text="row.payoutAccountLabel||'Not configured'"></dd><dt class="col-5">Razorpay</dt><dd class="col-7 crm-record-id" x-text="row.razorpayPayoutId||'—'"></dd></dl></div></div>
            <div class="card mb-3"><div class="card-header"><h5 class="mb-0">Approval action</h5></div><div class="card-body"><label class="form-label">Mandatory note</label><textarea class="form-control mb-3" rows="4" maxlength="2000" x-model="note" placeholder="Explain the review or approval decision"></textarea><div class="d-grid gap-2"><button class="btn btn-primary" x-show="row.status==='submitted'" @click="transition('start_review')" :disabled="saving">Start review</button><button class="btn btn-primary" x-show="['under_review','eligibility_changed'].includes(row.status)" @click="transition('approve_eligibility')" :disabled="saving">Approve eligibility</button><button class="btn btn-primary" x-show="row.status==='eligibility_approved'" @click="transition('approve_finance')" :disabled="saving">Approve finance</button><button class="btn btn-success" x-show="['finance_approved','payout_failed'].includes(row.status)" @click="payout()" :disabled="saving">Process Razorpay payout</button><button class="btn btn-outline-danger" x-show="!['paid','payout_processing','rejected','cancelled'].includes(row.status)" @click="transition('reject')" :disabled="saving">Reject request</button></div></div></div>
            <div class="card"><div class="card-header"><h5 class="mb-0">Approval history</h5></div><div class="card-body"><div class="crm-payout-history"><template x-for="event in [...(row.approvalHistory||[])].reverse()" :key="event.historyId"><article><strong x-text="humanize(event.toStatus||event.action)"></strong><small><span x-text="event.actor||'System'"></span> · <span x-text="formatDate(event.createdAt)"></span></small><p x-text="event.note||'—'"></p></article></template></div></div></div>
          </div>
        </div>
      </div><%- include('../partials/footer') %>
    </div></div></div>
    <script>
      function withdrawalShow(){return{recordId:pathRecordId(),row:{},note:'',loading:true,saving:false,error:'',success:'',async load(){this.loading=true;try{this.row=(await apiFetch('/api/partner-payouts/'+this.recordId)).data;}catch(error){this.error=error.message;}finally{this.loading=false;}},requireNote(){if(!this.note.trim())throw new Error('Enter a mandatory approval note');},async transition(action){if(this.saving)return;this.error='';this.success='';this.saving=true;try{this.requireNote();this.row=(await apiFetch('/api/partner-payouts/'+this.recordId+'/transition',{method:'POST',body:JSON.stringify({action,note:this.note})})).data;this.note='';this.success='Withdrawal updated';}catch(error){this.error=error.message;}finally{this.saving=false;}},async payout(){if(this.saving)return;this.error='';this.success='';try{this.requireNote();if(!confirm('Process this payout through Razorpay?'))return;this.saving=true;this.row=(await apiFetch('/api/partner-payouts/'+this.recordId+'/payout',{method:'POST',body:JSON.stringify({note:this.note})})).data;this.note='';this.success='Payout request sent to Razorpay';}catch(error){this.error=error.message;}finally{this.saving=false;}}};}
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
