<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
      <div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Partner operations</div><h1 class="page-title mb-1">Partner withdrawals</h1><p class="crm-page-subtitle mb-0">Review eligibility, approve finance and process Razorpay payouts.</p></div></div></div>
      <div class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>
        <main x-data="withdrawalList()" x-init="load()">
          <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
          <section class="card crm-filter-card mb-3"><form @submit.prevent="search()"><div class="crm-filter-bar"><label class="crm-search-control"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" x-model="filters.q" placeholder="Search withdrawal, partner or referral ID"></label><label class="crm-compact-select"><span>Status</span><select x-model="filters.status"><option value="">All statuses</option><template x-for="status in statuses" :key="status"><option :value="status" x-text="humanize(status)"></option></template></select></label><label class="crm-compact-select"><span>Date</span><select x-model="filters.dateField"><option value="submittedAt">Submitted</option><option value="createdAt">Created</option><option value="updatedAt">Updated</option><option value="paidAt">Paid</option></select></label><input class="form-control" style="max-width:150px" type="date" x-model="filters.startDate" aria-label="From date"><input class="form-control" style="max-width:150px" type="date" x-model="filters.endDate" aria-label="To date"><label class="crm-compact-select"><span>Sort</span><select x-model="filters.sortOrder"><option value="newest">Newest</option><option value="oldest">Oldest</option></select></label><button class="btn btn-primary" type="submit">Apply</button><button class="btn btn-light" type="button" x-show="filters.q||filters.status||filters.startDate||filters.endDate||filters.sortOrder==='oldest'" @click="reset()">Clear</button></div></form></section>
          <section class="card crm-data-card"><div class="card-header crm-card-heading"><div><h2 class="card-title mb-1">Withdrawal requests</h2><p class="text-muted mb-0"><span x-text="rows.length"></span> requests on this page</p></div></div><div class="table-responsive"><table class="table crm-table mb-0"><thead><tr><th>Request</th><th>Partner</th><th>Eligibility</th><th>Amount</th><th>Status</th><th>Submitted</th><th></th></tr></thead><tbody><template x-if="loading"><tr><td colspan="7"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template><template x-for="row in rows" :key="row.withdrawalId"><tr><td><a class="crm-record-title" :href="'/partner-withdrawals/'+row.withdrawalId" x-text="row.withdrawalNumber"></a><div class="crm-record-id" x-text="row.withdrawalId"></div></td><td><div class="fw-semibold" x-text="row.agentBusinessName||row.agentName"></div><div class="text-muted fs-sm"><span x-text="row.referralId"></span> · <span x-text="row.agentMobile"></span></div></td><td><div><strong x-text="row.payableReferralCount"></strong> referrals</div><div class="text-muted fs-sm"><span x-text="row.convertedSaleCount"></span> converted · <span x-text="row.eligibleBlockCount"></span> blocks</div></td><td><div class="fw-semibold" x-text="money(row.netAmountPaise)"></div><div class="text-muted fs-sm" x-text="money(row.payoutPerReferralPaise)+' each'"></div></td><td><span class="crm-status" :class="statusClass(row.status)" x-text="humanize(row.status)"></span></td><td x-text="formatDate(row.submittedAt||row.createdAt)"></td><td class="text-end"><a class="crm-row-action" :href="'/partner-withdrawals/'+row.withdrawalId">Review</a></td></tr></template><tr x-show="!loading&&!rows.length"><td colspan="7"><div class="crm-empty-state"><strong>No withdrawal requests</strong><span>Partner requests will appear here after submission.</span></div></td></tr></tbody></table></div><div class="crm-table-footer"><div class="text-muted">Page <strong x-text="pagination.page"></strong></div><div class="crm-pagination"><button :disabled="pagination.page<=1||loading" @click="previous()">Previous</button><span x-text="pagination.page"></span><button :disabled="!pagination.hasNext||loading" @click="next()">Next</button></div></div></section>
        </main>
      </div><%- include('../partials/footer') %>
    </div></div></div>
    <script>
      function withdrawalList(){return{rows:[],statuses:['submitted','under_review','eligibility_approved','finance_approved','payout_processing','paid','rejected','cancelled','payout_failed','eligibility_changed','payout_reversed'],filters:{q:queryValue('q'),status:queryValue('status'),dateField:queryValue('dateField')||'submittedAt',startDate:queryValue('startDate'),endDate:queryValue('endDate'),sortOrder:queryValue('sortOrder')||'newest'},pagination:createCursorPagination(20),loading:false,error:'',async load(){this.loading=true;this.error='';try{const q=new URLSearchParams({...this.filters,limit:this.pagination.limit,cursor:this.pagination.cursor});[...q].forEach(([k,v])=>{if(!v)q.delete(k)});const body=await apiFetch('/api/partner-payouts?'+q.toString());this.rows=body.data||[];applyCursorPagination(this.pagination,body.pagination||{});}catch(error){this.error=error.message;}finally{this.loading=false;}},search(){resetCursorPagination(this.pagination);this.load();},reset(){this.filters={q:'',status:'',dateField:'submittedAt',startDate:'',endDate:'',sortOrder:'newest'};this.search();},next(){if(cursorNext(this.pagination))this.load();},previous(){if(cursorPrevious(this.pagination))this.load();}};}
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
