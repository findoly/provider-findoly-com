<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Provider lead journey</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Review one provider's complete available activity for this lead.</p>
              </div>
              <a :href="'/enquiries/' + leadId + '/providers'" class="btn btn-light crm-primary-action" x-data="{ leadId: pathParts()[1] || '' }"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back to provider table</a>
            </div>
          </div>

          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>
            <main x-data="providerStatusShow()" x-init="load()">
              <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>

              <div class="row g-3">
                <div class="col-xl-5">
                  <div class="card mb-3">
                    <div class="card-header"><h5 class="mb-0">Provider and lead</h5></div>
                    <div class="card-body">
                      <dl class="row mb-0">
                        <dt class="col-5">Reference ID</dt><dd class="col-7" x-text="lead.enquiryId || '—'"></dd>
                        <dt class="col-5">Requirement</dt><dd class="col-7" x-text="lead.requirementTitle || lead.serviceType || '—'"></dd>
                        <dt class="col-5">Provider</dt><dd class="col-7" x-text="distribution.providerName || distribution.providerBusinessName || distribution.providerId || '—'"></dd>
                        <dt class="col-5">Business</dt><dd class="col-7" x-text="distribution.providerBusinessName || '—'"></dd>
                        <dt class="col-5">Mobile</dt><dd class="col-7" x-text="distribution.providerMobile ? '+91 ' + distribution.providerMobile : '—'"></dd>
                        <dt class="col-5">Offer status</dt><dd class="col-7" x-text="humanize(distribution.status)"></dd>
                        <dt class="col-5">Contact</dt><dd class="col-7" x-text="distribution.contactUnlocked ? 'Unlocked' : 'Locked'"></dd>
                        <dt class="col-5">Sale outcome</dt><dd class="col-7" x-text="distribution.providerSaleOutcome ? humanize(distribution.providerSaleOutcome) : 'Pending'"></dd>
                        <dt class="col-5">Outcome note</dt><dd class="col-7" x-text="distribution.providerSaleOutcomeNote || '—'"></dd>
                        <dt class="col-5">Activity status</dt><dd class="col-7" x-text="distribution.providerLeadStatus ? humanize(distribution.providerLeadStatus) : '—'"></dd>
                        <dt class="col-5">Reason</dt><dd class="col-7" x-text="distribution.providerLeadReason ? humanize(distribution.providerLeadReason) : '—'"></dd>
                        <dt class="col-5">Activity note</dt><dd class="col-7" x-text="distribution.providerLeadNote || '—'"></dd>
                        <dt class="col-5">Verification</dt><dd class="col-7" x-text="distribution.outcomeVerificationStatus ? humanize(distribution.outcomeVerificationStatus) : 'Not reviewed'"></dd>
                        <dt class="col-5">Last outcome update</dt><dd class="col-7" x-text="formatDate(distribution.providerSaleOutcomeUpdatedAt || distribution.providerLeadStatusUpdatedAt || distribution.updatedAt)"></dd>
                      </dl>
                    </div>
                  </div>

                  <div class="card mb-3" x-show="distribution.contactUnlocked" x-cloak>
                    <div class="card-header"><h5 class="mb-0">Findoly outcome verification</h5></div>
                    <div class="card-body">
                      <div class="alert alert-warning py-2">Review the provider outcome against customer calls, WhatsApp, booking evidence, and communication history. Account action is always manual.</div>
                      <label class="form-label">Verification result</label>
                      <select class="form-select mb-2" x-model="reviewForm.verificationStatus">
                        <option value="pending_review">Pending review</option>
                        <option value="under_review">Under review</option>
                        <option value="verified">Verified</option>
                        <option value="unable_to_verify">Unable to verify</option>
                        <option value="incorrect_status">Incorrect status</option>
                      </select>
                      <label class="form-label">Provider action</label>
                      <select class="form-select mb-2" x-model="reviewForm.reviewAction" :disabled="reviewForm.verificationStatus !== 'incorrect_status'">
                        <option value="none">No account action</option>
                        <option value="warning">Issue warning</option>
                        <option value="suspend">Temporarily suspend portal access</option>
                        <option value="ban">Block provider from platform</option>
                      </select>
                      <label class="form-label">Review note</label>
                      <textarea class="form-control mb-2" rows="3" maxlength="2000" x-model="reviewForm.note" placeholder="Record what was verified and why this result was selected"></textarea>
                      <button class="btn btn-primary w-100" type="button" @click="saveReview()" :disabled="reviewSaving || !reviewForm.note.trim()" x-text="reviewSaving ? 'Saving…' : 'Save verification review'"></button>
                      <div class="text-success fs-sm mt-2" x-show="success" x-text="success"></div>
                    </div>
                  </div>
                  <a class="btn btn-light" :href="'/providers/' + distribution.providerId" x-show="distribution.providerId">Open provider</a>
                  <a class="btn btn-light" :href="'/enquiries/' + leadId">Open lead</a>
                </div>

                <div class="col-xl-7">
                  <div class="card">
                    <div class="card-header d-flex align-items-center"><h5 class="mb-0">Provider journey</h5><span class="badge bg-light text-dark ms-auto" x-text="providerJourney.length + ' events'"></span></div>
                    <div class="card-body">
                      <div class="crm-timeline" x-show="providerJourney.length">
                        <template x-for="event in providerJourney" :key="(event.type || '') + (event.createdAt || '') + (event.status || '')">
                          <div class="crm-timeline-item">
                            <div class="crm-timeline-marker"></div>
                            <div class="crm-timeline-content">
                              <div class="d-flex flex-wrap gap-2 align-items-center"><strong x-text="eventTitle(event)"></strong><small class="text-muted" x-text="formatDate(event.createdAt)"></small></div>
                              <div class="text-muted mt-1" x-show="eventDetail(event)" x-text="eventDetail(event)"></div>
                              <small class="text-muted d-block mt-1">Updated by <span x-text="event.actor || 'system'"></span></small>
                            </div>
                          </div>
                        </template>
                      </div>
                      <div class="text-center text-muted py-3" x-show="!providerJourney.length">No provider journey events have been recorded.</div>
                    </div>
                  </div>
                </div>
              </div>
            </main>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>

    <script>
      function providerStatusShow() {
        const parts = pathParts();
        return {
          leadId: parts[1] || '',
          distributionId: parts[3] || '',
          lead: {},
          distribution: {},
          error: '',
          success: '',
          reviewSaving: false,
          reviewForm: { verificationStatus: 'pending_review', reviewAction: 'none', note: '' },
          get providerJourney() { return this.distribution.providerJourney || []; },
          eventTitle(event) {
            if (event.type === 'distributed') return 'Lead offered';
            if (event.type === 'unlocked') return 'Contact unlocked';
            if (event.type === 'provider_outcome') return 'Provider marked ' + humanize(event.outcome || 'outcome');
            if (event.status) return 'Provider marked ' + humanize(event.status);
            return event.message || 'Provider update';
          },
          eventDetail(event) {
            const details = [];
            if (event.reason) details.push(humanize(event.reason));
            if (event.note) details.push(event.note);
            if (!details.length && event.message) details.push(event.message);
            return details.join(' — ');
          },
          async load() {
            try {
              const body = await apiFetch('/api/enquiry/' + this.leadId + '/providers/' + this.distributionId);
              this.lead = body.data?.lead || {};
              this.distribution = body.data?.distribution || {};
              this.reviewForm = {
                verificationStatus: this.distribution.outcomeVerificationStatus || 'pending_review',
                reviewAction: 'none',
                note: this.distribution.outcomeVerificationNote || ''
              };
            } catch (error) {
              this.error = error.message;
            }
          },
          async saveReview() {
            if (this.reviewSaving || !this.distribution.providerId || !this.reviewForm.note.trim()) return;
            this.reviewSaving = true;
            this.error = '';
            this.success = '';
            try {
              const body = await apiFetch('/api/provider/' + this.distribution.providerId + '/distributions/' + this.distributionId + '/outcome-review', {
                method: 'PATCH',
                body: JSON.stringify(this.reviewForm)
              });
              this.distribution = body.data?.distribution || this.distribution;
              this.success = 'Provider outcome review saved.';
              this.reviewForm.reviewAction = 'none';
            } catch (error) {
              this.error = error.message;
            } finally {
              this.reviewSaving = false;
            }
          }
        };
      }
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
