<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Lead management</div>
                <h1 class="page-title mb-1">Requirements</h1>
                <p class="crm-page-subtitle mb-0">Verify, price and distribute customer requirements.</p>
              </div>
              <a href="/enquiries/new" class="btn btn-primary crm-primary-action"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Create lead</a>
            </div>
          </div>

          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>

            <main x-data="leadList()" x-init="init()">
              <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>

              <section class="card crm-filter-card mb-3">
                <form @submit.prevent="search()">
                  <div class="crm-filter-bar">
                    <label class="crm-search-control">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
                      <input type="search" x-model="filters.q" placeholder="Search customer, mobile, title or lead ID" aria-label="Search requirements">
                    </label>
                    <button type="submit" class="btn btn-primary crm-filter-apply">Search</button>
                    <button type="button" class="btn btn-light crm-filter-toggle" :class="{'is-active': showFilters || activeFilterCount}" @click="showFilters = !showFilters">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
                      Filters
                      <span x-show="activeFilterCount" x-text="activeFilterCount"></span>
                    </button>
                    <button type="button" class="btn btn-light" x-show="activeFilterCount || filters.q" @click="reset()">Clear</button>
                    <label class="crm-page-size ms-auto"><span>Rows</span><select x-model.number="pagination.limit" @change="search()"><option :value="10">10</option><option :value="20">20</option><option :value="50">50</option><option :value="100">100</option></select></label>
                  </div>

                  <div class="crm-filter-drawer" x-show="showFilters" x-transition x-cloak>
                    <label><span>Status</span><select x-model="filters.status"><option value="">All statuses</option><template x-for="s in statuses" :key="s"><option :value="s" x-text="humanize(s)"></option></template></select></label>
                    <label><span>Record state</span><select x-model="filters.active"><option value="">Active and deactivated</option><option value="active">Active</option><option value="deactivated">Deactivated</option></select></label>
                    <label><span>Category</span><select x-model="filters.categorySlug"><option value="">All categories</option><template x-for="c in categories" :key="c.slug"><option :value="c.slug" x-text="c.name"></option></template></select></label>
                    <label><span>Source</span><select x-model="filters.sourceChannel"><option value="">All sources</option><option value="admin">CRM admin</option><option value="agent">Agent Portal</option></select></label>
                    <label><span>Referral ID</span><input type="text" maxlength="6" x-model="filters.referralId" @input="filters.referralId = String(filters.referralId || '').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 6)" placeholder="A7K2P9"></label>
                    <label><span>Lead validation</span><select x-model="filters.agentReferralValidation"><option value="">All validation states</option><option value="pending">Pending</option><option value="valid">Valid</option><option value="invalid">Invalid</option></select></label>
                    <label><span>Date field</span><select x-model="filters.dateField"><option value="createdAt">Created date</option><option value="updatedAt">Updated date</option><option value="statusUpdatedAt">Status updated</option><option value="marketplacePublishedAt">Marketplace published</option></select></label><label><span>From date</span><input type="date" x-model="filters.startDate"></label>
                    <label><span>To date</span><input type="date" x-model="filters.endDate"></label><label><span>Sort by date</span><select x-model="filters.sortOrder"><option value="newest">Newest first</option><option value="oldest">Oldest first</option></select></label>
                    <button type="submit" class="btn btn-primary align-self-end">Apply filters</button>
                  </div>
                </form>
              </section>

              <section class="card crm-data-card">
                <div class="card-header crm-card-heading crm-list-heading">
                  <div>
                    <h2 class="card-title mb-1">All requirements</h2>
                    <p class="text-muted mb-0"><span x-text="rows.length"></span> records on this page</p>
                  </div>
                  <span class="crm-list-refresh" x-show="loading"><span></span>Refreshing</span>
                </div>

                <div class="table-responsive">
                  <table class="table crm-table crm-requirement-table mb-0">
                    <thead>
                      <tr>
                        <th>Requirement</th>
                        <th>Customer</th>
                        <th>Category & location</th>
                        <th>Status</th>
                        <th>Distribution</th>
                        <th class="text-end">Price</th>
                        <th aria-label="Actions"></th>
                      </tr>
                    </thead>
                    <tbody>
                      <template x-if="loading">
                        <tr><td colspan="7"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr>
                      </template>
                      <template x-for="lead in rows" :key="recordId(lead, 'enquiryId')">
                        <tr>
                          <td>
                            <a class="crm-record-title" :href="'/enquiries/' + recordId(lead, 'enquiryId')" x-text="lead.requirementTitle || lead.serviceType || 'Customer requirement'"></a>
                            <div class="crm-record-id" x-text="recordId(lead, 'enquiryId')"></div>
                            <div class="text-muted fs-sm mt-1" x-show="lead.referralId"><span class="fw-semibold">Agent</span> · <span x-text="lead.referralId"></span> · <span x-text="lead.agentBusinessName || lead.agentName || 'Agent Portal'"></span></div>
                            <div class="text-muted fs-sm mt-1"><span class="fw-semibold">Validation</span> · <span class="crm-status" :class="statusClass(lead.agentReferralValidation||'pending')" x-text="humanize(lead.agentReferralValidation||'pending')"></span></div>
                            <div class="crm-mobile-meta d-lg-none" x-text="leadName(lead) + ' · ' + leadMobile(lead)"></div>
                          </td>
                          <td class="crm-hide-mobile"><div class="fw-semibold" x-text="leadName(lead)"></div><div class="text-muted fs-sm" x-text="leadMobile(lead)"></div></td>
                          <td><div class="fw-semibold" x-text="leadCategory(lead)"></div><div class="text-muted fs-sm" x-show="lead.serviceTypes && lead.serviceTypes.length" x-text="lead.serviceTypes.map((item) => item.name || item).filter(Boolean).join(', ')"></div><div class="text-muted fs-sm" x-text="[leadCity(lead), leadState(lead)].filter(Boolean).join(', ')"></div></td>
                          <td>
                            <span class="crm-status" :class="statusClass(lead.journeyStatus || lead.status)" x-text="humanize(lead.journeyStatus || lead.status)"></span>
                            <div class="text-muted fs-sm mt-1" x-text="lead.isActive === false ? 'Deactivated' : humanize(lead.priority || 'normal') + ' priority'"></div>
                          </td>
                          <td><div class="crm-distribution-count"><strong x-text="lead.distributionCount || 0"></strong><span>offered</span></div><div class="text-muted fs-sm"><span x-text="lead.unlockedCount || 0"></span> unlocked</div></td>
                          <td class="text-end"><div class="fw-semibold" x-text="money(lead.leadPricePaise)"></div><div class="text-muted fs-sm">per unlock</div></td>
                          <td class="text-end crm-nowrap">
                            <a class="crm-row-action" :href="'/enquiries/' + recordId(lead, 'enquiryId')">View</a>
                            <a class="crm-row-action" :href="'/enquiries/' + recordId(lead, 'enquiryId') + '/providers'">Provider status</a>
                            <a class="crm-row-action crm-row-action-muted" :href="'/enquiries/' + recordId(lead, 'enquiryId') + '/edit'">Edit</a>
                          </td>
                        </tr>
                      </template>
                      <tr x-show="!loading && !rows.length"><td colspan="7"><div class="crm-empty-state"><span class="crm-empty-icon"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span><strong>No requirements found</strong><span>Change the filters or create a new lead.</span><a href="/enquiries/new" class="btn btn-primary btn-sm">Create lead</a></div></td></tr>
                    </tbody>
                  </table>
                </div>

                <div class="crm-table-footer">
                  <div class="text-muted">Page <strong x-text="pagination.page"></strong> · <span x-text="rows.length"></span> rows</div>
                  <div class="crm-pagination">
                    <button type="button" :disabled="pagination.page <= 1 || loading" @click="previous()">Previous</button>
                    <span x-text="pagination.page"></span>
                    <button type="button" :disabled="!pagination.hasNext || loading" @click="next()">Next</button>
                  </div>
                </div>
              </section>
            </main>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>

    <script>
      function leadList() {
        const params = new URLSearchParams(location.search);
        return {
          rows: [],
          categories: [],
          statuses: ['new','verification','approved','distributed','sale_converted','rejected'],
          filters: {
            q: params.get('q') || '',
            status: params.get('status') || '',
            active: params.get('active') || '',
            categorySlug: params.get('categorySlug') || '',
            dateField: params.get('dateField') || 'createdAt',
            sortOrder: params.get('sortOrder') || 'newest',
            startDate: params.get('startDate') || '',
            endDate: params.get('endDate') || '',
            sourceChannel: params.get('sourceChannel') || '',
            referralId: params.get('referralId') || '',
            agentReferralValidation: params.get('agentReferralValidation') || ''
          },
          pagination: createCursorPagination(20),
          loading: false,
          error: '',
          showFilters: false,
          get activeFilterCount() {
            return ['status','active','categorySlug','sourceChannel','referralId','agentReferralValidation','startDate','endDate','sortOrder'].filter((key) => this.filters[key]).length;
          },
          async init() {
            this.showFilters = this.activeFilterCount > 0;
            try {
              const categories = await apiFetch('/api/catalog/categories');
              this.categories = categories.data || [];
              await this.load();
            } catch (error) {
              this.error = error.message;
            }
          },
          query() {
            const query = new URLSearchParams({
              ...this.filters,
              limit: this.pagination.limit,
              cursor: this.pagination.cursor
            });
            [...query].forEach(([key, value]) => { if (!value) query.delete(key); });
            return query.toString();
          },
          async load() {
            this.loading = true;
            this.error = '';
            try {
              const body = await apiFetch('/api/enquiry?' + this.query());
              this.rows = body.data || [];
              applyCursorPagination(this.pagination, body.pagination || {});
            } catch (error) {
              this.error = error.message;
            } finally {
              this.loading = false;
            }
          },
          search() { resetCursorPagination(this.pagination); this.load(); },
          reset() {
            this.filters = { q: '', status: '', active: '', categorySlug: '', dateField: 'createdAt', sortOrder: 'newest', startDate: '', endDate: '', sourceChannel: '', referralId: '', agentReferralValidation: '' };
            this.showFilters = false;
            history.replaceState({}, '', location.pathname);
            this.search();
          },
          next() { if (cursorNext(this.pagination)) this.load(); },
          previous() { if (cursorPrevious(this.pagination)) this.load(); }
        };
      }
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
