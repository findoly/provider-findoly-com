<!DOCTYPE html>
<html lang="en" dir="ltr">
<%- include('../partials/head') %>
<body
  x-data='providerShell({ title: <%- JSON.stringify(title || "") %>, subtitle: <%- JSON.stringify(subtitle || "") %> })'
  x-init="initShell()"
  @wallet-updated.window="refreshProfile()"
  @profile-updated.window="refreshProfile()"
  @portal-page.window="setPage($event.detail)"
  @portal-notify.window="notify($event.detail)"
>
<%- include('../partials/navbar') %>
<div class="page-content">
  <%- include('../partials/sidebar') %>
  <div class="content-wrapper">
    <div class="content-inner">
      <div class="page-header portal-page-header border-bottom">
        <div class="page-header-content d-flex align-items-center">
          <div class="flex-grow-1 min-w-0">
            <h1 class="page-title mb-0 text-truncate" x-text="page.title"><%= title %></h1>
            <div class="page-subtitle mt-1" x-show="page.subtitle" x-text="page.subtitle"><%= subtitle || '' %></div>
          </div>
        </div>
      </div>
      <div class="content">
        <div x-show="shellError" x-cloak class="alert alert-danger portal-flash" x-text="shellError"></div>

<div x-data="dashboardPage()" x-init="load()" :class="loading ? 'portal-loading' : ''">
  <div x-show="error" x-cloak class="alert alert-danger portal-flash" x-text="error"></div>

  <div class="portal-location-required mb-4" x-show="data.provider && !data.provider.locationReady" x-cloak>
    <div>
      <strong>Add your service PIN code to see nearby leads</strong>
      <span>Findoly releases new leads to the closest matching providers first.</span>
    </div>
    <a class="btn btn-primary btn-sm" href="/profile#marketplace-location">Add PIN code</a>
  </div>

  <div class="portal-pending-banner mb-4" x-show="data.pendingOutcomeCount > 0" x-cloak>
    <div>
      <strong><span x-text="data.pendingOutcomeCount"></span> lead outcomes need your update</strong>
      <span>Mark each unlocked lead as Confirmed or Not Confirmed. Accurate updates protect customer and provider trust.</span>
    </div>
    <button class="btn btn-warning btn-sm" type="button" @click="reminderOpen = true">Review pending leads</button>
  </div>

  <div class="portal-reminder-backdrop" x-show="reminderOpen" x-cloak @keydown.escape.window="reminderOpen = false">
    <section class="portal-reminder-dialog" role="dialog" aria-modal="true" aria-labelledby="pending-outcome-title" @click.outside="dismissReminder()">
      <div class="portal-reminder-header">
        <div>
          <div class="portal-reminder-kicker">Outcome update required</div>
          <h3 id="pending-outcome-title">Please update overdue unlocked leads</h3>
        </div>
        <button type="button" aria-label="Remind me later" @click="dismissReminder()">×</button>
      </div>
      <div class="portal-policy-warning">
        Submit accurate Confirmed or Not Confirmed outcomes. Findoly may verify updates with the customer and provider. Incorrect or misleading information can lead to a warning, temporary suspension, or permanent platform restriction after team review.
      </div>
      <div class="portal-reminder-list">
        <template x-for="lead in data.pendingOutcomes || []" :key="lead.leadDistributionId">
          <article class="portal-reminder-item">
            <div class="min-w-0">
              <strong x-text="lead.leadTitle || lead.serviceType || lead.enquiryId"></strong>
              <span><span x-text="lead.city || 'Location not provided'"></span> · unlocked <b x-text="lead.daysPending + ' days ago'"></b></span>
            </div>
            <a class="btn btn-primary btn-sm" :href="'/leads/' + lead.leadDistributionId + '#provider-outcome'">Update outcome</a>
          </article>
        </template>
      </div>
      <div class="portal-reminder-footer">
        <button class="btn btn-light" type="button" @click="dismissReminder()">Remind me later</button>
        <a class="btn btn-primary" href="/leads?status=unlocked">View all unlocked leads</a>
      </div>
    </section>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
      <a href="/leads?status=offered" class="portal-stat-card">
        <div>
          <span>Available leads</span>
          <strong x-text="data.offered || 0">0</strong>
          <small>Contact locked</small>
        </div>
        <span class="portal-stat-icon"><svg class="icon"><use href="#i-lead"></use></svg></span>
      </a>
    </div>
    <div class="col-6 col-xl-3">
      <a href="/leads?status=unlocked" class="portal-stat-card">
        <div>
          <span>Unlocked leads</span>
          <strong x-text="data.unlocked || 0">0</strong>
          <small>Your purchased contacts</small>
        </div>
        <span class="portal-stat-icon"><svg class="icon"><use href="#i-unlock"></use></svg></span>
      </a>
    </div>
    <div class="col-6 col-xl-3">
      <a href="/plans" class="portal-stat-card">
        <div>
          <span>Credit balance</span>
          <strong x-text="credits(data.provider?.availableCredits ?? data.provider?.walletCredits)">0 Credits</strong>
          <small>Plan credits available</small>
        </div>
        <span class="portal-stat-icon"><svg class="icon"><use href="#i-plan"></use></svg></span>
      </a>
    </div>
    <div class="col-6 col-xl-3">
      <a href="/profile" class="portal-stat-card">
        <div>
          <span>Matched categories</span>
          <strong x-text="(data.provider?.categorySlugs || []).length">0</strong>
          <small x-text="categorySummary">No categories</small>
        </div>
        <span class="portal-stat-icon"><svg class="icon"><use href="#i-check"></use></svg></span>
      </a>
    </div>
  </div>

  <div class="row g-4 align-items-start">
    <div class="col-xl-8">
      <div class="card portal-card">
        <div class="card-header d-flex align-items-center border-bottom">
          <div>
            <h5 class="mb-1">Recent lead activity</h5>
            <div class="text-muted fs-sm">Nearby marketplace leads and your recently unlocked contacts.</div>
          </div>
          <a href="/leads" class="btn btn-light btn-sm ms-auto">View all</a>
        </div>
        <div class="table-responsive">
          <table class="table portal-table mb-0">
            <thead>
              <tr>
                <th>Requirement</th>
                <th>Location</th>
                <th>Credit cost</th>
                <th>Status</th>
                <th class="text-end"></th>
              </tr>
            </thead>
            <tbody>
              <template x-for="lead in data.recent || []" :key="lead.leadDistributionId">
                <tr>
                  <td>
                    <div class="fw-semibold" x-text="lead.leadTitle || lead.serviceType || 'Service requirement'"></div>
                    <div class="text-muted fs-sm">
                      <span x-text="lead.category || humanize(lead.categorySlug)"></span>
                      <span> · </span>
                      <span class="portal-id" x-text="lead.enquiryId || '—'"></span>
                    </div>
                  </td>
                  <td>
                    <div x-text="lead.city || '—'"></div>
                    <div class="text-muted fs-sm" x-text="lead.state || ''"></div>
                  </td>
                  <td class="fw-semibold" x-text="credits(lead.leadCostCredits)"></td>
                  <td><span class="badge" :class="statusClass(lead)" x-text="lead.providerSaleOutcome ? humanize(lead.providerSaleOutcome) : (lead.contactUnlocked ? 'Outcome pending' : humanize(lead.status))"></span></td>
                  <td class="text-end"><a class="btn btn-outline-primary btn-sm" :href="'/leads/' + (lead.leadDistributionId)">View</a></td>
                </tr>
              </template>
              <tr x-show="!loading && !(data.recent || []).length">
                <td colspan="5" class="text-center text-muted py-5">No nearby or unlocked leads yet</td>
              </tr>
              <tr x-show="loading">
                <td colspan="5" class="text-center text-muted py-5">Loading lead offers…</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-xl-4">
      <div class="card portal-card">
        <div class="card-header border-bottom"><h5 class="mb-0">How unlocking works</h5></div>
        <div class="card-body">
          <ol class="portal-steps">
            <li>CRM approves and categorizes a customer lead.</li>
            <li>CRM validates the lead, assigns intent and publishes it using the customer PIN code.</li>
            <li>Nearby category-matched providers see it first; visibility expands automatically over time.</li>
            <li>You see approximate distance and requirement details without customer contact information.</li>
            <li>Unlock once at the CRM-configured credit cost to reveal the customer contact.</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  function dashboardPage() {
    return {
      data: {},
      loading: true,
      error: '',
      reminderOpen: false,

      get categorySummary() {
        const categories = this.data.provider?.categorySlugs || [];
        if (!categories.length) return 'No categories';
        if (categories.length <= 2) return categories.map(humanize).join(', ');
        return `${humanize(categories[0])} +${categories.length - 1} more`;
      },

      statusClass(lead) {
        if (lead.providerSaleOutcome === 'confirmed') return 'bg-success text-white';
        if (lead.providerSaleOutcome === 'not_confirmed') return 'bg-secondary text-white';
        if (['rejected', 'invalid'].includes(lead.providerLeadStatus)) return 'bg-danger text-white';
        if (lead.providerLeadStatus === 'on_hold') return 'bg-warning text-dark';
        if (lead.providerLeadStatus === 'not_interested') return 'bg-secondary text-white';
        if (lead.contactUnlocked || lead.status === 'unlocked') return 'bg-success text-white';
        if (lead.status === 'withdrawn') return 'bg-light text-muted border';
        return 'bg-primary text-white';
      },

      async load() {
        this.loading = true;
        this.error = '';
        try {
          this.data = (await apiFetch('/api/dashboard')).data || {};
          const dismissed = sessionStorage.getItem('findoly-pending-outcome-reminder-dismissed') === '1';
          this.reminderOpen = Number(this.data.pendingOutcomeCount || 0) > 0 && !dismissed;
        } catch (error) {
          this.error = error.message;
        } finally {
          this.loading = false;
        }
      },

      dismissReminder() {
        this.reminderOpen = false;
        sessionStorage.setItem('findoly-pending-outcome-reminder-dismissed', '1');
      }
    };
  }
</script>

      </div>
      <%- include('../partials/footer') %>
    </div>
  </div>
</div>
<div class="portal-sidebar-overlay" @click="closeSidebar()"></div>
<%- include('../partials/scripts') %>
</body>
</html>

