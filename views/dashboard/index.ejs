<!DOCTYPE html>
<html lang="en" dir="ltr">
<%- include('../partials/head') %>
<body
  x-data='providerShell({ title: <%- JSON.stringify(title || "") %>, subtitle: <%- JSON.stringify(subtitle || "") %> })'
  x-init="initShell()"
  @wallet-updated.window="refreshProfile()"
  @profile-updated.window="refreshProfile()"
  @portal-page.window="setPage($event.detail)"
  @portal-notify.window="notify($event.detail)"
>
<%- include('../partials/navbar') %>
<div class="page-content">
  <%- include('../partials/sidebar') %>
  <div class="content-wrapper">
    <div class="content-inner">
      <div class="page-header portal-page-header border-bottom">
        <div class="page-header-content d-flex align-items-center">
          <div class="flex-grow-1 min-w-0">
            <h1 class="page-title mb-0 text-truncate" x-text="page.title"><%= title %></h1>
            <div class="page-subtitle mt-1" x-show="page.subtitle" x-text="page.subtitle"><%= subtitle || '' %></div>
          </div>
        </div>
      </div>
      <div class="content">
        <div x-show="shellError" x-cloak class="alert alert-danger portal-flash" x-text="shellError"></div>

<div class="provider-minimal-dashboard" x-data="dashboardPage()" x-init="load()" :class="loading ? 'portal-loading' : ''">
  <div x-show="error" x-cloak class="alert alert-danger portal-flash" x-text="error"></div>

  <div class="portal-location-required mb-3" x-show="data.provider && !data.provider.locationReady" x-cloak>
    <div><strong>Your service location is pending in CRM</strong><span>Contact Findoly support before nearby leads can appear.</span></div>
    <a class="btn btn-light btn-sm" href="/profile#marketplace-location">View location</a>
  </div>

  <div class="portal-pending-banner provider-minimal-reminder mb-3" x-show="data.pendingOutcomeCount > 0" x-cloak>
    <div><strong><span x-text="data.pendingOutcomeCount"></span> outcome update<span x-show="data.pendingOutcomeCount !== 1">s</span> pending</strong><span>Please mark overdue unlocked leads accurately.</span></div>
    <button class="btn btn-warning btn-sm" type="button" @click="reminderOpen = true">Review</button>
  </div>

  <div class="portal-reminder-backdrop" x-show="reminderOpen" x-cloak @keydown.escape.window="reminderOpen = false">
    <section class="portal-reminder-dialog" role="dialog" aria-modal="true" aria-labelledby="pending-outcome-title" @click.outside="dismissReminder()">
      <div class="portal-reminder-header">
        <div><div class="portal-reminder-kicker">Outcome update required</div><h3 id="pending-outcome-title">Update overdue unlocked leads</h3></div>
        <button type="button" aria-label="Remind me later" @click="dismissReminder()">×</button>
      </div>
      <div class="portal-policy-warning">Submit accurate Confirmed or Not Confirmed outcomes. Misleading information may result in account action after Findoly team review.</div>
      <div class="portal-reminder-list">
        <template x-for="lead in data.pendingOutcomes || []" :key="lead.leadDistributionId">
          <article class="portal-reminder-item">
            <div class="min-w-0"><strong x-text="lead.leadTitle || lead.serviceType || lead.enquiryId"></strong><span><span x-text="lead.city || 'Location not provided'"></span> · <b x-text="lead.daysPending + ' days pending'"></b></span></div>
            <a class="btn btn-primary btn-sm" :href="'/leads/' + lead.leadDistributionId + '#provider-outcome'">Update</a>
          </article>
        </template>
      </div>
      <div class="portal-reminder-footer"><button class="btn btn-light" type="button" @click="dismissReminder()">Remind me later</button><a class="btn btn-primary" href="/leads?status=unlocked">View unlocked leads</a></div>
    </section>
  </div>

  <div class="provider-dashboard-summary">
    <a href="/leads?status=offered" class="provider-dashboard-stat"><span>Available leads</span><strong x-text="data.offered || 0">0</strong></a>
    <a href="/leads?status=unlocked" class="provider-dashboard-stat"><span>Unlocked leads</span><strong x-text="data.unlocked || 0">0</strong></a>
    <a href="/plans" class="provider-dashboard-stat"><span>Credit balance</span><strong x-text="credits(data.provider?.availableCredits ?? data.provider?.walletCredits)">0 Credits</strong></a>
    <button type="button" class="provider-dashboard-stat text-start" @click="data.pendingOutcomeCount > 0 ? reminderOpen = true : null"><span>Pending outcomes</span><strong x-text="data.pendingOutcomeCount || 0">0</strong></button>
  </div>

  <section class="card portal-card provider-dashboard-recent">
    <div class="card-header d-flex align-items-center border-bottom">
      <h5 class="mb-0">Recent leads</h5>
      <a href="/leads" class="btn btn-light btn-sm ms-auto">View all</a>
    </div>
    <div class="provider-recent-list">
      <template x-for="lead in (data.recent || []).slice(0, 5)" :key="lead.leadDistributionId">
        <a class="provider-recent-row" :href="'/leads/' + lead.leadDistributionId">
          <span class="provider-recent-icon"><svg class="icon"><use :href="lead.contactUnlocked ? '#i-unlock' : '#i-lead'"></use></svg></span>
          <span class="provider-recent-main min-w-0">
            <strong x-text="lead.leadTitle || lead.serviceType || 'Service requirement'"></strong>
            <small x-text="[lead.city, lead.category || humanize(lead.categorySlug)].filter(Boolean).join(' · ')"></small>
          </span>
          <span class="provider-recent-status" :class="statusClass(lead)" x-text="lead.providerSaleOutcome ? humanize(lead.providerSaleOutcome) : (lead.contactUnlocked ? 'Outcome pending' : credits(lead.leadCostCredits))"></span>
        </a>
      </template>
      <div class="provider-dashboard-empty" x-show="!loading && !(data.recent || []).length"><strong>No leads yet</strong><span>Matching opportunities will appear here automatically.</span><a class="btn btn-primary btn-sm" href="/leads?status=offered">Open marketplace</a></div>
      <div class="provider-dashboard-empty" x-show="loading">Loading…</div>
    </div>
  </section>
</div>

<script nonce="<%= cspNonce %>">
  function dashboardPage() {
    return {
      data: {}, loading: true, error: '', reminderOpen: false,
      statusClass(lead) {
        if (lead.providerSaleOutcome === 'confirmed') return 'is-success';
        if (lead.providerSaleOutcome === 'not_confirmed') return 'is-neutral';
        if (['rejected','invalid'].includes(lead.providerLeadStatus)) return 'is-danger';
        if (lead.providerLeadStatus === 'on_hold') return 'is-warning';
        return lead.contactUnlocked ? 'is-pending' : 'is-credit';
      },
      async load() {
        this.loading = true; this.error = '';
        try {
          this.data = (await apiFetch('/api/dashboard')).data || {};
          const dismissed = sessionStorage.getItem('findoly-pending-outcome-reminder-dismissed') === '1';
          this.reminderOpen = Number(this.data.pendingOutcomeCount || 0) > 0 && !dismissed;
        } catch (error) { this.error = error.message; } finally { this.loading = false; }
      },
      dismissReminder() { this.reminderOpen = false; sessionStorage.setItem('findoly-pending-outcome-reminder-dismissed', '1'); }
    };
  }
</script>

      </div>
      <%- include('../partials/footer') %>
    </div>
  </div>
</div>
<div class="portal-sidebar-overlay" @click="closeSidebar()"></div>
<%- include('../partials/scripts') %>
</body>
</html>
