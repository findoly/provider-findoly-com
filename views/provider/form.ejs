<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Provider network</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Manage provider profile, categories and portal access.</p>
              </div>
              <a href="/providers" class="btn btn-light crm-primary-action"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back to providers</a>
            </div>
          </div>
          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>

            <div x-data="providerForm()" x-init="init()">
              <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
              <form class="card" @submit.prevent="save">
                <div class="card-body" :class="loading && 'crm-loading'">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="form-label">Name</label>
                      <input class="form-control" x-model="form.name" maxlength="120" required />
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Business name</label>
                      <input class="form-control" x-model="form.businessName" maxlength="160" />
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Mobile</label>
                      <div class="input-group">
                        <span class="input-group-text crm-mobile-prefix">+91</span>
                        <input
                          class="form-control"
                          x-model="form.mobile"
                          @input="form.mobile = digitsOnly(form.mobile)"
                          inputmode="numeric"
                          autocomplete="tel-national"
                          pattern="[6-9][0-9]{9}"
                          minlength="10"
                          maxlength="10"
                          placeholder="10 digit mobile number"
                          required
                        />
                      </div>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Email</label>
                      <input class="form-control" type="email" x-model="form.email" maxlength="254" />
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Service PIN code <span class="text-danger">*</span></label>
                      <input class="form-control" x-model="form.servicePincode" @input="form.servicePincode = String(form.servicePincode || '').replace(/\D/g, '').slice(0, 6)" @blur="lookupPincode()" inputmode="numeric" pattern="[1-9][0-9]{5}" maxlength="6" placeholder="400001" required />
                      <div class="form-text" x-text="locationLoading ? 'Checking PIN code…' : 'This PIN code controls nearby marketplace lead visibility.'"></div>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">City <span class="text-danger">*</span></label>
                      <input class="form-control" x-model="form.city" maxlength="100" placeholder="Mumbai" required />
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">State <span class="text-danger">*</span></label>
                      <input class="form-control" x-model="form.state" maxlength="100" placeholder="Maharashtra" required />
                    </div>
                    <div class="col-12">
                      <label class="form-label">Full address <span class="text-muted">(optional)</span></label>
                      <input class="form-control" x-model="form.serviceAddress" maxlength="500" placeholder="Business or service address" />
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Categories</label>
                      <select
                        class="form-select crm-multi-select"
                        x-model="form.categorySlugs"
                        multiple
                        size="6"
                        required
                      >
                        <template x-for="category in categories" :key="category.slug">
                          <option :value="category.slug" x-text="category.name"></option>
                        </template>
                      </select>
                      <div class="form-text">Select one or more categories. Options are managed from the Categories feature.</div>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Service areas (comma separated)</label>
                      <input class="form-control" x-model="areaText" maxlength="5000" />
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Status</label>
                      <select class="form-select" x-model="form.status">
                        <option>active</option>
                        <option>inactive</option>
                        <option>pending</option>
                        <option>blocked</option>
                      </select>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Onboarding</label>
                      <select class="form-select" x-model="form.onboardingStage">
                        <option>new</option>
                        <option>documents_pending</option>
                        <option>training_pending</option>
                        <option>ready</option>
                        <option>paused</option>
                      </select>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Availability</label>
                      <input class="form-control" x-model="form.availability" maxlength="80" />
                    </div>
                    <div class="col-md-3">
                      <label class="form-label">Rating</label>
                      <input type="number" min="0" max="5" step=".1" class="form-control" x-model.number="form.rating" required />
                    </div>
                    <div class="col-md-6">
                      <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" x-model="form.portalAccessEnabled" id="portal" />
                        <label class="form-check-label" for="portal">Portal access enabled</label>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" x-model="form.documentsVerified" id="docs" />
                        <label class="form-check-label" for="docs">Documents verified</label>
                      </div>
                    </div>
                    <div class="col-12">
                      <label class="form-label">Notes</label>
                      <textarea class="form-control" x-model="form.notes" maxlength="5000"></textarea>
                    </div>
                  </div>
                </div>
                <div class="card-footer d-flex">
                  <a href="/providers" class="btn btn-light">Cancel</a>
                  <button class="btn btn-primary ms-auto" :disabled="saving" x-text="saving ? 'Saving…' : 'Save provider'"></button>
                </div>
              </form>
            </div>
            <script>
              function providerForm() {
                return {
                  mode: pageMode(),
                  recordId: pageMode() === "edit" ? pathRecordId(true) : "",
                  categories: [],
                  form: {
                    name: "",
                    businessName: "",
                    mobile: "",
                    email: "",
                    city: "",
                    state: "",
                    servicePincode: "",
                    serviceAddress: "",
                    status: "active",
                    onboardingStage: "new",
                    categorySlugs: [],
                    availability: "available_today",
                    rating: 0,
                    portalAccessEnabled: true,
                    documentsVerified: false,
                    notes: "",
                  },
                  areaText: "",
                  loading: true,
                  locationLoading: false,
                  lastLookedUpPincode: "",
                  saving: false,
                  error: "",
                  digitsOnly(value) {
                    let digits = String(value || "").replace(/\D/g, "");
                    if (digits.length === 12 && digits.startsWith("91")) digits = digits.slice(2);
                    if (digits.length === 11 && digits.startsWith("0")) digits = digits.slice(1);
                    return digits.slice(0, 10);
                  },
                  async init() {
                    try {
                      this.categories = (await apiFetch("/api/catalog/categories")).data || [];
                      if (this.mode === "edit") {
                        const d = (await apiFetch("/api/provider/" + this.recordId)).data;
                        this.form = {
                          ...this.form,
                          ...d,
                          mobile: this.digitsOnly(d.mobile),
                          categorySlugs: Array.isArray(d.categorySlugs) ? d.categorySlugs : [],
                        };
                        this.areaText = (d.serviceAreas || []).join(", ");
                      }
                    } catch (e) {
                      this.error = e.message;
                    } finally {
                      this.loading = false;
                    }
                  },
                  async lookupPincode() {
                    const pincode = String(this.form.servicePincode || '');
                    if (!/^[1-9]\d{5}$/.test(pincode) || this.locationLoading || this.lastLookedUpPincode === pincode) return;
                    this.locationLoading = true;
                    try {
                      const location = (await apiFetch('/api/location/pincode/' + encodeURIComponent(pincode))).data || {};
                      this.form.city = location.city || this.form.city;
                      this.form.state = location.state || this.form.state;
                      this.lastLookedUpPincode = pincode;
                    } catch (error) {
                      this.error = error.message + ' Enter city and state manually to continue.';
                    } finally {
                      this.locationLoading = false;
                    }
                  },
                  async save() {
                    if (this.saving) return;
                    this.saving = true;
                    this.error = "";
                    try {
                      if (!/^[6-9]\d{9}$/.test(this.form.mobile)) {
                        throw new Error("Enter a valid 10-digit Indian provider mobile number");
                      }
                      if (!this.form.categorySlugs.length) {
                        throw new Error("Select at least one category");
                      }
                      if (!/^[1-9]\d{5}$/.test(String(this.form.servicePincode || ''))) {
                        throw new Error("Provider service PIN code must contain exactly 6 digits");
                      }
                      if (!String(this.form.city || '').trim()) throw new Error("Provider city is required");
                      if (!String(this.form.state || '').trim()) throw new Error("Provider state is required");
                      const serviceAreas = this.areaText
                        .split(",")
                        .map((value) => value.trim())
                        .filter(Boolean);
                      if (serviceAreas.length > 100) {
                        throw new Error("Service areas cannot contain more than 100 entries");
                      }
                      if (serviceAreas.some((value) => value.length > 120)) {
                        throw new Error("Each service area must be 120 characters or less");
                      }
                      if (!Number.isFinite(Number(this.form.rating)) || Number(this.form.rating) < 0 || Number(this.form.rating) > 5) {
                        throw new Error("Provider rating must be between 0 and 5");
                      }
                      const payload = {
                        ...this.form,
                        skills: [...this.form.categorySlugs],
                        serviceAreas,
                      };
                      const response = await apiFetch(
                        this.mode === "edit"
                          ? "/api/provider/" + this.recordId
                          : "/api/provider",
                        {
                          method: this.mode === "edit" ? "PUT" : "POST",
                          body: JSON.stringify(payload),
                        },
                      );
                      location.href = "/providers/" + response.data.providerId;
                    } catch (e) {
                      this.error = e.message;
                    } finally {
                      this.saving = false;
                    }
                  },
                };
              }
            </script>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>
    <%- include('../partials/scripts') %>
  </body>
</html>
