<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content">
      <%- include('../partials/sidebar') %>
      <div class="content-wrapper">
        <div class="content-inner">
          <div class="page-header page-header-light crm-page-header">
            <div class="page-header-content crm-page-heading">
              <div>
                <div class="crm-page-eyebrow">Provider network</div>
                <h1 class="page-title mb-1"><%= title %></h1>
                <p class="crm-page-subtitle mb-0">Review provider eligibility, offers and credit activity.</p>
              </div>
              <a href="/providers" class="btn btn-light crm-primary-action"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back to providers</a>
            </div>
          </div>
          <div class="content">
            <div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div>

            <div x-data="providerShow()" x-init="load()">
              <div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
              <div x-show="success" x-cloak class="alert alert-success" x-text="success"></div>
              <div class="d-flex flex-wrap gap-2 mb-3">
                <a class="btn btn-light" :href="'/providers/'+recordId+'/edit'">Edit</a>
                <button class="btn btn-primary" @click="sync()" :disabled="syncing" x-text="syncing ? 'Synchronizing…' : 'Sync approved leads'"></button>
                <button class="btn btn-primary" type="button" x-show="can('provider_credits.add')" x-cloak @click="openCreditModal()">Add credits</button>
              </div>
              <div class="row g-3">
                <div class="col-xl-4">
                  <div class="card">
                    <div class="card-body">
                      <h4 x-text="provider.name"></h4>
                      <div class="text-muted mb-3" x-text="provider.businessName"></div>
                      <dl class="row mb-0">
                        <dt class="col-5">Provider ID</dt><dd class="col-7" x-text="provider.providerId"></dd>
                        <dt class="col-5">Mobile</dt><dd class="col-7" x-text="provider.mobile ? '+91 ' + provider.mobile : '—'"></dd>
                        <dt class="col-5">Status</dt><dd class="col-7" x-text="humanize(provider.status)"></dd>
                        <dt class="col-5">Portal access</dt><dd class="col-7" x-text="provider.portalAccessEnabled === false ? 'Restricted' : 'Enabled'"></dd>
                        <dt class="col-5">Outcome warnings</dt><dd class="col-7" x-text="provider.outcomeWarningCount || 0"></dd>
                        <dt class="col-5" x-show="provider.platformRestrictionReason">Restriction reason</dt><dd class="col-7" x-show="provider.platformRestrictionReason" x-text="provider.platformRestrictionReason"></dd>
                        <dt class="col-5">Credit balance</dt><dd class="col-7 fw-semibold" x-text="credits(provider.walletBalancePaise)"></dd>
                        <dt class="col-5">Categories</dt><dd class="col-7" x-text="(provider.categorySlugs||[]).join(', ') || '—'"></dd>
                      </dl>
                    </div>
                  </div>
                </div>
                <div class="col-xl-8">
                  <div class="card mb-3">
                    <div class="card-header d-flex align-items-center">
                      <div><h5 class="mb-1">Lead offers</h5><p class="text-muted mb-0"><span x-text="offers.length"></span> rows on this page</p></div>
                      <label class="crm-page-size ms-auto"><span>Rows</span><select x-model.number="offerPagination.limit" @change="resetOffers()"><option :value="10">10</option><option :value="25">25</option><option :value="50">50</option><option :value="100">100</option></select></label>
                    </div>
                    <div class="table-responsive">
                      <table class="table mb-0">
                        <thead><tr><th>Lead</th><th>Offer</th><th>Sale outcome</th><th>Activity</th><th>Verification</th><th>Price</th><th>Date</th><th></th></tr></thead>
                        <tbody>
                          <template x-if="offerLoading"><tr><td colspan="8"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template>
                          <template x-for="d in offers" :key="d.leadDistributionId">
                            <tr>
                              <td><a :href="'/enquiries/'+d.enquiryId" x-text="d.leadTitle||d.enquiryId"></a></td>
                              <td x-text="humanize(d.status)"></td>
                              <td x-text="d.providerSaleOutcome ? humanize(d.providerSaleOutcome) : (d.contactUnlocked ? 'Pending' : '—')"></td>
                              <td x-text="d.providerLeadStatus ? humanize(d.providerLeadStatus) : '—'"></td>
                              <td x-text="d.outcomeVerificationStatus ? humanize(d.outcomeVerificationStatus) : (d.providerSaleOutcome ? 'Pending review' : '—')"></td>
                              <td x-text="money(d.leadPricePaise)"></td>
                              <td x-text="formatDate(d.distributedAt)"></td>
                              <td><a class="btn btn-light btn-sm" :href="'/enquiries/' + d.enquiryId + '/providers/' + d.leadDistributionId" x-show="d.contactUnlocked">Review</a></td>
                            </tr>
                          </template>
                          <tr x-show="!offerLoading && !offers.length"><td colspan="8" class="text-center text-muted py-4">No lead offers</td></tr>
                        </tbody>
                      </table>
                    </div>
                    <div class="crm-table-footer">
                      <div class="text-muted">Page <strong x-text="offerPagination.page"></strong></div>
                      <div class="crm-pagination"><button :disabled="offerPagination.page <= 1 || offerLoading" @click="previousOffers()">Previous</button><span x-text="offerPagination.page"></span><button :disabled="!offerPagination.hasNext || offerLoading" @click="nextOffers()">Next</button></div>
                    </div>
                  </div>

                  <div class="card">
                    <div class="card-header d-flex align-items-center">
                      <div><h5 class="mb-1">Credit transactions</h5><p class="text-muted mb-0"><span x-text="transactions.length"></span> rows on this page</p></div>
                      <label class="crm-page-size ms-auto"><span>Rows</span><select x-model.number="transactionPagination.limit" @change="resetTransactions()"><option :value="10">10</option><option :value="25">25</option><option :value="50">50</option><option :value="100">100</option></select></label>
                    </div>
                    <div class="table-responsive">
                      <table class="table mb-0">
                        <thead><tr><th>Type</th><th>Details</th><th>Amount</th><th>Balance</th><th>Source</th><th>Date</th></tr></thead>
                        <tbody>
                          <template x-if="transactionLoading"><tr><td colspan="6"><div class="crm-table-loading"><span></span><span></span><span></span></div></td></tr></template>
                          <template x-for="t in transactions" :key="t.walletTransactionId">
                            <tr>
                              <td x-text="humanize(t.type)"></td>
                              <td style="min-width:260px">
                                <div class="fw-semibold" x-text="t.description || '—'"></div>
                                <div class="text-muted fs-sm" x-show="t.metadata && t.metadata.internalNote" x-text="t.metadata && t.metadata.internalNote"></div>
                                <div class="text-muted fs-sm" x-show="t.metadata && t.metadata.externalReference" x-text="'Reference: ' + t.metadata.externalReference"></div>
                                <div class="text-muted fs-sm" x-show="t.metadata && t.metadata.addedBy && t.metadata.addedBy.name" x-text="'Added by ' + t.metadata.addedBy.name"></div>
                              </td>
                              <td class="fw-semibold" :class="t.type === 'credit' ? 'text-success' : 'text-danger'" x-text="transactionAmount(t)"></td>
                              <td x-text="credits(t.balanceAfterPaise)"></td>
                              <td x-text="humanize(t.source)"></td>
                              <td x-text="formatDate(t.createdAt)"></td>
                            </tr>
                          </template>
                          <tr x-show="!transactionLoading && !transactions.length"><td colspan="6" class="text-center text-muted py-4">No credit transactions</td></tr>
                        </tbody>
                      </table>
                    </div>
                    <div class="crm-table-footer">
                      <div class="text-muted">Page <strong x-text="transactionPagination.page"></strong></div>
                      <div class="crm-pagination"><button :disabled="transactionPagination.page <= 1 || transactionLoading" @click="previousTransactions()">Previous</button><span x-text="transactionPagination.page"></span><button :disabled="!transactionPagination.hasNext || transactionLoading" @click="nextTransactions()">Next</button></div>
                    </div>
                  </div>
                </div>
              </div>

              <div x-show="creditModalOpen && can('provider_credits.add')" x-cloak @keydown.escape.window="closeCreditModal()">
                  <div class="modal fade show" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="add-provider-credits-title" style="display:block">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content">
                        <form @submit.prevent="addCredits()">
                          <div class="modal-header">
                            <div>
                              <h5 class="modal-title" id="add-provider-credits-title">Add provider credits</h5>
                              <p class="text-muted fs-sm mb-0">Credits are added immediately and recorded permanently.</p>
                            </div>
                            <button type="button" class="btn-close" aria-label="Close" @click="closeCreditModal()" :disabled="addingCredits"></button>
                          </div>
                          <div class="modal-body">
                            <div class="alert alert-light border">
                              <div class="d-flex justify-content-between"><span>Current balance</span><strong x-text="credits(provider.walletBalancePaise)"></strong></div>
                              <div class="d-flex justify-content-between mt-2"><span>New balance</span><strong class="text-primary" x-text="credits(creditPreviewPaise())"></strong></div>
                            </div>
                            <div class="mb-3">
                              <label class="form-label" for="provider-credit-amount">Credits to add</label>
                              <input id="provider-credit-amount" class="form-control" type="number" min="0.01" max="100000" step="0.01" x-model="creditForm.amountCredits" required>
                            </div>
                            <div class="mb-3">
                              <label class="form-label" for="provider-credit-reason">Reason</label>
                              <select id="provider-credit-reason" class="form-select" x-model="creditForm.reason" required>
                                <option value="">Select a reason</option>
                                <option value="invalid_lead_refund">Invalid lead refund</option>
                                <option value="technical_issue">Technical issue</option>
                                <option value="payment_correction">Payment correction</option>
                                <option value="goodwill_gesture">Goodwill gesture</option>
                                <option value="promotional_credits">Promotional credits</option>
                                <option value="retention_support">Retention support</option>
                                <option value="other">Other</option>
                              </select>
                            </div>
                            <div class="mb-3">
                              <label class="form-label" for="provider-credit-note">Internal note</label>
                              <textarea id="provider-credit-note" class="form-control" rows="3" minlength="5" maxlength="2000" x-model="creditForm.note" placeholder="Explain why these credits are being added" required></textarea>
                              <div class="form-text">Visible only to authorised CRM employees.</div>
                            </div>
                            <div>
                              <label class="form-label" for="provider-credit-reference">Reference <span class="text-muted">(optional)</span></label>
                              <input id="provider-credit-reference" class="form-control" type="text" maxlength="160" x-model="creditForm.reference" placeholder="Lead ID, payment ID or support ticket">
                            </div>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-light" @click="closeCreditModal()" :disabled="addingCredits">Cancel</button>
                            <button type="submit" class="btn btn-primary" :disabled="addingCredits" x-text="addingCredits ? 'Adding credits…' : 'Confirm and add credits'"></button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                  <div class="modal-backdrop fade show" @click="closeCreditModal()"></div>
                </div>
            </div>
            <script>
              function providerShow() {
                return {
                  recordId: pathRecordId(),
                  provider: {},
                  offers: [],
                  transactions: [],
                  offerPagination: createCursorPagination(10),
                  transactionPagination: createCursorPagination(10),
                  offerLoading: false,
                  transactionLoading: false,
                  syncing: false,
                  creditModalOpen: false,
                  addingCredits: false,
                  creditForm: { amountCredits: '', reason: '', note: '', reference: '', requestId: '' },
                  error: '',
                  success: '',
                  async load() {
                    try {
                      this.provider = (await apiFetch('/api/provider/' + this.recordId)).data;
                      await Promise.all([this.loadOffers(), this.loadTransactions()]);
                    } catch (error) {
                      this.error = error.message;
                    }
                  },
                  async loadOffers() {
                    this.offerLoading = true;
                    try {
                      const query = new URLSearchParams({ limit: this.offerPagination.limit, cursor: this.offerPagination.cursor });
                      if (!this.offerPagination.cursor) query.delete('cursor');
                      const body = await apiFetch('/api/provider/' + this.recordId + '/distributions?' + query.toString());
                      this.offers = body.data || [];
                      applyCursorPagination(this.offerPagination, body.pagination || {});
                    } catch (error) {
                      this.error = error.message;
                    } finally {
                      this.offerLoading = false;
                    }
                  },
                  async loadTransactions() {
                    this.transactionLoading = true;
                    try {
                      const query = new URLSearchParams({ limit: this.transactionPagination.limit, cursor: this.transactionPagination.cursor });
                      if (!this.transactionPagination.cursor) query.delete('cursor');
                      const body = await apiFetch('/api/provider/' + this.recordId + '/transactions?' + query.toString());
                      this.transactions = body.data || [];
                      applyCursorPagination(this.transactionPagination, body.pagination || {});
                    } catch (error) {
                      this.error = error.message;
                    } finally {
                      this.transactionLoading = false;
                    }
                  },
                  resetOffers() { resetCursorPagination(this.offerPagination); this.loadOffers(); },
                  resetTransactions() { resetCursorPagination(this.transactionPagination); this.loadTransactions(); },
                  nextOffers() { if (cursorNext(this.offerPagination)) this.loadOffers(); },
                  previousOffers() { if (cursorPrevious(this.offerPagination)) this.loadOffers(); },
                  nextTransactions() { if (cursorNext(this.transactionPagination)) this.loadTransactions(); },
                  previousTransactions() { if (cursorPrevious(this.transactionPagination)) this.loadTransactions(); },
                  newCreditRequestId() {
                    if (window.crypto && typeof window.crypto.randomUUID === 'function') return window.crypto.randomUUID();
                    return 'credit-' + Date.now() + '-' + Math.random().toString(36).slice(2, 12);
                  },
                  openCreditModal() {
                    this.creditForm = { amountCredits: '', reason: '', note: '', reference: '', requestId: this.newCreditRequestId() };
                    this.creditModalOpen = true;
                  },
                  closeCreditModal() {
                    if (!this.addingCredits) this.creditModalOpen = false;
                  },
                  creditPreviewPaise() {
                    const current = Number(this.provider.walletBalancePaise || 0);
                    const amount = Math.max(0, Number(this.creditForm.amountCredits || 0));
                    return current + Math.round(amount * 100);
                  },
                  transactionAmount(transaction) {
                    const value = credits(transaction.amountPaise);
                    return transaction.type === 'credit' ? '+' + value : '-' + value;
                  },
                  async addCredits() {
                    if (this.addingCredits) return;
                    this.error = '';
                    this.success = '';
                    const amount = Number(this.creditForm.amountCredits || 0);
                    if (!Number.isFinite(amount) || amount <= 0) {
                      this.error = 'Enter a valid credit amount';
                      return;
                    }
                    if (!this.creditForm.reason) {
                      this.error = 'Select a credit reason';
                      return;
                    }
                    if (String(this.creditForm.note || '').trim().length < 5) {
                      this.error = 'Internal note must contain at least 5 characters';
                      return;
                    }
                    const confirmed = window.confirm('Add ' + amount.toLocaleString('en-IN', { maximumFractionDigits: 2 }) + ' credits to ' + (this.provider.name || 'this provider') + '?');
                    if (!confirmed) return;
                    this.addingCredits = true;
                    try {
                      const response = await apiFetch('/api/provider/' + this.recordId + '/credits', {
                        method: 'POST',
                        body: JSON.stringify(this.creditForm)
                      });
                      this.provider.walletBalancePaise = response.data.walletBalancePaise;
                      resetCursorPagination(this.transactionPagination);
                      await this.loadTransactions();
                      this.success = response.message || 'Credits added successfully';
                      showCrmToast(this.success, 'success');
                      this.creditModalOpen = false;
                    } catch (error) {
                      this.error = error.message;
                      showCrmToast(error.message, 'error');
                    } finally {
                      this.addingCredits = false;
                    }
                  },
                  async sync() {
                    if (this.syncing) return;
                    this.syncing = true;
                    this.error = '';
                    this.success = '';
                    try {
                      await apiFetch('/api/provider/' + this.recordId + '/sync', { method: 'POST', body: '{}' });
                      resetCursorPagination(this.offerPagination);
                      await this.loadOffers();
                      this.success = 'Approved leads synchronized';
                    } catch (error) {
                      this.error = error.message;
                    } finally {
                      this.syncing = false;
                    }
                  }
                };
              }
            </script>
          </div>
          <%- include('../partials/footer') %>
        </div>
      </div>
    </div>
    <%- include('../partials/scripts') %>
  </body>
</html>
