<!doctype html>
<html lang="en" dir="ltr">
  <%- include('../partials/head') %>
  <body x-data="crmShell()" x-init="initShell()">
    <%- include('../partials/navbar') %>
    <div class="page-content"><%- include('../partials/sidebar') %><div class="content-wrapper"><div class="content-inner">
      <div class="page-header page-header-light crm-page-header"><div class="page-header-content crm-page-heading"><div><div class="crm-page-eyebrow">Feature access</div><h1 class="page-title mb-1"><%= title %></h1><p class="crm-page-subtitle mb-0">Permission checks protect both the page and its backend API actions.</p></div><a href="/roles" class="btn btn-light crm-primary-action">Back to roles</a></div></div>
      <main class="content"><div x-show="shellError" x-cloak class="alert alert-danger" x-text="shellError"></div><div x-data="roleForm()" x-init="init()"><div x-show="error" x-cloak class="alert alert-danger" x-text="error"></div>
        <form class="card" @submit.prevent="save()"><div class="card-body" :class="loading && 'crm-loading'"><div class="row g-3">
          <div class="col-md-6"><label class="form-label">Role name</label><input class="form-control" x-model="form.name" maxlength="120" :readonly="form.isSystem" required></div>
          <div class="col-md-3"><label class="form-label">Role key</label><input class="form-control" x-model="form.slug" maxlength="80" :readonly="form.isSystem" placeholder="sales-manager"></div>
          <div class="col-md-3"><label class="form-label">Status</label><select class="form-select" x-model="form.active" :disabled="form.isSuperAdmin"><option :value="true">Active</option><option :value="false">Inactive</option></select></div>
          <div class="col-12"><label class="form-label">Description</label><textarea class="form-control" rows="2" x-model="form.description" maxlength="1000"></textarea></div>
          <div class="col-12"><div class="crm-form-section-title"><span>Feature permissions</span></div><div class="d-flex gap-2 mb-3"><button type="button" class="btn btn-light btn-sm" @click="selectAll()" :disabled="form.isSuperAdmin">Select all</button><button type="button" class="btn btn-light btn-sm" @click="clearAll()" :disabled="form.isSuperAdmin">Clear all</button></div></div>
          <template x-for="group in groups" :key="group.key"><div class="col-lg-6"><div class="crm-permission-group"><div class="crm-permission-group-head"><strong x-text="group.label"></strong><button type="button" class="btn btn-link btn-sm p-0" @click="toggleGroup(group)" :disabled="form.isSuperAdmin">Toggle group</button></div><div class="crm-permission-options"><template x-for="permission in group.permissions" :key="permission.key"><label class="form-check"><input class="form-check-input" type="checkbox" :value="permission.key" x-model="form.permissions" :disabled="form.isSuperAdmin"><span class="form-check-label" x-text="permission.label"></span></label></template></div></div></div></template>
          <template x-if="form.isSuperAdmin"><div class="col-12"><div class="alert alert-info mb-0">The Super Admin role always has complete access and cannot be deactivated.</div></div></template>
        </div></div><div class="card-footer d-flex"><a href="/roles" class="btn btn-light">Cancel</a><button class="btn btn-primary ms-auto" :disabled="saving" x-text="saving ? 'Saving…' : 'Save role'"></button></div></form>
      </div></main><%- include('../partials/footer') %>
    </div></div></div>
    <script>
      function roleForm(){return{mode:pageMode(),recordId:pageMode()==='edit'?pathRecordId(true):'',groups:[],allPermissions:[],form:{name:'',slug:'',description:'',permissions:[],active:true,isSystem:false,isSuperAdmin:false},loading:true,saving:false,error:'',async init(){try{const meta=(await apiFetch('/api/roles/metadata')).data;this.groups=meta.groups||[];this.allPermissions=meta.allPermissions||[];if(this.mode==='edit'){this.form={...this.form,...(await apiFetch('/api/roles/'+this.recordId)).data};if(this.form.permissions.includes('*'))this.form.permissions=[...this.allPermissions];}}catch(error){this.error=error.message;}finally{this.loading=false;}},toggleGroup(group){const keys=group.permissions.map(item=>item.key);const selected=keys.every(key=>this.form.permissions.includes(key));this.form.permissions=selected?this.form.permissions.filter(key=>!keys.includes(key)):[...new Set([...this.form.permissions,...keys])];},selectAll(){this.form.permissions=[...this.allPermissions];},clearAll(){this.form.permissions=[];},async save(){if(this.saving)return;this.error='';this.saving=true;try{if(!this.form.name.trim())throw new Error('Role name is required');if(!this.form.isSuperAdmin&&!this.form.permissions.length)throw new Error('Select at least one permission');const payload={...this.form,permissions:this.form.isSuperAdmin?undefined:this.form.permissions};const url=this.mode==='edit'?'/api/roles/'+this.recordId:'/api/roles';const body=await apiFetch(url,{method:this.mode==='edit'?'PUT':'POST',body:JSON.stringify(payload)});location.href='/roles/'+body.data.roleId+'/edit';}catch(error){this.error=error.message;}finally{this.saving=false;}}};}
    </script>
    <%- include('../partials/scripts') %>
  </body>
</html>
