#!/usr/bin/env node

const http = require("http");
const mongoose = require("mongoose");
const { validateEnvironment } = require("../config/env");
const connectDatabase = require("../db/connection");
const app = require("../app");

const port = Number(process.env.PORT || 3100);
let server;
let shuttingDown = false;

async function shutdown(signal) {
  if (shuttingDown) return;
  shuttingDown = true;
  console.log(`${signal} received. Shutting down provider portal...`);

  const forceTimer = setTimeout(() => {
    console.error("Forced shutdown after timeout");
    process.exit(1);
  }, 10000);
  forceTimer.unref();

  if (server) {
    await new Promise((resolve) => server.close(resolve));
  }
  await mongoose.disconnect().catch(() => {});
  clearTimeout(forceTimer);
  process.exit(0);
}

async function start() {
  validateEnvironment();
  await connectDatabase();

  app.set("port", port);
  server = http.createServer(app);
  server.requestTimeout = Number(process.env.REQUEST_TIMEOUT_MS || 30000);
  server.headersTimeout = Number(process.env.HEADERS_TIMEOUT_MS || 35000);
  server.keepAliveTimeout = Number(process.env.KEEP_ALIVE_TIMEOUT_MS || 5000);

  server.listen(port, () => {
    console.log(`Provider portal listening on port ${port}`);
  });

  server.on("error", (error) => {
    console.error(error);
    process.exit(1);
  });
}

process.on("SIGTERM", () => shutdown("SIGTERM"));
process.on("SIGINT", () => shutdown("SIGINT"));
process.on("unhandledRejection", (error) => {
  console.error("Unhandled rejection", error);
});
process.on("uncaughtException", (error) => {
  console.error("Uncaught exception", error);
  shutdown("uncaughtException");
});

start().catch((error) => {
  console.error("Provider portal failed to start:", error.message);
  process.exit(1);
});
