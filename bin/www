#!/usr/bin/env node
"use strict";

require("dotenv").config();

const http = require("node:http");
const { loadAwsSecrets } = require("../config/load-aws-secrets");
const { createCloudWatchLogger } = require("../services/logging/cloudwatch-logger");

const cloudwatchLogger = createCloudWatchLogger({
  service: "provider",
  credentialPrefix: "PROVIDER_SECRETS_",
  defaultLogGroup: "/findoly/provider/production",
});
cloudwatchLogger.install();

let server = null;
let mongoose = null;
let shuttingDown = false;
let runPromise = null;
let signalHandlersInstalled = false;
let crmSyncWorker = null;

function resolvePort(env = process.env) {
  const port = Number(env.PORT || 3100);
  if (!Number.isInteger(port) || port < 1 || port > 65535) {
    throw new Error("PORT must be a whole number between 1 and 65535");
  }
  return port;
}

function shutdownTimeoutMs(env = process.env) {
  const configured = Number(env.SHUTDOWN_TIMEOUT_MS || 10000);
  if (!Number.isFinite(configured)) return 10000;
  return Math.min(Math.max(Math.trunc(configured), 1000), 120000);
}

function startupRequestHandler(req, res) {
  res.statusCode = 503;
  res.setHeader("content-type", "application/json; charset=utf-8");
  res.setHeader("cache-control", "no-store");
  res.setHeader("retry-after", "5");

  if (req.method === "HEAD") {
    res.end();
    return;
  }

  res.end(
    JSON.stringify({
      success: false,
      error: {
        code: "SERVICE_STARTING",
        message: "Provider portal is starting. Please retry shortly.",
      },
    }),
  );
}

function configureServerTimeouts(target, env = process.env) {
  target.requestTimeout = Number(env.REQUEST_TIMEOUT_MS || 30000);
  target.headersTimeout = Number(env.HEADERS_TIMEOUT_MS || 35000);
  target.keepAliveTimeout = Number(env.KEEP_ALIVE_TIMEOUT_MS || 5000);
}

function listenOnPort(target, port) {
  return new Promise((resolve, reject) => {
    const onError = (error) => {
      target.off("error", onError);
      reject(error);
    };

    target.once("error", onError);
    target.listen(port, () => {
      target.off("error", onError);
      resolve();
    });
  });
}

async function closeHttpServer(target) {
  if (!target || !target.listening || typeof target.close !== "function") return;

  await new Promise((resolve) => {
    target.close((error) => {
      if (error) {
        console.error("HTTP server close error:", error.message);
      }
      resolve();
    });
  });
}

async function shutdown(signal) {
  if (shuttingDown) return;
  shuttingDown = true;
  console.log(`${signal} received. Shutting down provider portal...`);

  const forceTimer = setTimeout(() => {
    console.error("Forced shutdown after timeout");
    process.exit(1);
  }, shutdownTimeoutMs());
  forceTimer.unref();

  await closeHttpServer(server);

  if (crmSyncWorker?.stopCrmSyncWorker) await crmSyncWorker.stopCrmSyncWorker();

  if (mongoose && mongoose.connection.readyState !== 0) {
    await mongoose
      .disconnect()
      .catch((error) =>
        console.error("MongoDB disconnect error:", error.message),
      );
  }

  clearTimeout(forceTimer);
  await cloudwatchLogger.shutdown({ timeoutMs: 2000 });
  process.exit(0);
}

function installSignalHandlers() {
  if (signalHandlersInstalled) return;
  signalHandlersInstalled = true;

  process.once("SIGTERM", () => shutdown("SIGTERM"));
  process.once("SIGINT", () => shutdown("SIGINT"));
  process.on("unhandledRejection", (error) => {
    console.error("Unhandled rejection", error);
  });
  process.on("uncaughtException", (error) => {
    console.error("Uncaught exception", error);
    shutdown("uncaughtException");
  });
}

async function start({
  loadSecrets = loadAwsSecrets,
  loadEnvironment = () => require("../config/env"),
  loadDatabase = () => require("../db/connection"),
  loadApp = () => require("../app"),
  loadMongoose = () => require("mongoose"),
  loadCrmSyncWorker = () => require("../services/integration/crm-sync-worker"),
  httpModule = http,
} = {}) {
  const port = resolvePort();
  let activeRequestHandler = startupRequestHandler;

  server = httpModule.createServer((req, res) =>
    activeRequestHandler(req, res),
  );
  configureServerTimeouts(server);

  try {
    // Hostinger requires listen() to be called almost immediately after the
    // entry file loads. Keep the temporary 503 handler active until runtime
    // secrets, validation and MongoDB are ready.
    await listenOnPort(server, port);
    server.on("error", (error) => {
      console.error("HTTP server error:", error);
      process.exitCode = 1;
    });
    console.log(`Provider portal bootstrap listener active on port ${port}`);

    const secretResult = await loadSecrets();
    cloudwatchLogger.configureFromEnv();
    if (!secretResult.skipped) {
      console.log(
        `Provider configuration loaded from AWS Secrets Manager (${secretResult.loaded} values)`,
      );
    }

    // Apply timeout overrides that may have arrived from Secrets Manager.
    configureServerTimeouts(server);

    const { validateEnvironment } = loadEnvironment();
    validateEnvironment();

    const connectDatabase = loadDatabase();
    const app = loadApp();
    mongoose = loadMongoose();

    app.set("port", port);
    await connectDatabase();
    crmSyncWorker = loadCrmSyncWorker();
    crmSyncWorker.startCrmSyncWorker();

    activeRequestHandler = app;

    console.log(`Provider portal listening on port ${port}`);
    return server;
  } catch (error) {
    await closeHttpServer(server);
    throw error;
  }
}

function run() {
  if (runPromise) return runPromise;

  installSignalHandlers();
  runPromise = start().catch(async (error) => {
    console.error("Provider portal failed to start:", error.message);
    process.exitCode = 1;
    await cloudwatchLogger.flush({ timeoutMs: 2000 });
    throw error;
  });
  return runPromise;
}

module.exports = {
  cloudwatchLogger,
  closeHttpServer,
  configureServerTimeouts,
  installSignalHandlers,
  listenOnPort,
  resolvePort,
  run,
  shutdown,
  shutdownTimeoutMs,
  start,
  startupRequestHandler,
};
